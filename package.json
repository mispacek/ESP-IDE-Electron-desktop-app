{
  "name": "esp_ide",
  "productName": "ESP IDE",
  "version": "2.1.0",
  "main": "electron/main/main.js",
  "scripts": {
      "start": "npm run verify:runtime && electron .",
      "test:electron": "node --test tests/electron-runtime.test.cjs",
      "test:packaged": "node tests/electron-packaged-smoke.cjs",
      "verify:runtime": "node scripts/verify-runtime.mjs",
      "verify:package": "node scripts/verify-package.mjs",
      "dist": "npm run verify:runtime && electron-builder",
      "dist:win": "npm run verify:runtime && electron-builder --win --x64 --ia32",
      "dist:linux": "npm run verify:runtime && electron-builder --linux --publish never",
      "dist:mac": "npm run verify:runtime && electron-builder --mac --universal"
  },
  "devDependencies": {
    "electron": "^30.5.1",
    "electron-builder": "^25.1.8",
    "electron-packager": "^17.1.2"
  },
  "build": {
    "appId": "eu.espide.desktop",
    "asar": true,
    "compression": "maximum",
    "files": [
      "electron/**/*",
      "!electron/migration/**",
      {
        "from": "electron/migration",
        "to": ".",
        "filter": ["index.html"]
      }
    ],
    "extraResources": [
      {
        "from": "esp_ide_v2",
        "to": "esp_ide_v2",
        "filter": [
          "css/**/*",
          "examples/**/*",
          "i18n/**/*",
          "js/**/*",
          "!**/*.test.cjs",
          "media/**/*",
          "*.html",
          "*.txt",
          "*.webmanifest",
          "favicon.ico",
          "sw.js",
          "toolbox*.xml"
        ]
      },
      {
        "from": "simulator_lite",
        "to": "simulator_lite",
        "filter": [
          "assets/**/*",
          "config/**/*",
          "core/**/*",
          "filesystem/**/*",
          "runtime/**/*",
          "vendor/**/*",
          "app.js",
          "embed.js",
          "frame-bridge.js",
          "http-proxy.php",
          "ide-bridge.js",
          "index.html",
          "simulator.css",
          "toolbox_Simulator.xml",
          "worker.js"
        ]
      }
    ],
    "artifactName": "ESP_IDE_${version}_${os}_${arch}.${ext}",
    "win": {
      "target": "nsis",
      "icon": "packaging/windows/icon.ico"
    },
    "mac": {
      "hardenedRuntime": true,
      "icon": "packaging/macos/icon.png",
      "entitlements": "packaging/macos/entitlements.plist",
      "entitlementsInherit": "packaging/macos/entitlements.plist",
      "extendInfo": {
        "NSBluetoothAlwaysUsageDescription": "ESP IDE needs Bluetooth to connect to supported boards."
      },
      "target": [
        "dmg",
        "zip"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "createDesktopShortcut": true,
      "shortcutName": "ESP IDE"
    },
    "linux": {
       "executableName": "esp-ide",
       "category": "Development",
       "icon": "packaging/linux/icon.png",
       "maintainer": "Milan Špaček <[espide@email.cz]>",
       "target": [
         { "target": "AppImage", "arch": ["x64"] },
         { "target": "deb",      "arch": ["x64"] }
       ],
       "executableArgs": ["--no-sandbox", "--disable-serial-blocklist"],
       "desktop": {
        "Categories": "Development;Electronics;"
       }
     },
     "deb": {
        "afterInstall": "packaging/linux/postinstall.sh"
     }
  },
  "keywords": [],
  "author": "Milan Špaček <[espide@email.cz]>",
  "license": "ISC",
  "description": "ESP IDE development environment for Windows, Linux and macOS"
}
