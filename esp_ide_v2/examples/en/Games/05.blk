<xml xmlns="https://developers.google.com/blockly/xml"><variables><variable id="v_joy_x">joy_x</variable><variable id="v_player_speed">player_speed</variable><variable id="v_player_x">player_x</variable><variable id="v_bullet_y">bullet_y</variable><variable id="v_fire">fire_pressed</variable><variable id="v_bullet_active">bullet_active</variable><variable id="v_bullet_x">bullet_x</variable><variable id="v_fleet_counter">fleet_counter</variable><variable id="v_enemy_shot_counter">enemy_shot_counter</variable><variable id="v_enemy_bullet_x">enemy_bullet_x</variable><variable id="v_fleet_x">fleet_x</variable><variable id="v_enemy_bullet_y">enemy_bullet_y</variable><variable id="v_enemy_bullet_active">enemy_bullet_active</variable><variable id="v_fleet_dx">fleet_dx</variable><variable id="v_fleet_y">fleet_y</variable><variable id="v_row">row</variable><variable id="v_col">col</variable><variable id="v_lives">lives</variable><variable id="v_idx">idx</variable><variable id="v_invaders">invaders</variable><variable id="v_invader_x">invader_x</variable><variable id="v_alive_count">alive_count</variable><variable id="v_invader_y">invader_y</variable><variable id="v_score">score</variable></variables><block type="program_start" id="space_invaders_start" x="40" y="40"><comment pinned="false" h="110" w="520">PROGRAM START runs once at startup. It prepares the display, joystick, and all variables needed for Space Invaders.</comment><next><block type="oled_init" id="inv_oled_init"><mutation xmlns="http://www.w3.org/1999/xhtml" display_type="AUTO"></mutation><field name="DISPLAY_TYPE">AUTO</field><comment pinned="false" h="110" w="520">Initialize the 128×64 OLED. The game draws every object into the framebuffer, then sends the completed frame to the display.</comment><value name="SDA_PIN"><shadow type="math_number" id="n0001"><field name="NUM">21</field></shadow></value><value name="SCL_PIN"><shadow type="math_number" id="n0002"><field name="NUM">22</field></shadow></value><next><block type="joystick_init" id="inv_joystick_init"><field name="joy_name">1</field><field name="rot">270</field><comment pinned="false" h="110" w="520">Initialize joystick 1. The X axis controls the ship&apos;s relative movement, and pressing the joystick fires. Change the pins to match your board.</comment><value name="vrx"><shadow type="math_number" id="n0003"><field name="NUM">13</field></shadow></value><value name="vry"><shadow type="math_number" id="n0004"><field name="NUM">14</field></shadow></value><value name="sw"><shadow type="math_number" id="n0005"><field name="NUM">15</field></shadow></value><next><block type="variables_set" id="b0007"><field name="VAR" id="v_joy_x">joy_x</field><comment pinned="false" h="110" w="520">Current joystick deflection on the X axis. The approximate range is −100 to +100.</comment><value name="VALUE"><shadow type="math_number" id="n0006"><field name="NUM">0</field></shadow></value><next><block type="variables_set" id="b0009"><field name="VAR" id="v_player_x">player_x</field><comment pinned="false" h="110" w="520">X coordinate of the player&apos;s ship. The sprite is 11 px wide, so X=58 places it near the center of the display.</comment><value name="VALUE"><shadow type="math_number" id="n0008"><field name="NUM">58</field></shadow></value><next><block type="variables_set" id="b0011"><field name="VAR" id="v_player_speed">player_speed</field><comment pinned="false" h="110" w="520">Ship speed in pixels per main-loop iteration.</comment><value name="VALUE"><shadow type="math_number" id="n0010"><field name="NUM">0</field></shadow></value><next><block type="variables_set" id="b0013"><field name="VAR" id="v_fire">fire_pressed</field><comment pinned="false" h="110" w="520">Joystick button state. Zero means FIRE is not pressed.</comment><value name="VALUE"><shadow type="math_number" id="n0012"><field name="NUM">0</field></shadow></value><next><block type="variables_set" id="b0015"><field name="VAR" id="v_bullet_x">bullet_x</field><comment pinned="false" h="110" w="520">X coordinate of the player&apos;s bullet.</comment><value name="VALUE"><shadow type="math_number" id="n0014"><field name="NUM">0</field></shadow></value><next><block type="variables_set" id="b0017"><field name="VAR" id="v_bullet_y">bullet_y</field><comment pinned="false" h="110" w="520">Y coordinate of the player&apos;s bullet.</comment><value name="VALUE"><shadow type="math_number" id="n0016"><field name="NUM">0</field></shadow></value><next><block type="variables_set" id="b0019"><field name="VAR" id="v_bullet_active">bullet_active</field><comment pinned="false" h="110" w="520">Player-bullet active flag. Allowing only one bullet at a time keeps this learning example simple.</comment><value name="VALUE"><shadow type="math_number" id="n0018"><field name="NUM">0</field></shadow></value><next><block type="variables_set" id="b0021"><field name="VAR" id="v_enemy_bullet_x">enemy_bullet_x</field><comment pinned="false" h="110" w="520">X coordinate of the enemy bullet.</comment><value name="VALUE"><shadow type="math_number" id="n0020"><field name="NUM">0</field></shadow></value><next><block type="variables_set" id="b0023"><field name="VAR" id="v_enemy_bullet_y">enemy_bullet_y</field><comment pinned="false" h="110" w="520">Y coordinate of the enemy bullet.</comment><value name="VALUE"><shadow type="math_number" id="n0022"><field name="NUM">0</field></shadow></value><next><block type="variables_set" id="b0025"><field name="VAR" id="v_enemy_bullet_active">enemy_bullet_active</field><comment pinned="false" h="110" w="520">Enemy-bullet active flag. The invaders also use at most one bullet at a time.</comment><value name="VALUE"><shadow type="math_number" id="n0024"><field name="NUM">0</field></shadow></value><next><block type="variables_set" id="b0027"><field name="VAR" id="v_enemy_shot_counter">enemy_shot_counter</field><comment pinned="false" h="110" w="520">A simple counter determines when the invaders fire. This separates the game&apos;s frame rate from the timing of a specific event.</comment><value name="VALUE"><shadow type="math_number" id="n0026"><field name="NUM">0</field></shadow></value><next><block type="variables_set" id="b0029"><field name="VAR" id="v_fleet_x">fleet_x</field><comment pinned="false" h="110" w="520">Horizontal offset shared by the entire invader formation. One variable moves all 18 invaders.</comment><value name="VALUE"><shadow type="math_number" id="n0028"><field name="NUM">12</field></shadow></value><next><block type="variables_set" id="b0031"><field name="VAR" id="v_fleet_y">fleet_y</field><comment pinned="false" h="110" w="520">Vertical offset shared by the entire invader formation.</comment><value name="VALUE"><shadow type="math_number" id="n0030"><field name="NUM">6</field></shadow></value><next><block type="variables_set" id="b0033"><field name="VAR" id="v_fleet_dx">fleet_dx</field><comment pinned="false" h="110" w="520">Horizontal movement direction of the formation. +1 means right; −1 means left.</comment><value name="VALUE"><shadow type="math_number" id="n0032"><field name="NUM">1</field></shadow></value><next><block type="variables_set" id="b0035"><field name="VAR" id="v_fleet_counter">fleet_counter</field><comment pinned="false" h="110" w="520">A counter slows the formation, so the invaders do not move on every main-loop iteration.</comment><value name="VALUE"><shadow type="math_number" id="n0034"><field name="NUM">0</field></shadow></value><next><block type="variables_set" id="b0039"><field name="VAR" id="v_invaders">invaders</field><comment pinned="false" h="110" w="520">The invaders list stores the state of all invaders, avoiding 18 separate variables.</comment><value name="VALUE"><block type="lists_repeat" id="b0038"><comment pinned="false" h="110" w="520">Create a list of 18 ones: 3 rows × 6 columns. Value 1 means alive; 0 means destroyed.</comment><value name="ITEM"><shadow type="math_number" id="n0036"><field name="NUM">1</field></shadow></value><value name="NUM"><shadow type="math_number" id="n0037"><field name="NUM">18</field></shadow></value></block></value><next><block type="variables_set" id="b0041"><field name="VAR" id="v_alive_count">alive_count</field><comment pinned="false" h="110" w="520">Number of invaders still alive. It decreases by 1 after each hit.</comment><value name="VALUE"><shadow type="math_number" id="n0040"><field name="NUM">18</field></shadow></value><next><block type="variables_set" id="b0043"><field name="VAR" id="v_score">score</field><comment pinned="false" h="110" w="520">Player score. Destroying an invader adds one point.</comment><value name="VALUE"><shadow type="math_number" id="n0042"><field name="NUM">0</field></shadow></value><next><block type="variables_set" id="b0045"><field name="VAR" id="v_lives">lives</field><comment pinned="false" h="110" w="520">The player starts with three lives. An enemy-bullet hit removes one life.</comment><value name="VALUE"><shadow type="math_number" id="n0044"><field name="NUM">3</field></shadow></value></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block><block type="program_loop" id="space_invaders_loop" x="720" y="40"><comment pinned="false" h="110" w="520">PROGRAM LOOP is the main game loop: input → object updates → collisions → game rules → rendering. This is the basic architecture of most real-time games.</comment><statement name="DO"><block type="variables_set" id="b0046"><field name="VAR" id="v_joy_x">joy_x</field><comment pinned="false" h="110" w="520">At the start of each frame, store the joystick deflection in joy_x.</comment><value name="VALUE"><block type="get_joy_axis_ble" id="inv_get_joy_x"><field name="joy_name">1</field><field name="axis">X</field><comment pinned="false" h="110" w="520">Reads joystick X-axis. The value does not directly determine the position of the ship, but its speed and direction.</comment></block></value><next><block type="variables_set" id="b0060"><field name="VAR" id="v_player_speed">player_speed</field><comment pinned="false" h="110" w="520">Outside the dead zone, the speed is calculated from the size of the joystick deflection.</comment><value name="VALUE"><block type="math_round" id="b0059"><field name="OP">ROUND</field><comment pinned="false" h="110" w="520">Rounding converts speed to full pixels.</comment><value name="NUM"><block type="math_arithmetic" id="b0058"><field name="OP">DIVIDE</field><comment pinned="false" h="110" w="520">Divide the deflection by 25 to convert the range −100 to +100 into approximately −4 to +4 pixels per frame.</comment><value name="A"><block type="variables_get" id="b0056"><field name="VAR" id="v_joy_x">joy_x</field></block></value><value name="B"><shadow type="math_number" id="n0057"><field name="NUM">25</field></shadow></value></block></value></block></value><next><block type="variables_set" id="b0068"><field name="VAR" id="v_player_x">player_x</field><comment pinned="false" h="110" w="520">Update the player&apos;s horizontal position.</comment><value name="VALUE"><block type="math_constrain" id="b0067"><comment pinned="false" h="110" w="520">Clamp the position to 0–117 so the 11 px ship stays inside the 128 px display.</comment><value name="VALUE"><block type="math_arithmetic" id="b0064"><field name="OP">ADD</field><comment pinned="false" h="110" w="520">New position = old position + speed.</comment><value name="A"><block type="variables_get" id="b0062"><field name="VAR" id="v_player_x">player_x</field></block></value><value name="B"><block type="variables_get" id="b0063"><field name="VAR" id="v_player_speed">player_speed</field></block></value></block></value><value name="LOW"><shadow type="math_number" id="n0065"><field name="NUM">0</field></shadow></value><value name="HIGH"><shadow type="math_number" id="n0066"><field name="NUM">117</field></shadow></value></block></value><next><block type="controls_if" id="b0082"><comment pinned="false" h="110" w="520">Update the player&apos;s bullet.</comment><value name="IF0"><block type="logic_compare" id="b0081"><field name="OP">EQ</field><comment pinned="false" h="110" w="520">Move the bullet only while it is active.</comment><value name="A"><block type="variables_get" id="b0079"><field name="VAR" id="v_bullet_active">bullet_active</field></block></value><value name="B"><shadow type="math_number" id="n0080"><field name="NUM">1</field></shadow></value></block></value><statement name="DO0"><block type="variables_set" id="b0072"><field name="VAR" id="v_bullet_y">bullet_y</field><comment pinned="false" h="110" w="520">Move the active player&#39;s shot up 3 pixels.</comment><value name="VALUE"><block type="math_arithmetic" id="b0071"><field name="OP">MINUS</field><comment pinned="false" h="110" w="520">The player&#39;s shot flies upward: its Y shrinks each frame by 3 px.</comment><value name="A"><block type="variables_get" id="b0069"><field name="VAR" id="v_bullet_y">bullet_y</field></block></value><value name="B"><shadow type="math_number" id="n0070"><field name="NUM">3</field></shadow></value></block></value><next><block type="controls_if" id="b0078"><comment pinned="false" h="110" w="520">Deactivate the player&apos;s bullet after it leaves the screen.</comment><value name="IF0"><block type="logic_compare" id="b0075"><field name="OP">LT</field><comment pinned="false" h="110" w="520">Once the bullet leaves the top edge, we no longer need it.</comment><value name="A"><block type="variables_get" id="b0073"><field name="VAR" id="v_bullet_y">bullet_y</field></block></value><value name="B"><shadow type="math_number" id="n0074"><field name="NUM">-2</field></shadow></value></block></value><statement name="DO0"><block type="variables_set" id="b0077"><field name="VAR" id="v_bullet_active">bullet_active</field><comment pinned="false" h="110" w="520">Deactivate the bullet so the player can fire another one.</comment><value name="VALUE"><shadow type="math_number" id="n0076"><field name="NUM">0</field></shadow></value></block></statement></block></next></block></statement><next><block type="variables_set" id="b0083"><field name="VAR" id="v_fire">fire_pressed</field><comment pinned="false" h="110" w="520">Reading the joystick button.</comment><value name="VALUE"><block type="get_joy_state_ble" id="inv_fire_button"><field name="joy_name">1</field><field name="axis">5</field><comment pinned="false" h="110" w="520">Read the joystick button state. Pressing it fires.</comment></block></value><next><block type="controls_if" id="b0099"><comment pinned="false" h="110" w="520">Create a bullet when FIRE is pressed. Keeping only one active bullet is simple and resembles the original Space Invaders.</comment><value name="IF0"><block type="logic_operation" id="b0090"><field name="OP">AND</field><comment pinned="false" h="110" w="520">Both conditions must be met at the same time: no shot + FIRE press.</comment><value name="A"><block type="logic_compare" id="b0086"><field name="OP">EQ</field><comment pinned="false" h="110" w="520">We will only create a new shot if none of the previous ones is active.</comment><value name="A"><block type="variables_get" id="b0084"><field name="VAR" id="v_bullet_active">bullet_active</field></block></value><value name="B"><shadow type="math_number" id="n0085"><field name="NUM">0</field></shadow></value></block></value><value name="B"><block type="logic_compare" id="b0089"><field name="OP">EQ</field><comment pinned="false" h="110" w="520">The second condition requires the button to be pressed.</comment><value name="A"><block type="variables_get" id="b0087"><field name="VAR" id="v_fire">fire_pressed</field></block></value><value name="B"><shadow type="math_number" id="n0088"><field name="NUM">1</field></shadow></value></block></value></block></value><statement name="DO0"><block type="variables_set" id="b0092"><field name="VAR" id="v_bullet_active">bullet_active</field><comment pinned="false" h="110" w="520">Activation of a new player&#39;s shot.</comment><value name="VALUE"><shadow type="math_number" id="n0091"><field name="NUM">1</field></shadow></value><next><block type="variables_set" id="b0096"><field name="VAR" id="v_bullet_x">bullet_x</field><comment pinned="false" h="110" w="520">Place the bullet&apos;s X coordinate at the center of the player&apos;s ship.</comment><value name="VALUE"><block type="math_arithmetic" id="b0095"><field name="OP">ADD</field><comment pinned="false" h="110" w="520">The ship is 11px wide; +5 places the bullet approximately in its center.</comment><value name="A"><block type="variables_get" id="b0093"><field name="VAR" id="v_player_x">player_x</field></block></value><value name="B"><shadow type="math_number" id="n0094"><field name="NUM">5</field></shadow></value></block></value><next><block type="variables_set" id="b0098"><field name="VAR" id="v_bullet_y">bullet_y</field><comment pinned="false" h="110" w="520">The bullet starts just above the ship, which is drawn from Y=57.</comment><value name="VALUE"><shadow type="math_number" id="n0097"><field name="NUM">54</field></shadow></value></block></next></block></next></block></statement><next><block type="variables_set" id="b0103"><field name="VAR" id="v_fleet_counter">fleet_counter</field><comment pinned="false" h="110" w="520">Slow the invaders independently of the display refresh rate.</comment><value name="VALUE"><block type="math_arithmetic" id="b0102"><field name="OP">ADD</field><comment pinned="false" h="110" w="520">The counter increases by 1 for each frame.</comment><value name="A"><block type="variables_get" id="b0100"><field name="VAR" id="v_fleet_counter">fleet_counter</field></block></value><value name="B"><shadow type="math_number" id="n0101"><field name="NUM">1</field></shadow></value></block></value><next><block type="controls_if" id="b0129"><comment pinned="false" h="110" w="520">The invaders intentionally move more slowly than the ship and bullets.</comment><value name="IF0"><block type="logic_compare" id="b0128"><field name="OP">GT</field><comment pinned="false" h="110" w="520">Motion occurs every other pass through the loop.</comment><value name="A"><block type="variables_get" id="b0126"><field name="VAR" id="v_fleet_counter">fleet_counter</field></block></value><value name="B"><shadow type="math_number" id="n0127"><field name="NUM">1</field></shadow></value></block></value><statement name="DO0"><block type="variables_set" id="b0105"><field name="VAR" id="v_fleet_counter">fleet_counter</field><comment pinned="false" h="110" w="520">After the movement, the counter starts again from zero.</comment><value name="VALUE"><shadow type="math_number" id="n0104"><field name="NUM">0</field></shadow></value><next><block type="variables_set" id="b0109"><field name="VAR" id="v_fleet_x">fleet_x</field><comment pinned="false" h="110" w="520">Moving the entire formation with a single fleet_x change.</comment><value name="VALUE"><block type="math_arithmetic" id="b0108"><field name="OP">ADD</field><comment pinned="false" h="110" w="520">The entire formation moves +1 or -1 pixel according to fleet_dx.</comment><value name="A"><block type="variables_get" id="b0106"><field name="VAR" id="v_fleet_x">fleet_x</field></block></value><value name="B"><block type="variables_get" id="b0107"><field name="VAR" id="v_fleet_dx">fleet_dx</field></block></value></block></value><next><block type="controls_if" id="b0125"><comment pinned="false" h="110" w="520">The edge check is performed after a horizontal shift.</comment><value name="IF0"><block type="logic_operation" id="b0116"><field name="OP">OR</field><comment pinned="false" h="110" w="520">Reverse the formation when it reaches an edge.</comment><value name="A"><block type="logic_compare" id="b0112"><field name="OP">LT</field><comment pinned="false" h="110" w="520">The left safe boundary of the formation.</comment><value name="A"><block type="variables_get" id="b0110"><field name="VAR" id="v_fleet_x">fleet_x</field></block></value><value name="B"><shadow type="math_number" id="n0111"><field name="NUM">2</field></shadow></value></block></value><value name="B"><block type="logic_compare" id="b0115"><field name="OP">GT</field><comment pinned="false" h="110" w="520">Right safe boundary for the formation. The rightmost invader is 8 px wide.</comment><value name="A"><block type="variables_get" id="b0113"><field name="VAR" id="v_fleet_x">fleet_x</field></block></value><value name="B"><shadow type="math_number" id="n0114"><field name="NUM">60</field></shadow></value></block></value></block></value><statement name="DO0"><block type="variables_set" id="b0120"><field name="VAR" id="v_fleet_dx">fleet_dx</field><comment pinned="false" h="110" w="520">Reversing the direction of movement of invaders.</comment><value name="VALUE"><block type="math_arithmetic" id="b0119"><field name="OP">MINUS</field><comment pinned="false" h="110" w="520">Subtract fleet_dx from zero to change +1 to −1 and vice versa.</comment><value name="A"><shadow type="math_number" id="n0117"><field name="NUM">0</field></shadow></value><value name="B"><block type="variables_get" id="b0118"><field name="VAR" id="v_fleet_dx">fleet_dx</field></block></value></block></value><next><block type="variables_set" id="b0124"><field name="VAR" id="v_fleet_y">fleet_y</field><comment pinned="false" h="110" w="520">Classic Space Invaders behavior: at an edge, the formation moves down one step.</comment><value name="VALUE"><block type="math_arithmetic" id="b0123"><field name="OP">ADD</field><comment pinned="false" h="110" w="520">Each time it reaches an edge, move the formation down by 2 pixels.</comment><value name="A"><block type="variables_get" id="b0121"><field name="VAR" id="v_fleet_y">fleet_y</field></block></value><value name="B"><shadow type="math_number" id="n0122"><field name="NUM">2</field></shadow></value></block></value></block></next></block></statement></block></next></block></next></block></statement><next><block type="variables_set" id="b0133"><field name="VAR" id="v_enemy_shot_counter">enemy_shot_counter</field><comment pinned="false" h="110" w="520">Enemy fire timing without waiting block.</comment><value name="VALUE"><block type="math_arithmetic" id="b0132"><field name="OP">ADD</field><comment pinned="false" h="110" w="520">We count the passes through the main loop between enemy shots.</comment><value name="A"><block type="variables_get" id="b0130"><field name="VAR" id="v_enemy_shot_counter">enemy_shot_counter</field></block></value><value name="B"><shadow type="math_number" id="n0131"><field name="NUM">1</field></shadow></value></block></value><next><block type="controls_if" id="b0153"><comment pinned="false" h="110" w="520">The invaders fire periodically.</comment><value name="IF0"><block type="logic_operation" id="b0140"><field name="OP">AND</field><comment pinned="false" h="110" w="520">Simple enemy-fire generator.</comment><value name="A"><block type="logic_compare" id="b0136"><field name="OP">EQ</field><comment pinned="false" h="110" w="520">Create a new enemy bullet only after the previous one is gone.</comment><value name="A"><block type="variables_get" id="b0134"><field name="VAR" id="v_enemy_bullet_active">enemy_bullet_active</field></block></value><value name="B"><shadow type="math_number" id="n0135"><field name="NUM">0</field></shadow></value></block></value><value name="B"><block type="logic_compare" id="b0139"><field name="OP">GT</field><comment pinned="false" h="110" w="520">After about 35 main-loop iterations, try to fire.</comment><value name="A"><block type="variables_get" id="b0137"><field name="VAR" id="v_enemy_shot_counter">enemy_shot_counter</field></block></value><value name="B"><shadow type="math_number" id="n0138"><field name="NUM">35</field></shadow></value></block></value></block></value><statement name="DO0"><block type="variables_set" id="b0142"><field name="VAR" id="v_enemy_bullet_active">enemy_bullet_active</field><comment pinned="false" h="110" w="520">Enemy bullet activation.</comment><value name="VALUE"><shadow type="math_number" id="n0141"><field name="NUM">1</field></shadow></value><next><block type="variables_set" id="b0146"><field name="VAR" id="v_enemy_bullet_x">enemy_bullet_x</field><comment pinned="false" h="110" w="520">Calculate the enemy bullet&apos;s X coordinate.</comment><value name="VALUE"><block type="math_arithmetic" id="b0145"><field name="OP">ADD</field><comment pinned="false" h="110" w="520">Fire from approximately the center of the formation. This deliberately simple AI suits a learning project.</comment><value name="A"><block type="variables_get" id="b0143"><field name="VAR" id="v_fleet_x">fleet_x</field></block></value><value name="B"><shadow type="math_number" id="n0144"><field name="NUM">30</field></shadow></value></block></value><next><block type="variables_set" id="b0150"><field name="VAR" id="v_enemy_bullet_y">enemy_bullet_y</field><comment pinned="false" h="110" w="520">Create the bullet just below the invader formation.</comment><value name="VALUE"><block type="math_arithmetic" id="b0149"><field name="OP">ADD</field><comment pinned="false" h="110" w="520">The three invader rows occupy approximately 24 px vertically.</comment><value name="A"><block type="variables_get" id="b0147"><field name="VAR" id="v_fleet_y">fleet_y</field></block></value><value name="B"><shadow type="math_number" id="n0148"><field name="NUM">24</field></shadow></value></block></value><next><block type="variables_set" id="b0152"><field name="VAR" id="v_enemy_shot_counter">enemy_shot_counter</field><comment pinned="false" h="110" w="520">After the shot, the interval will start counting again.</comment><value name="VALUE"><shadow type="math_number" id="n0151"><field name="NUM">0</field></shadow></value></block></next></block></next></block></next></block></statement><next><block type="controls_if" id="b0197"><comment pinned="false" h="110" w="520">Updating enemy bullet.</comment><value name="IF0"><block type="logic_compare" id="b0196"><field name="OP">EQ</field><comment pinned="false" h="110" w="520">Movement and collision are solved only for an active bullet.</comment><value name="A"><block type="variables_get" id="b0194"><field name="VAR" id="v_enemy_bullet_active">enemy_bullet_active</field></block></value><value name="B"><shadow type="math_number" id="n0195"><field name="NUM">1</field></shadow></value></block></value><statement name="DO0"><block type="variables_set" id="b0157"><field name="VAR" id="v_enemy_bullet_y">enemy_bullet_y</field><comment pinned="false" h="110" w="520">Move the enemy bullet down by 2 pixels.</comment><value name="VALUE"><block type="math_arithmetic" id="b0156"><field name="OP">ADD</field><comment pinned="false" h="110" w="520">Enemy bullet is flying down, so its Y coordinate increases.</comment><value name="A"><block type="variables_get" id="b0154"><field name="VAR" id="v_enemy_bullet_y">enemy_bullet_y</field></block></value><value name="B"><shadow type="math_number" id="n0155"><field name="NUM">2</field></shadow></value></block></value><next><block type="controls_if" id="b0163"><comment pinned="false" h="110" w="520">Remove an enemy bullet after it leaves the screen.</comment><value name="IF0"><block type="logic_compare" id="b0160"><field name="OP">GT</field><comment pinned="false" h="110" w="520">The bullet has passed the bottom edge of the screen.</comment><value name="A"><block type="variables_get" id="b0158"><field name="VAR" id="v_enemy_bullet_y">enemy_bullet_y</field></block></value><value name="B"><shadow type="math_number" id="n0159"><field name="NUM">63</field></shadow></value></block></value><statement name="DO0"><block type="variables_set" id="b0162"><field name="VAR" id="v_enemy_bullet_active">enemy_bullet_active</field><comment pinned="false" h="110" w="520">Deactivate the enemy bullet after it leaves the screen.</comment><value name="VALUE"><shadow type="math_number" id="n0161"><field name="NUM">0</field></shadow></value></block></statement><next><block type="controls_if" id="b0193"><comment pinned="false" h="110" w="520">Simple rectangular collision test between the enemy bullet and the ship.</comment><value name="IF0"><block type="logic_operation" id="b0186"><field name="OP">AND</field><comment pinned="false" h="110" w="520">Collision occurs only when there is overlap in both X and Y axes.</comment><value name="A"><block type="logic_operation" id="b0176"><field name="OP">AND</field><comment pinned="false" h="110" w="520">Horizontal overlap between bullet and 11px wide ship.</comment><value name="A"><block type="logic_compare" id="b0170"><field name="OP">GT</field><comment pinned="false" h="110" w="520">The bullet is to the right of the ship&#39;s left edge.</comment><value name="A"><block type="math_arithmetic" id="b0166"><field name="OP">ADD</field><value name="A"><block type="variables_get" id="b0164"><field name="VAR" id="v_enemy_bullet_x">enemy_bullet_x</field></block></value><value name="B"><shadow type="math_number" id="n0165"><field name="NUM">0</field></shadow></value></block></value><value name="B"><block type="math_arithmetic" id="b0169"><field name="OP">MINUS</field><value name="A"><block type="variables_get" id="b0167"><field name="VAR" id="v_player_x">player_x</field></block></value><value name="B"><shadow type="math_number" id="n0168"><field name="NUM">1</field></shadow></value></block></value></block></value><value name="B"><block type="logic_compare" id="b0175"><field name="OP">LT</field><comment pinned="false" h="110" w="520">The bullet is to the left of the ship&#39;s right edge.</comment><value name="A"><block type="variables_get" id="b0171"><field name="VAR" id="v_enemy_bullet_x">enemy_bullet_x</field></block></value><value name="B"><block type="math_arithmetic" id="b0174"><field name="OP">ADD</field><value name="A"><block type="variables_get" id="b0172"><field name="VAR" id="v_player_x">player_x</field></block></value><value name="B"><shadow type="math_number" id="n0173"><field name="NUM">11</field></shadow></value></block></value></block></value></block></value><value name="B"><block type="logic_operation" id="b0185"><field name="OP">AND</field><comment pinned="false" h="110" w="520">Vertical overlap between bullet and ship.</comment><value name="A"><block type="logic_compare" id="b0181"><field name="OP">GT</field><comment pinned="false" h="110" w="520">The bottom 3px of the bullet reached the area of the ship.</comment><value name="A"><block type="math_arithmetic" id="b0179"><field name="OP">ADD</field><value name="A"><block type="variables_get" id="b0177"><field name="VAR" id="v_enemy_bullet_y">enemy_bullet_y</field></block></value><value name="B"><shadow type="math_number" id="n0178"><field name="NUM">2</field></shadow></value></block></value><value name="B"><shadow type="math_number" id="n0180"><field name="NUM">56</field></shadow></value></block></value><value name="B"><block type="logic_compare" id="b0184"><field name="OP">LT</field><comment pinned="false" h="110" w="520">The top part of the bullet is still above the bottom edge of the ship.</comment><value name="A"><block type="variables_get" id="b0182"><field name="VAR" id="v_enemy_bullet_y">enemy_bullet_y</field></block></value><value name="B"><shadow type="math_number" id="n0183"><field name="NUM">63</field></shadow></value></block></value></block></value></block></value><statement name="DO0"><block type="variables_set" id="b0188"><field name="VAR" id="v_enemy_bullet_active">enemy_bullet_active</field><comment pinned="false" h="110" w="520">After impact, the enemy bullet disappears.</comment><value name="VALUE"><shadow type="math_number" id="n0187"><field name="NUM">0</field></shadow></value><next><block type="variables_set" id="b0192"><field name="VAR" id="v_lives">lives</field><comment pinned="false" h="110" w="520">An enemy-bullet hit removes one life.</comment><value name="VALUE"><block type="math_arithmetic" id="b0191"><field name="OP">MINUS</field><comment pinned="false" h="110" w="520">Lose one life: lives − 1.</comment><value name="A"><block type="variables_get" id="b0189"><field name="VAR" id="v_lives">lives</field></block></value><value name="B"><shadow type="math_number" id="n0190"><field name="NUM">1</field></shadow></value></block></value></block></next></block></statement></block></next></block></next></block></statement><next><block type="controls_if" id="b0281"><comment pinned="false" h="110" w="520">Check for collisions between the player's bullet and the invader formation.</comment><value name="IF0"><block type="logic_compare" id="b0280"><field name="OP">EQ</field><comment pinned="false" h="110" w="520">If the player's bullet is not active, we skip the more complex check of all 18 invaders.</comment><value name="A"><block type="variables_get" id="b0278"><field name="VAR" id="v_bullet_active">bullet_active</field></block></value><value name="B"><shadow type="math_number" id="n0279"><field name="NUM">1</field></shadow></value></block></value><statement name="DO0"><block type="controls_for" id="b0277"><field name="VAR" id="v_row">row</field><comment pinned="false" h="110" w="520">The outer loop goes through the three rows of the formation. Together, this checks all 18 invaders.</comment><value name="FROM"><shadow type="math_number" id="n0274"><field name="NUM">0</field></shadow></value><value name="TO"><shadow type="math_number" id="n0275"><field name="NUM">2</field></shadow></value><value name="BY"><shadow type="math_number" id="n0276"><field name="NUM">1</field></shadow></value><statement name="DO"><block type="controls_for" id="b0273"><field name="VAR" id="v_col">col</field><comment pinned="false" h="110" w="520">The inner loop goes through six columns of the current row.</comment><value name="FROM"><shadow type="math_number" id="n0270"><field name="NUM">0</field></shadow></value><value name="TO"><shadow type="math_number" id="n0271"><field name="NUM">5</field></shadow></value><value name="BY"><shadow type="math_number" id="n0272"><field name="NUM">1</field></shadow></value><statement name="DO"><block type="variables_set" id="b0203"><field name="VAR" id="v_idx">idx</field><comment pinned="false" h="110" w="520">Conversion of row/column pair to index 0…17.</comment><value name="VALUE"><block type="math_arithmetic" id="b0202"><field name="OP">ADD</field><comment pinned="false" h="110" w="520">Linear index = row &#215; 6 + col.</comment><value name="A"><block type="math_arithmetic" id="b0200"><field name="OP">MULTIPLY</field><comment pinned="false" h="110" w="520">Each row has 6 invaders, so it starts at row &#215; 6.</comment><value name="A"><block type="variables_get" id="b0198"><field name="VAR" id="v_row">row</field></block></value><value name="B"><shadow type="math_number" id="n0199"><field name="NUM">6</field></shadow></value></block></value><value name="B"><block type="variables_get" id="b0201"><field name="VAR" id="v_col">col</field></block></value></block></value><next><block type="variables_set" id="b0209"><field name="VAR" id="v_invader_x">invader_x</field><comment pinned="false" h="110" w="520">Calculation of the actual X coordinate of the current invader.</comment><value name="VALUE"><block type="math_arithmetic" id="b0208"><field name="OP">ADD</field><comment pinned="false" h="110" w="520">Invader X = formation offset + column × 11.</comment><value name="A"><block type="variables_get" id="b0204"><field name="VAR" id="v_fleet_x">fleet_x</field></block></value><value name="B"><block type="math_arithmetic" id="b0207"><field name="OP">MULTIPLY</field><comment pinned="false" h="110" w="520">One formation cell has a step of 11 px: 8px sprite + 3px gap.</comment><value name="A"><block type="variables_get" id="b0205"><field name="VAR" id="v_col">col</field></block></value><value name="B"><shadow type="math_number" id="n0206"><field name="NUM">11</field></shadow></value></block></value></block></value><next><block type="variables_set" id="b0215"><field name="VAR" id="v_invader_y">invader_y</field><comment pinned="false" h="110" w="520">Calculation of the actual Y coordinate of the current invader.</comment><value name="VALUE"><block type="math_arithmetic" id="b0214"><field name="OP">ADD</field><comment pinned="false" h="110" w="520">Invader Y = formation offset + row × 9.</comment><value name="A"><block type="variables_get" id="b0210"><field name="VAR" id="v_fleet_y">fleet_y</field></block></value><value name="B"><block type="math_arithmetic" id="b0213"><field name="OP">MULTIPLY</field><comment pinned="false" h="110" w="520">Rows are spaced 9 px apart: 6px sprite + 3px gap.</comment><value name="A"><block type="variables_get" id="b0211"><field name="VAR" id="v_row">row</field></block></value><value name="B"><shadow type="math_number" id="n0212"><field name="NUM">9</field></shadow></value></block></value></block></value><next><block type="controls_if" id="b0269"><comment pinned="false" h="110" w="520">A dead invader is skipped on collisions.</comment><value name="IF0"><block type="logic_compare" id="b0222"><field name="OP">EQ</field><comment pinned="false" h="110" w="520">Collisions are checked only with live invaders.</comment><value name="A"><block type="lists_getIndex" id="b0220"><mutation statement="false" at="true"></mutation><field name="MODE">GET</field><field name="WHERE">FROM_START</field><comment pinned="false" h="110" w="520">Reads the state of the current invader from the invaders array.</comment><value name="VALUE"><block type="variables_get" id="b0219"><field name="VAR" id="v_invaders">invaders</field></block></value><value name="AT"><block type="math_arithmetic" id="b0218"><field name="OP">ADD</field><comment pinned="false" h="110" w="520">Adding 1 converts the internal index 0…17 to position 1…18 used by the list block.</comment><value name="A"><block type="variables_get" id="b0216"><field name="VAR" id="v_idx">idx</field></block></value><value name="B"><shadow type="math_number" id="n0217"><field name="NUM">1</field></shadow></value></block></value></block></value><value name="B"><shadow type="math_number" id="n0221"><field name="NUM">1</field></shadow></value></block></value><statement name="DO0"><block type="controls_if" id="b0268"><comment pinned="false" h="110" w="520">Collision of the bullet with a specific live invader.</comment><value name="IF0"><block type="logic_operation" id="b0251"><field name="OP">AND</field><comment pinned="false" h="110" w="520">A hit requires an active bullet and geometric collision.</comment><value name="A"><block type="logic_compare" id="b0249"><field name="OP">EQ</field><comment pinned="false" h="110" w="520">This condition prevents one bullet from destroying multiple invaders during the same loop pass.</comment><value name="A"><block type="variables_get" id="b0247"><field name="VAR" id="v_bullet_active">bullet_active</field></block></value><value name="B"><shadow type="math_number" id="n0248"><field name="NUM">1</field></shadow></value></block></value><value name="B"><block type="logic_operation" id="b0250"><field name="OP">AND</field><comment pinned="false" h="110" w="520">The coordinates must overlap in both axes.</comment><value name="A"><block type="logic_operation" id="b0233"><field name="OP">AND</field><comment pinned="false" h="110" w="520">Horizontal overlap between the bullet and the invader.</comment><value name="A"><block type="logic_compare" id="b0227"><field name="OP">GT</field><comment pinned="false" h="110" w="520">The bullet is to the right of the invader&#39;s left edge.</comment><value name="A"><block type="variables_get" id="b0223"><field name="VAR" id="v_bullet_x">bullet_x</field></block></value><value name="B"><block type="math_arithmetic" id="b0226"><field name="OP">MINUS</field><value name="A"><block type="variables_get" id="b0224"><field name="VAR" id="v_invader_x">invader_x</field></block></value><value name="B"><shadow type="math_number" id="n0225"><field name="NUM">1</field></shadow></value></block></value></block></value><value name="B"><block type="logic_compare" id="b0232"><field name="OP">LT</field><comment pinned="false" h="110" w="520">The bullet is to the left of the invader&#39;s right edge (8px sprite).</comment><value name="A"><block type="variables_get" id="b0228"><field name="VAR" id="v_bullet_x">bullet_x</field></block></value><value name="B"><block type="math_arithmetic" id="b0231"><field name="OP">ADD</field><value name="A"><block type="variables_get" id="b0229"><field name="VAR" id="v_invader_x">invader_x</field></block></value><value name="B"><shadow type="math_number" id="n0230"><field name="NUM">8</field></shadow></value></block></value></block></value></block></value><value name="B"><block type="logic_operation" id="b0246"><field name="OP">AND</field><comment pinned="false" h="110" w="520">Vertical overlap between the bullet and the invader.</comment><value name="A"><block type="logic_compare" id="b0240"><field name="OP">GT</field><comment pinned="false" h="110" w="520">The bottom of the bullet has reached the invader&apos;s top edge.</comment><value name="A"><block type="math_arithmetic" id="b0236"><field name="OP">ADD</field><value name="A"><block type="variables_get" id="b0234"><field name="VAR" id="v_bullet_y">bullet_y</field></block></value><value name="B"><shadow type="math_number" id="n0235"><field name="NUM">2</field></shadow></value></block></value><value name="B"><block type="math_arithmetic" id="b0239"><field name="OP">MINUS</field><value name="A"><block type="variables_get" id="b0237"><field name="VAR" id="v_invader_y">invader_y</field></block></value><value name="B"><shadow type="math_number" id="n0238"><field name="NUM">1</field></shadow></value></block></value></block></value><value name="B"><block type="logic_compare" id="b0245"><field name="OP">LT</field><comment pinned="false" h="110" w="520">The top of the bullet has not yet passed below the 6 px invader.</comment><value name="A"><block type="variables_get" id="b0241"><field name="VAR" id="v_bullet_y">bullet_y</field></block></value><value name="B"><block type="math_arithmetic" id="b0244"><field name="OP">ADD</field><value name="A"><block type="variables_get" id="b0242"><field name="VAR" id="v_invader_y">invader_y</field></block></value><value name="B"><shadow type="math_number" id="n0243"><field name="NUM">6</field></shadow></value></block></value></block></value></block></value></block></value></block></value><statement name="DO0"><block type="lists_setIndex" id="b0257"><mutation at="true"></mutation><field name="MODE">SET</field><field name="WHERE">FROM_START</field><comment pinned="false" h="110" w="520">The hit invader is changed from 1 to 0 in the array. This removes it from drawing and from later collision checks.</comment><value name="LIST"><block type="variables_get" id="b0256"><field name="VAR" id="v_invaders">invaders</field></block></value><value name="AT"><block type="math_arithmetic" id="b0255"><field name="OP">ADD</field><comment pinned="false" h="110" w="520">Converting internal index 0…17 to a one-based position in the list.</comment><value name="A"><block type="variables_get" id="b0252"><field name="VAR" id="v_idx">idx</field></block></value><value name="B"><shadow type="math_number" id="n0254"><field name="NUM">1</field></shadow></value></block></value><value name="TO"><shadow type="math_number" id="n0253"><field name="NUM">0</field></shadow></value><next><block type="variables_set" id="b0259"><field name="VAR" id="v_bullet_active">bullet_active</field><comment pinned="false" h="110" w="520">Player&#39;s bullet will disappear after hitting.</comment><value name="VALUE"><shadow type="math_number" id="n0258"><field name="NUM">0</field></shadow></value><next><block type="variables_set" id="b0263"><field name="VAR" id="v_score">score</field><comment pinned="false" h="110" w="520">Update the score.</comment><value name="VALUE"><block type="math_arithmetic" id="b0262"><field name="OP">ADD</field><comment pinned="false" h="110" w="520">We add one point for the destroyed invader.</comment><value name="A"><block type="variables_get" id="b0260"><field name="VAR" id="v_score">score</field></block></value><value name="B"><shadow type="math_number" id="n0261"><field name="NUM">1</field></shadow></value></block></value><next><block type="variables_set" id="b0267"><field name="VAR" id="v_alive_count">alive_count</field><comment pinned="false" h="110" w="520">alive_count makes it easy to detect when the entire wave is cleared.</comment><value name="VALUE"><block type="math_arithmetic" id="b0266"><field name="OP">MINUS</field><comment pinned="false" h="110" w="520">We decrease the count of living invaders by 1.</comment><value name="A"><block type="variables_get" id="b0264"><field name="VAR" id="v_alive_count">alive_count</field></block></value><value name="B"><shadow type="math_number" id="n0265"><field name="NUM">1</field></shadow></value></block></value></block></next></block></next></block></next></block></statement></block></statement></block></next></block></next></block></next></block></statement></block></statement></block></statement><next><block type="controls_if" id="b0287"><comment pinned="false" h="110" w="520">Invaders must not fall all the way down to the player.</comment><value name="IF0"><block type="logic_compare" id="b0284"><field name="OP">GT</field><comment pinned="false" h="110" w="520">If the common Y offset exceeds 30, the bottom row of invaders is dangerously close to the ship.</comment><value name="A"><block type="variables_get" id="b0282"><field name="VAR" id="v_fleet_y">fleet_y</field></block></value><value name="B"><shadow type="math_number" id="n0283"><field name="NUM">30</field></shadow></value></block></value><statement name="DO0"><block type="variables_set" id="b0286"><field name="VAR" id="v_lives">lives</field><comment pinned="false" h="110" w="520">Reaching the bottom part of the screen means GAME OVER.</comment><value name="VALUE"><shadow type="math_number" id="n0285"><field name="NUM">0</field></shadow></value></block></statement><next><block type="controls_if" id="b0311"><comment pinned="false" h="110" w="520">Victory over the entire wave automatically creates a new formation.</comment><value name="IF0"><block type="logic_compare" id="b0310"><field name="OP">EQ</field><comment pinned="false" h="110" w="520">As soon as no living invaders remain, the player has completed the wave.</comment><value name="A"><block type="variables_get" id="b0308"><field name="VAR" id="v_alive_count">alive_count</field></block></value><value name="B"><shadow type="math_number" id="n0309"><field name="NUM">0</field></shadow></value></block></value><statement name="DO0"><block type="variables_set" id="b0291"><field name="VAR" id="v_invaders">invaders</field><comment pinned="false" h="110" w="520">Reset the invader array after victory.</comment><value name="VALUE"><block type="lists_repeat" id="b0290"><comment pinned="false" h="110" w="520">A new wave will again create 18 living invaders.</comment><value name="ITEM"><shadow type="math_number" id="n0288"><field name="NUM">1</field></shadow></value><value name="NUM"><shadow type="math_number" id="n0289"><field name="NUM">18</field></shadow></value></block></value><next><block type="variables_set" id="b0293"><field name="VAR" id="v_alive_count">alive_count</field><comment pinned="false" h="110" w="520">The new wave again contains 18 live invaders.</comment><value name="VALUE"><shadow type="math_number" id="n0292"><field name="NUM">18</field></shadow></value><next><block type="variables_set" id="b0295"><field name="VAR" id="v_score">score</field><comment pinned="false" h="110" w="520">In this simple version, the score also shows progress through the current wave, so it resets for the new wave.</comment><value name="VALUE"><shadow type="math_number" id="n0294"><field name="NUM">0</field></shadow></value><next><block type="variables_set" id="b0297"><field name="VAR" id="v_fleet_x">fleet_x</field><comment pinned="false" h="110" w="520">The formation returns to its initial X position.</comment><value name="VALUE"><shadow type="math_number" id="n0296"><field name="NUM">12</field></shadow></value><next><block type="variables_set" id="b0299"><field name="VAR" id="v_fleet_y">fleet_y</field><comment pinned="false" h="110" w="520">The formation returns to the top.</comment><value name="VALUE"><shadow type="math_number" id="n0298"><field name="NUM">6</field></shadow></value><next><block type="variables_set" id="b0301"><field name="VAR" id="v_fleet_dx">fleet_dx</field><comment pinned="false" h="110" w="520">A new wave will start moving to the right.</comment><value name="VALUE"><shadow type="math_number" id="n0300"><field name="NUM">1</field></shadow></value><next><block type="variables_set" id="b0303"><field name="VAR" id="v_bullet_active">bullet_active</field><comment pinned="false" h="110" w="520">Remove the player&apos;s bullet when starting a new wave.</comment><value name="VALUE"><shadow type="math_number" id="n0302"><field name="NUM">0</field></shadow></value><next><block type="variables_set" id="b0305"><field name="VAR" id="v_enemy_bullet_active">enemy_bullet_active</field><comment pinned="false" h="110" w="520">Remove the enemy bullet when starting a new wave.</comment><value name="VALUE"><shadow type="math_number" id="n0304"><field name="NUM">0</field></shadow></value><next><block type="variables_set" id="b0307"><field name="VAR" id="v_enemy_shot_counter">enemy_shot_counter</field><comment pinned="false" h="110" w="520">Restart the enemy-fire timer.</comment><value name="VALUE"><shadow type="math_number" id="n0306"><field name="NUM">0</field></shadow></value></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></statement><next><block type="controls_if" id="b0341"><comment pinned="false" h="110" w="520">Simple automatic restart after losing all lives.</comment><value name="IF0"><block type="logic_compare" id="b0340"><field name="OP">LT</field><comment pinned="false" h="110" w="520">Zero lives means GAME OVER.</comment><value name="A"><block type="variables_get" id="b0338"><field name="VAR" id="v_lives">lives</field></block></value><value name="B"><shadow type="math_number" id="n0339"><field name="NUM">1</field></shadow></value></block></value><statement name="DO0"><block type="variables_set" id="b0313"><field name="VAR" id="v_lives">lives</field><comment pinned="false" h="110" w="520">After GAME OVER, the player gets three lives again.</comment><value name="VALUE"><shadow type="math_number" id="n0312"><field name="NUM">3</field></shadow></value><next><block type="variables_set" id="b0315"><field name="VAR" id="v_score">score</field><comment pinned="false" h="110" w="520">A new game starts at score 0.</comment><value name="VALUE"><shadow type="math_number" id="n0314"><field name="NUM">0</field></shadow></value><next><block type="variables_set" id="b0317"><field name="VAR" id="v_player_x">player_x</field><comment pinned="false" h="110" w="520">The ship returns to the center.</comment><value name="VALUE"><shadow type="math_number" id="n0316"><field name="NUM">58</field></shadow></value><next><block type="variables_set" id="b0321"><field name="VAR" id="v_invaders">invaders</field><comment pinned="false" h="110" w="520">A new game creates the entire formation of invaders.</comment><value name="VALUE"><block type="lists_repeat" id="b0320"><comment pinned="false" h="110" w="520">All positions in a new game start as alive.</comment><value name="ITEM"><shadow type="math_number" id="n0318"><field name="NUM">1</field></shadow></value><value name="NUM"><shadow type="math_number" id="n0319"><field name="NUM">18</field></shadow></value></block></value><next><block type="variables_set" id="b0323"><field name="VAR" id="v_alive_count">alive_count</field><comment pinned="false" h="110" w="520">Restore the number of live invaders.</comment><value name="VALUE"><shadow type="math_number" id="n0322"><field name="NUM">18</field></shadow></value><next><block type="variables_set" id="b0325"><field name="VAR" id="v_fleet_x">fleet_x</field><comment pinned="false" h="110" w="520">Reset the formation's horizontal offset.</comment><value name="VALUE"><shadow type="math_number" id="n0324"><field name="NUM">12</field></shadow></value><next><block type="variables_set" id="b0327"><field name="VAR" id="v_fleet_y">fleet_y</field><comment pinned="false" h="110" w="520">Reset the formation's vertical offset.</comment><value name="VALUE"><shadow type="math_number" id="n0326"><field name="NUM">6</field></shadow></value><next><block type="variables_set" id="b0329"><field name="VAR" id="v_fleet_dx">fleet_dx</field><comment pinned="false" h="110" w="520">Reset the formation&apos;s movement direction.</comment><value name="VALUE"><shadow type="math_number" id="n0328"><field name="NUM">1</field></shadow></value><next><block type="variables_set" id="b0331"><field name="VAR" id="v_fleet_counter">fleet_counter</field><comment pinned="false" h="110" w="520">Reset the formation&apos;s movement counter.</comment><value name="VALUE"><shadow type="math_number" id="n0330"><field name="NUM">0</field></shadow></value><next><block type="variables_set" id="b0333"><field name="VAR" id="v_bullet_active">bullet_active</field><comment pinned="false" h="110" w="520">Remove the player&apos;s bullet.</comment><value name="VALUE"><shadow type="math_number" id="n0332"><field name="NUM">0</field></shadow></value><next><block type="variables_set" id="b0335"><field name="VAR" id="v_enemy_bullet_active">enemy_bullet_active</field><comment pinned="false" h="110" w="520">Remove the enemy bullet.</comment><value name="VALUE"><shadow type="math_number" id="n0334"><field name="NUM">0</field></shadow></value><next><block type="variables_set" id="b0337"><field name="VAR" id="v_enemy_shot_counter">enemy_shot_counter</field><comment pinned="false" h="110" w="520">Reset the enemy-fire timer.</comment><value name="VALUE"><shadow type="math_number" id="n0336"><field name="NUM">0</field></shadow></value></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></statement><next><block type="fb_fill" id="inv_clear"><field name="barva">0</field><comment pinned="false" h="110" w="520">Start drawing the frame. We fill the entire framebuffer with black so moving objects leave no trails.</comment><next><block type="fb_rect_fill" id="b0349"><comment pinned="false" h="110" w="520">A short bar in the upper left shows the number of lives without needing a text font.</comment><value name="px"><shadow type="math_number" id="n0345"><field name="NUM">2</field></shadow></value><value name="py"><shadow type="math_number" id="n0346"><field name="NUM">1</field></shadow></value><value name="sirka"><block type="math_arithmetic" id="b0344"><field name="OP">MULTIPLY</field><comment pinned="false" h="110" w="520">Each life takes up 4 pixels in the indicator.</comment><value name="A"><block type="variables_get" id="b0342"><field name="VAR" id="v_lives">lives</field></block></value><value name="B"><shadow type="math_number" id="n0343"><field name="NUM">4</field></shadow></value></block></value><value name="vyska"><shadow type="math_number" id="n0347"><field name="NUM">2</field></shadow></value><value name="col"><shadow type="math_number" id="n0348"><field name="NUM">1</field></shadow></value><next><block type="fb_rect_fill" id="b0357"><comment pinned="false" h="110" w="520">Top score/progress indicator. At 18 hits, it has a width of 54 px.</comment><value name="px"><shadow type="math_number" id="n0353"><field name="NUM">20</field></shadow></value><value name="py"><shadow type="math_number" id="n0354"><field name="NUM">1</field></shadow></value><value name="sirka"><block type="math_arithmetic" id="b0352"><field name="OP">MULTIPLY</field><comment pinned="false" h="110" w="520">Each hit adds 3 pixels to the indicator for progress through the current wave.</comment><value name="A"><block type="variables_get" id="b0350"><field name="VAR" id="v_score">score</field></block></value><value name="B"><shadow type="math_number" id="n0351"><field name="NUM">3</field></shadow></value></block></value><value name="vyska"><shadow type="math_number" id="n0355"><field name="NUM">2</field></shadow></value><value name="col"><shadow type="math_number" id="n0356"><field name="NUM">1</field></shadow></value><next><block type="controls_for" id="b0415"><field name="VAR" id="v_row">row</field><comment pinned="false" h="110" w="520">Drawing loop across three rows. One pair of loops draws the entire formation.</comment><value name="FROM"><shadow type="math_number" id="n0412"><field name="NUM">0</field></shadow></value><value name="TO"><shadow type="math_number" id="n0413"><field name="NUM">2</field></shadow></value><value name="BY"><shadow type="math_number" id="n0414"><field name="NUM">1</field></shadow></value><statement name="DO"><block type="controls_for" id="b0411"><field name="VAR" id="v_col">col</field><comment pinned="false" h="110" w="520">Drawing loop across six columns.</comment><value name="FROM"><shadow type="math_number" id="n0408"><field name="NUM">0</field></shadow></value><value name="TO"><shadow type="math_number" id="n0409"><field name="NUM">5</field></shadow></value><value name="BY"><shadow type="math_number" id="n0410"><field name="NUM">1</field></shadow></value><statement name="DO"><block type="variables_set" id="b0363"><field name="VAR" id="v_idx">idx</field><comment pinned="false" h="110" w="520">Calculate the invader&apos;s list index for drawing.</comment><value name="VALUE"><block type="math_arithmetic" id="b0362"><field name="OP">ADD</field><comment pinned="false" h="110" w="520">Index of the current invader for drawing.</comment><value name="A"><block type="math_arithmetic" id="b0360"><field name="OP">MULTIPLY</field><comment pinned="false" h="110" w="520">Convert the row into the start of its six-item section in the list.</comment><value name="A"><block type="variables_get" id="b0358"><field name="VAR" id="v_row">row</field></block></value><value name="B"><shadow type="math_number" id="n0359"><field name="NUM">6</field></shadow></value></block></value><value name="B"><block type="variables_get" id="b0361"><field name="VAR" id="v_col">col</field></block></value></block></value><next><block type="variables_set" id="b0369"><field name="VAR" id="v_invader_x">invader_x</field><comment pinned="false" h="110" w="520">Actual X coordinate of the invader.</comment><value name="VALUE"><block type="math_arithmetic" id="b0368"><field name="OP">ADD</field><comment pinned="false" h="110" w="520">Calculate the invader sprite&apos;s X coordinate.</comment><value name="A"><block type="variables_get" id="b0364"><field name="VAR" id="v_fleet_x">fleet_x</field></block></value><value name="B"><block type="math_arithmetic" id="b0367"><field name="OP">MULTIPLY</field><comment pinned="false" h="110" w="520">The columns are 11 px apart.</comment><value name="A"><block type="variables_get" id="b0365"><field name="VAR" id="v_col">col</field></block></value><value name="B"><shadow type="math_number" id="n0366"><field name="NUM">11</field></shadow></value></block></value></block></value><next><block type="variables_set" id="b0375"><field name="VAR" id="v_invader_y">invader_y</field><comment pinned="false" h="110" w="520">Actual Y coordinate of the invader.</comment><value name="VALUE"><block type="math_arithmetic" id="b0374"><field name="OP">ADD</field><comment pinned="false" h="110" w="520">Calculate the invader sprite&apos;s Y coordinate.</comment><value name="A"><block type="variables_get" id="b0370"><field name="VAR" id="v_fleet_y">fleet_y</field></block></value><value name="B"><block type="math_arithmetic" id="b0373"><field name="OP">MULTIPLY</field><comment pinned="false" h="110" w="520">Rows are 9 pixels apart.</comment><value name="A"><block type="variables_get" id="b0371"><field name="VAR" id="v_row">row</field></block></value><value name="B"><shadow type="math_number" id="n0372"><field name="NUM">9</field></shadow></value></block></value></block></value><next><block type="controls_if" id="b0407"><comment pinned="false" h="110" w="520">Choose a sprite for each live invader according to its row.</comment><value name="IF0"><block type="logic_compare" id="b0382"><field name="OP">EQ</field><comment pinned="false" h="110" w="520">Draw only invaders whose state is 1.</comment><value name="A"><block type="lists_getIndex" id="b0380"><mutation statement="false" at="true"></mutation><field name="MODE">GET</field><field name="WHERE">FROM_START</field><comment pinned="false" h="110" w="520">Read the invader&apos;s state from the list again while drawing.</comment><value name="VALUE"><block type="variables_get" id="b0379"><field name="VAR" id="v_invaders">invaders</field></block></value><value name="AT"><block type="math_arithmetic" id="b0378"><field name="OP">ADD</field><comment pinned="false" h="110" w="520">Adding 1 converts the internal index 0…17 to position 1…18 used by the list block.</comment><value name="A"><block type="variables_get" id="b0376"><field name="VAR" id="v_idx">idx</field></block></value><value name="B"><shadow type="math_number" id="n0377"><field name="NUM">1</field></shadow></value></block></value></block></value><value name="B"><shadow type="math_number" id="n0381"><field name="NUM">1</field></shadow></value></block></value><statement name="DO0"><block type="controls_if" id="b0390"><comment pinned="false" h="110" w="520">Choose the sprite for the top row.</comment><value name="IF0"><block type="logic_compare" id="b0385"><field name="OP">EQ</field><comment pinned="false" h="110" w="520">The first row uses sprite type A.</comment><value name="A"><block type="variables_get" id="b0383"><field name="VAR" id="v_row">row</field></block></value><value name="B"><shadow type="math_number" id="n0384"><field name="NUM">0</field></shadow></value></block></value><statement name="DO0"><block type="fb_draw_pic" id="b0389"><field name="name">Invader_A_8x6</field><field name="alpha">-1</field><comment pinned="false" h="110" w="520">Sprite A, 8×6 px:
  ####  
########
## ## ##
########
  #  #  
 #    # 
Each image column is stored as one framebuffer byte.</comment><value name="px"><block type="variables_get" id="b0386"><field name="VAR" id="v_invader_x">invader_x</field></block></value><value name="py"><block type="variables_get" id="b0387"><field name="VAR" id="v_invader_y">invader_y</field></block></value><value name="data"><shadow type="text" id="t0388"><field name="TEXT">bytearray(b'\x0e\x2e\x1b\x0f\x0f\x1b\x2e\x0e'), 8, 8</field></shadow></value></block></statement><next><block type="controls_if" id="b0398"><comment pinned="false" h="110" w="520">Choose the sprite for the middle row.</comment><value name="IF0"><block type="logic_compare" id="b0393"><field name="OP">EQ</field><comment pinned="false" h="110" w="520">The middle row uses sprite type B.</comment><value name="A"><block type="variables_get" id="b0391"><field name="VAR" id="v_row">row</field></block></value><value name="B"><shadow type="math_number" id="n0392"><field name="NUM">1</field></shadow></value></block></value><statement name="DO0"><block type="fb_draw_pic" id="b0397"><field name="name">Invader_B_8x6</field><field name="alpha">-1</field><comment pinned="false" h="110" w="520">Sprite B, 8×6 px:
  #  #  
   ##   
 ###### 
## ## ##
########
 #    # 
The second invader type has a different silhouette, but the same dimensions and collision area.</comment><value name="px"><block type="variables_get" id="b0394"><field name="VAR" id="v_invader_x">invader_x</field></block></value><value name="py"><block type="variables_get" id="b0395"><field name="VAR" id="v_invader_y">invader_y</field></block></value><value name="data"><shadow type="text" id="t0396"><field name="TEXT">bytearray(b'\x18\x3c\x15\x1e\x1e\x15\x3c\x18'), 8, 8</field></shadow></value></block></statement><next><block type="controls_if" id="b0406"><comment pinned="false" h="110" w="520">Choose the sprite for the bottom row.</comment><value name="IF0"><block type="logic_compare" id="b0401"><field name="OP">EQ</field><comment pinned="false" h="110" w="520">The bottom row uses sprite type C.</comment><value name="A"><block type="variables_get" id="b0399"><field name="VAR" id="v_row">row</field></block></value><value name="B"><shadow type="math_number" id="n0400"><field name="NUM">2</field></shadow></value></block></value><statement name="DO0"><block type="fb_draw_pic" id="b0405"><field name="name">Invader_C_8x6</field><field name="alpha">-1</field><comment pinned="false" h="110" w="520">Sprite C, 8×6 px:
   ##   
  ####  
 ###### 
## ## ##
########
  #  #  
The graphics are deliberately simple so students can easily redraw or modify them.</comment><value name="px"><block type="variables_get" id="b0402"><field name="VAR" id="v_invader_x">invader_x</field></block></value><value name="py"><block type="variables_get" id="b0403"><field name="VAR" id="v_invader_y">invader_y</field></block></value><value name="data"><shadow type="text" id="t0404"><field name="TEXT">bytearray(b'\x18\x1c\x36\x1f\x1f\x36\x1c\x18'), 8, 8</field></shadow></value></block></statement></block></next></block></next></block></statement></block></next></block></next></block></next></block></statement></block></statement><next><block type="controls_if" id="b0425"><comment pinned="false" h="110" w="520">Draw the player&apos;s bullet.</comment><value name="IF0"><block type="logic_compare" id="b0418"><field name="OP">EQ</field><comment pinned="false" h="110" w="520">The player&#39;s bullet is drawn only when active.</comment><value name="A"><block type="variables_get" id="b0416"><field name="VAR" id="v_bullet_active">bullet_active</field></block></value><value name="B"><shadow type="math_number" id="n0417"><field name="NUM">1</field></shadow></value></block></value><statement name="DO0"><block type="fb_rect_fill" id="b0424"><comment pinned="false" h="110" w="520">The player&apos;s bullet is a simple 1×3 px rectangle—easy to see and inexpensive to draw on a small display.</comment><value name="px"><block type="variables_get" id="b0419"><field name="VAR" id="v_bullet_x">bullet_x</field></block></value><value name="py"><block type="variables_get" id="b0420"><field name="VAR" id="v_bullet_y">bullet_y</field></block></value><value name="sirka"><shadow type="math_number" id="n0421"><field name="NUM">1</field></shadow></value><value name="vyska"><shadow type="math_number" id="n0422"><field name="NUM">3</field></shadow></value><value name="col"><shadow type="math_number" id="n0423"><field name="NUM">1</field></shadow></value></block></statement><next><block type="controls_if" id="b0435"><comment pinned="false" h="110" w="520">Draw the enemy bullet.</comment><value name="IF0"><block type="logic_compare" id="b0428"><field name="OP">EQ</field><comment pinned="false" h="110" w="520">Draw the enemy bullet only while it is active.</comment><value name="A"><block type="variables_get" id="b0426"><field name="VAR" id="v_enemy_bullet_active">enemy_bullet_active</field></block></value><value name="B"><shadow type="math_number" id="n0427"><field name="NUM">1</field></shadow></value></block></value><statement name="DO0"><block type="fb_rect_fill" id="b0434"><comment pinned="false" h="110" w="520">The enemy bullet uses the same simple shape; its downward movement distinguishes it.</comment><value name="px"><block type="variables_get" id="b0429"><field name="VAR" id="v_enemy_bullet_x">enemy_bullet_x</field></block></value><value name="py"><block type="variables_get" id="b0430"><field name="VAR" id="v_enemy_bullet_y">enemy_bullet_y</field></block></value><value name="sirka"><shadow type="math_number" id="n0431"><field name="NUM">1</field></shadow></value><value name="vyska"><shadow type="math_number" id="n0432"><field name="NUM">3</field></shadow></value><value name="col"><shadow type="math_number" id="n0433"><field name="NUM">1</field></shadow></value></block></statement><next><block type="fb_draw_pic" id="inv_player_ship"><field name="name">Player_ship_11x6</field><field name="alpha">-1</field><comment pinned="false" h="110" w="520">Player ship, 11×6 px:
     #     
    ###    
   #####   
  #######  
 ######### 
###########
We draw the ship near the end, so its opaque bitmap remains visually on top.</comment><value name="px"><block type="variables_get" id="b0436"><field name="VAR" id="v_player_x">player_x</field></block></value><value name="py"><shadow type="math_number" id="n0437"><field name="NUM">57</field></shadow></value><value name="data"><shadow type="text" id="t0438"><field name="TEXT">bytearray(b'\x20\x30\x38\x3c\x3e\x3f\x3e\x3c\x38\x30\x20'), 11, 8</field></shadow></value><next><block type="oded_refresh" id="inv_refresh"><comment pinned="false" h="110" w="520">We send the completed framebuffer to the OLED. This ends one game frame, and the program immediately continues with the next PROGRAM LOOP pass.</comment></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></statement></block>
  <!--ESPIDE_EXTENSIONS_BEGIN-->
eyJ2ZXJzaW9uIjoxLCJwcm9jZXNzb3IiOiJTaW11bGF0b3IiLCJleHRlbnNpb25zIjpbXX0=
<!--ESPIDE_EXTENSIONS_END-->
</xml>


