<xml xmlns="https://developers.google.com/blockly/xml"><variables><variable id="count-value">press_count</variable></variables><block type="program_start" id="count-start" x="60" y="50"><comment pinned="false" h="65" w="310">This part prepares the button and variables. It runs only once after the board starts.</comment><next><block type="gpio_init_get" id="count-input-init"><field name="in_pin">Pin.PULL_UP</field><comment pinned="false" h="105" w="350">Connect the button between the selected pin and GND. The internal/external pull-up resistor keeps the input at logic 1; when pressed, we read logic 0.</comment><value name="pin"><shadow type="math_number" id="count-input-pin"><field name="NUM">16</field></shadow></value><next><block type="variables_set" id="count-reset"><field name="VAR" id="count-value">press_count</field><comment pinned="false" h="55" w="280">Set the "press_count" variable to its initial value. </comment><value name="VALUE"><shadow type="math_number" id="count-zero"><field name="NUM">0</field></shadow></value><next><block type="text_print" id="count-ready-print"><comment pinned="false" h="80" w="218">Print the entered message to the REPL console (at the bottom of the screen). </comment><value name="TEXT"><shadow type="text" id="count-ready-text"><field name="TEXT">The counter is ready.</field></shadow></value></block></next></block></next></block></next></block><block type="program_loop" id="count-loop" x="57" y="250"><comment pinned="false" h="70" w="320">In the endless loop, we continuously check for the button press and its subsequent release.</comment><statement name="DO"><block type="controls_if" id="count-new-press-if"><comment pinned="false" h="57" w="346">If the button is pressed (again), the input is at logic 0. </comment><value name="IF0"><block type="logic_compare" id="count-pin-is-low"><field name="OP">EQ</field><value name="A"><block type="gpio_get" id="count-read-pin-press"><value name="pin"><shadow type="math_number" id="count-read-pin-number"><field name="NUM">16</field></shadow></value></block></value><value name="B"><shadow type="math_number" id="count-low-value"><field name="NUM">0</field></shadow></value></block></value><statement name="DO0"><block type="math_change" id="count-increment"><field name="VAR" id="count-value">press_count</field><comment pinned="false" h="55" w="280">Add one confirmed press.</comment><value name="DELTA"><shadow type="math_number" id="count-plus-one"><field name="NUM">1</field></shadow></value><next><block type="text_print" id="count-print"><comment pinned="false" h="60" w="300">Print the current press count to the REPL console.</comment><value name="TEXT"><block type="text_join" id="count-print-join"><mutation items="2"></mutation><value name="ADD0"><shadow type="text" id="count-print-label"><field name="TEXT">Press count: </field></shadow></value><value name="ADD1"><block type="variables_get" id="count-print-value"><field name="VAR" id="count-value">press_count</field></block></value></block></value><next><block type="utime.delay" id="count-debounce-wait"><field name="SCALE">sleep_ms</field><comment pinned="false" h="70" w="310">Wait 20 ms for short electrical contact bounce to settle.</comment><value name="TIME"><shadow type="math_number" id="count-debounce-time"><field name="NUM">20</field></shadow></value><next><block type="controls_whileUntil" id="uLj-c$9MVU9c|fjy4tLK"><field name="MODE">WHILE</field><comment pinned="false" h="80" w="160">While the button is pressed, wait for it to be released</comment><value name="BOOL"><block type="logic_compare" id="count-pin-is-high"><field name="OP">EQ</field><value name="A"><block type="gpio_get" id="count-read-pin-release"><value name="pin"><shadow type="math_number" id="count-release-pin-number"><field name="NUM">16</field></shadow></value></block></value><value name="B"><shadow type="math_number" id="count-high-value"><field name="NUM">0</field></shadow></value></block></value><statement name="DO"><block type="utime.delay" id="mCg8y3E6~j.2o:putJs5"><field name="SCALE">sleep_ms</field><comment pinned="false" h="70" w="310">In the loop, check every millisecond whether the button is still pressed and wait for it to be released.</comment><value name="TIME"><shadow type="math_number" id="C/TMZ.%!PN:0ZT*U-`*D"><field name="NUM">1</field></shadow></value></block></statement><next><block type="utime.delay" id="count-loop-wait"><field name="SCALE">sleep_ms</field><comment pinned="false" h="70" w="305">Wait 20 ms for short electrical contact bounce to settle.</comment><value name="TIME"><shadow type="math_number" id="count-loop-time"><field name="NUM">20</field></shadow></value></block></next></block></next></block></next></block></next></block></statement></block></statement></block>
  <!--ESPIDE_EXTENSIONS_BEGIN-->
eyJ2ZXJzaW9uIjoxLCJwcm9jZXNzb3IiOiJTaW11bGF0b3IiLCJleHRlbnNpb25zIjpbXX0=
<!--ESPIDE_EXTENSIONS_END-->
</xml>