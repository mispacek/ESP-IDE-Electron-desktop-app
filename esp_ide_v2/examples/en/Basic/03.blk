<xml xmlns="https://developers.google.com/blockly/xml"><block type="program_start" id="count-start" x="60" y="50"><comment pinned="false" h="65" w="310">This part sets up the button. It runs only once when the board starts.</comment><next><block type="gpio_init_get" id="count-input-init"><field name="in_pin">Pin.PULL_UP</field><comment pinned="false" h="105" w="350">Connect the button between GPIO 16 and GND. The internal pull-up holds the input at logic 1; pressing the button produces logic 0.</comment><value name="pin"><shadow type="math_number" id="count-input-pin"><field name="NUM">16</field></shadow></value><next><block type="text_print" id="count-ready-print"><value name="TEXT"><shadow type="text" id="count-ready-text"><field name="TEXT">Electronic dice</field></shadow></value></block></next></block></next></block><block type="program_loop" id="count-loop" x="57" y="250"><comment pinned="false" h="70" w="320">The infinite loop continuously checks for a button press followed by its release.</comment><statement name="DO"><block type="controls_if" id="count-new-press-if"><comment pinned="false" h="100" w="350">The condition is true only for a new press: the input is at logic 0.</comment><value name="IF0"><block type="logic_compare" id="count-pin-is-low"><field name="OP">EQ</field><value name="A"><block type="gpio_get" id="count-read-pin-press"><value name="pin"><shadow type="math_number" id="count-read-pin-number"><field name="NUM">16</field></shadow></value></block></value><value name="B"><shadow type="math_number" id="count-low-value"><field name="NUM">0</field></shadow></value></block></value><statement name="DO0"><block type="text_print" id="count-print"><comment pinned="false" h="50" w="444">Prints a random number from 1 to 6 to the REPL console.</comment><value name="TEXT"><block type="text_join" id="q3~ezT?TW{Pwe:k^Hx!o" inline="true"><mutation items="2"></mutation><value name="ADD0"><block type="text" id="WD-yVv.nEN*J$M~lI6sL"><field name="TEXT">The dice rolled: </field></block></value><value name="ADD1"><block type="math_random_int" id="-F5^q4*CR[bN4;!II/$r"><comment pinned="false" h="47" w="459">Generates a random number within the specified range.</comment><value name="FROM"><shadow type="math_number" id="t^IqK,d]kQ?YixPxptaj"><field name="NUM">1</field></shadow></value><value name="TO"><shadow type="math_number" id="aB4M#X{wm?HWcv)nVliW"><field name="NUM">6</field></shadow></value></block></value></block></value><next><block type="utime.delay" id="count-debounce-wait"><field name="SCALE">sleep_ms</field><comment pinned="false" h="70" w="310">Wait 20 ms for short electrical contact bounce to settle.</comment><value name="TIME"><shadow type="math_number" id="count-debounce-time"><field name="NUM">20</field></shadow></value><next><block type="controls_whileUntil" id="uLj-c$9MVU9c|fjy4tLK"><field name="MODE">WHILE</field><comment pinned="false" h="80" w="160">If the button is pressed, wait for it to be released.</comment><value name="BOOL"><block type="logic_compare" id="count-pin-is-high"><field name="OP">EQ</field><value name="A"><block type="gpio_get" id="count-read-pin-release"><value name="pin"><shadow type="math_number" id="count-release-pin-number"><field name="NUM">16</field></shadow></value></block></value><value name="B"><shadow type="math_number" id="count-high-value"><field name="NUM">0</field></shadow></value></block></value><statement name="DO"><block type="utime.delay" id="mCg8y3E6~j.2o:putJs5"><field name="SCALE">sleep_ms</field><comment pinned="false" h="70" w="310">Check once per millisecond whether the button is still pressed and wait for its release.</comment><value name="TIME"><shadow type="math_number" id="C/TMZ.%!PN:0ZT*U-`*D"><field name="NUM">1</field></shadow></value></block></statement><next><block type="utime.delay" id="count-loop-wait"><field name="SCALE">sleep_ms</field><comment pinned="false" h="70" w="305">Wait 20 ms for short electrical contact bounce to settle.</comment><value name="TIME"><shadow type="math_number" id="count-loop-time"><field name="NUM">20</field></shadow></value></block></next></block></next></block></next></block></statement></block></statement></block>
