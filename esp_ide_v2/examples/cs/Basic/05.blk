<xml xmlns="https://developers.google.com/blockly/xml"><block type="program_start" id="traffic-start" x="50" y="50"><comment pinned="false" h="105" w="370">Zapojte červenou LED na GPIO 1, žlutou na GPIO 2 a zelenou na GPIO 3. Každá LED musí mít vlastní rezistor a druhý vývod připojený na GND.</comment><next><block type="gpio_set" id="x9iMkYl?%uvJ0e;nkE_k"><value name="pin"><shadow type="math_number" id="lxDGy5[.jj%$*F?SFMJ:"><field name="NUM">1</field></shadow></value><value name="value"><shadow type="math_number" id="~)!7pW.B=$}(~sueH(P/"><field name="NUM">0</field></shadow></value><next><block type="gpio_set" id="`w.IP@nk_3@K2OvK_f=~"><value name="pin"><shadow type="math_number" id="sWYyzdR.8$b3zXd~0JJg"><field name="NUM">2</field></shadow></value><value name="value"><shadow type="math_number" id=":Rl#Y5/zN-g%DR|WPvh~"><field name="NUM">0</field></shadow></value><next><block type="gpio_set" id="W/Z7@A(fX]qr7jD~+}Kh"><value name="pin"><shadow type="math_number" id="_XiB,$Ai)Zri:6v`)SCf"><field name="NUM">3</field></shadow></value><value name="value"><shadow type="math_number" id="rqqI3);7=tG;,+EVnfj8"><field name="NUM">0</field></shadow></value></block></next></block></next></block></next></block><block type="procedures_defnoreturn" id="traffic-procedure-red" x="440" y="50"><field name="NAME">stuj</field><comment pinned="false" h="75" w="330">Stav STŮJ: svítí pouze červená LED. Podprogram(funkce) vždy nastaví všechny tři výstupy.</comment><statement name="STACK"><block type="gpio_set" id="traffic-red-red-on"><value name="pin"><shadow type="math_number" id="traffic-red-red-pin"><field name="NUM">1</field></shadow></value><value name="value"><shadow type="math_number" id="traffic-red-red-value"><field name="NUM">1</field></shadow></value><next><block type="gpio_set" id="traffic-red-yellow-off"><value name="pin"><shadow type="math_number" id="traffic-red-yellow-pin"><field name="NUM">2</field></shadow></value><value name="value"><shadow type="math_number" id="traffic-red-yellow-value"><field name="NUM">0</field></shadow></value><next><block type="gpio_set" id="traffic-red-green-off"><value name="pin"><shadow type="math_number" id="traffic-red-green-pin"><field name="NUM">3</field></shadow></value><value name="value"><shadow type="math_number" id="traffic-red-green-value"><field name="NUM">0</field></shadow></value></block></next></block></next></block></statement></block><block type="procedures_defnoreturn" id="traffic-procedure-red-yellow" x="740" y="50"><field name="NAME">pripravit</field><comment pinned="false" h="75" w="340">Stav PŘIPRAV SE: svítí červená a žlutá LED, zelená je zhasnutá.</comment><statement name="STACK"><block type="gpio_set" id="traffic-red-yellow-red-on"><value name="pin"><shadow type="math_number" id="traffic-red-yellow-red-pin"><field name="NUM">1</field></shadow></value><value name="value"><shadow type="math_number" id="traffic-red-yellow-red-value"><field name="NUM">1</field></shadow></value><next><block type="gpio_set" id="traffic-red-yellow-yellow-on"><value name="pin"><shadow type="math_number" id="traffic-red-yellow-yellow-pin"><field name="NUM">2</field></shadow></value><value name="value"><shadow type="math_number" id="traffic-red-yellow-yellow-value"><field name="NUM">1</field></shadow></value><next><block type="gpio_set" id="traffic-red-yellow-green-off"><value name="pin"><shadow type="math_number" id="traffic-red-yellow-green-pin"><field name="NUM">3</field></shadow></value><value name="value"><shadow type="math_number" id="traffic-red-yellow-green-value"><field name="NUM">0</field></shadow></value></block></next></block></next></block></statement></block><block type="program_loop" id="traffic-loop" x="52" y="291"><comment pinned="false" h="85" w="350">Hlavní program pouze volá jednotlivé stavy semaforu. Nastavení LED je přehledně ukryté v podprogramech(funcích).</comment><statement name="DO"><block type="procedures_callnoreturn" id="traffic-call-red"><mutation name="stuj"></mutation><next><block type="utime.delay" id="traffic-red-wait"><field name="SCALE">sleep</field><value name="TIME"><shadow type="math_number" id="traffic-red-time"><field name="NUM">3</field></shadow></value><next><block type="procedures_callnoreturn" id="traffic-call-red-yellow"><mutation name="pripravit"></mutation><next><block type="utime.delay" id="traffic-red-yellow-wait"><field name="SCALE">sleep</field><value name="TIME"><shadow type="math_number" id="traffic-red-yellow-time"><field name="NUM">1</field></shadow></value><next><block type="procedures_callnoreturn" id="traffic-call-green"><mutation name="volno"></mutation><next><block type="utime.delay" id="traffic-green-wait"><field name="SCALE">sleep</field><value name="TIME"><shadow type="math_number" id="traffic-green-time"><field name="NUM">3</field></shadow></value><next><block type="procedures_callnoreturn" id="traffic-call-yellow"><mutation name="pozor"></mutation><next><block type="utime.delay" id="traffic-yellow-wait"><field name="SCALE">sleep</field><value name="TIME"><shadow type="math_number" id="traffic-yellow-time"><field name="NUM">1</field></shadow></value></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></statement></block><block type="procedures_defnoreturn" id="traffic-procedure-green" x="440" y="390"><field name="NAME">volno</field><comment pinned="false" h="75" w="330">Stav VOLNO: svítí pouze zelená LED. Červená a žlutá jsou zhasnuté.</comment><statement name="STACK"><block type="gpio_set" id="traffic-green-red-off"><value name="pin"><shadow type="math_number" id="traffic-green-red-pin"><field name="NUM">1</field></shadow></value><value name="value"><shadow type="math_number" id="traffic-green-red-value"><field name="NUM">0</field></shadow></value><next><block type="gpio_set" id="traffic-green-yellow-off"><value name="pin"><shadow type="math_number" id="traffic-green-yellow-pin"><field name="NUM">2</field></shadow></value><value name="value"><shadow type="math_number" id="traffic-green-yellow-value"><field name="NUM">0</field></shadow></value><next><block type="gpio_set" id="traffic-green-green-on"><value name="pin"><shadow type="math_number" id="traffic-green-green-pin"><field name="NUM">3</field></shadow></value><value name="value"><shadow type="math_number" id="traffic-green-green-value"><field name="NUM">1</field></shadow></value></block></next></block></next></block></statement></block><block type="procedures_defnoreturn" id="traffic-procedure-yellow" x="740" y="390"><field name="NAME">pozor</field><comment pinned="false" h="75" w="330">Stav POZOR: svítí pouze žlutá LED. Červená a zelená jsou zhasnuté.</comment><statement name="STACK"><block type="gpio_set" id="traffic-yellow-red-off"><value name="pin"><shadow type="math_number" id="traffic-yellow-red-pin"><field name="NUM">1</field></shadow></value><value name="value"><shadow type="math_number" id="traffic-yellow-red-value"><field name="NUM">0</field></shadow></value><next><block type="gpio_set" id="traffic-yellow-yellow-on"><value name="pin"><shadow type="math_number" id="traffic-yellow-yellow-pin"><field name="NUM">2</field></shadow></value><value name="value"><shadow type="math_number" id="traffic-yellow-yellow-value"><field name="NUM">1</field></shadow></value><next><block type="gpio_set" id="traffic-yellow-green-off"><value name="pin"><shadow type="math_number" id="traffic-yellow-green-pin"><field name="NUM">3</field></shadow></value><value name="value"><shadow type="math_number" id="traffic-yellow-green-value"><field name="NUM">0</field></shadow></value></block></next></block></next></block></statement></block>
