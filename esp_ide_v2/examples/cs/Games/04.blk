<xml xmlns="https://developers.google.com/blockly/xml"><variables><variable id="v_joy_x">joy_x</variable><variable id="v_paddle_speed">paddle_speed</variable><variable id="v_paddle_x">paddle_x</variable><variable id="v_ball_x">ball_x</variable><variable id="v_ball_y">ball_y</variable><variable id="v_ball_dx">ball_dx</variable><variable id="v_ball_dy">ball_dy</variable><variable id="v_bricks">bricks</variable><variable id="v_score">score</variable><variable id="v_lives">lives</variable><variable id="v_row">row</variable><variable id="v_col">col</variable><variable id="v_idx">idx</variable></variables><block type="program_start" id="arkanoid_start" x="-74" y="59"><comment pinned="false" h="110" w="520">Hlavní start programu. Zde se jednorázově připraví displej, joystick a všechny proměnné hry. Samotná hra potom běží v bloku PROGRAM LOOP.</comment><next><block type="oled_init" id="arkanoid_oled_init"><mutation xmlns="http://www.w3.org/1999/xhtml" display_type="AUTO"></mutation><field name="DISPLAY_TYPE">AUTO</field><comment pinned="false" h="110" w="520">Inicializace OLED displeje 128×64. Režim AUTO ponechá ESP IDE výběr podporovaného OLED ovladače; piny SDA=21 a SCL=22 jsou převzaté z výchozího projektu a lze je změnit podle desky.</comment><value name="SDA_PIN"><shadow type="math_number" id="n0001"><field name="NUM">21</field></shadow></value><value name="SCL_PIN"><shadow type="math_number" id="n0002"><field name="NUM">22</field></shadow></value><next><block type="joystick_init" id="arkanoid_joystick_init"><field name="joy_name">1</field><field name="rot">270</field><comment pinned="false" h="110" w="520">Inicializace joysticku č. 1. Pro Arkanoid používáme pouze osu X; hodnota je přibližně -100 vlevo, 0 uprostřed a +100 vpravo.</comment><value name="vrx"><shadow type="math_number" id="n0003"><field name="NUM">13</field></shadow></value><value name="vry"><shadow type="math_number" id="n0004"><field name="NUM">14</field></shadow></value><value name="sw"><shadow type="math_number" id="n0005"><field name="NUM">15</field></shadow></value><next><block type="variables_set" id="b0007"><field name="VAR" id="v_joy_x">joy_x</field><comment pinned="false" h="110" w="520">Výchozí hodnota osy joysticku. Nula odpovídá středové poloze a zabrání použití nedefinované hodnoty před prvním čtením joysticku.</comment><value name="VALUE"><shadow type="math_number" id="n0006"><field name="NUM">0</field></shadow></value><next><block type="variables_set" id="b0009"><field name="VAR" id="v_paddle_x">paddle_x</field><comment pinned="false" h="110" w="520">Počáteční X souřadnice pálky. Šířka pálky je 20 px, takže hodnota 54 ji umístí přibližně doprostřed 128px displeje.</comment><value name="VALUE"><shadow type="math_number" id="n0008"><field name="NUM">54</field></shadow></value><next><block type="variables_set" id="b0011"><field name="VAR" id="v_ball_x">ball_x</field><comment pinned="false" h="110" w="520">Počáteční X souřadnice míčku. Míček má šířku 4 px a startuje přibližně uprostřed displeje.</comment><value name="VALUE"><shadow type="math_number" id="n0010"><field name="NUM">62</field></shadow></value><next><block type="variables_set" id="b0013"><field name="VAR" id="v_ball_y">ball_y</field><comment pinned="false" h="110" w="520">Počáteční Y souřadnice míčku. Hodnota 48 umístí míček nad pálku a pod pole kostek.</comment><value name="VALUE"><shadow type="math_number" id="n0012"><field name="NUM">48</field></shadow></value><next><block type="variables_set" id="b0015"><field name="VAR" id="v_ball_dx">ball_dx</field><comment pinned="false" h="110" w="520">Horizontální rychlost míčku. Hodnota +2 znamená pohyb o 2 pixely doprava v každém průchodu hlavní smyčkou.</comment><value name="VALUE"><shadow type="math_number" id="n0014"><field name="NUM">2</field></shadow></value><next><block type="variables_set" id="b0017"><field name="VAR" id="v_ball_dy">ball_dy</field><comment pinned="false" h="110" w="520">Vertikální rychlost míčku. Hodnota -2 znamená pohyb o 2 pixely nahoru v každém průchodu smyčkou. Znaménko určuje směr.</comment><value name="VALUE"><shadow type="math_number" id="n0016"><field name="NUM">-2</field></shadow></value><next><block type="variables_set" id="b0021"><field name="VAR" id="v_bricks">bricks</field><comment pinned="false" h="110" w="520">Vytvoří pole stavů všech 24 kostek. Každá položka má na začátku hodnotu 1 = kostka existuje; po zásahu se změní na 0.</comment><value name="VALUE"><block type="lists_repeat" id="b0020"><comment pinned="false" h="110" w="520">Opakuje hodnotu 1 celkem 24×, protože hrací pole má 3 řádky × 8 sloupců = 24 kostek.</comment><value name="ITEM"><shadow type="math_number" id="n0018"><field name="NUM">1</field></shadow></value><value name="NUM"><shadow type="math_number" id="n0019"><field name="NUM">24</field></shadow></value></block></value><next><block type="variables_set" id="b0023"><field name="VAR" id="v_score">score</field><comment pinned="false" h="110" w="520">Počáteční skóre hráče. Za každou zničenou kostku se přičte jeden bod; maximální skóre jednoho kola je 24.</comment><value name="VALUE"><shadow type="math_number" id="n0022"><field name="NUM">0</field></shadow></value><next><block type="variables_set" id="b0025"><field name="VAR" id="v_lives">lives</field><comment pinned="false" h="110" w="520">Počet životů na začátku hry. Když míček spadne pod spodní okraj displeje, odečte se jeden život.</comment><value name="VALUE"><shadow type="math_number" id="n0024"><field name="NUM">3</field></shadow></value><next><block type="variables_set" id="b0027"><field name="VAR" id="v_row">row</field><comment pinned="false" h="110" w="520">Pomocná proměnná row. Používá se pro výpočet řádku zasažené kostky a také při vykreslování všech řádků.</comment><value name="VALUE"><shadow type="math_number" id="n0026"><field name="NUM">0</field></shadow></value><next><block type="variables_set" id="b0029"><field name="VAR" id="v_col">col</field><comment pinned="false" h="110" w="520">Pomocná proměnná col. Používá se pro výpočet sloupce zasažené kostky a také při vykreslování všech sloupců.</comment><value name="VALUE"><shadow type="math_number" id="n0028"><field name="NUM">0</field></shadow></value><next><block type="variables_set" id="b0031"><field name="VAR" id="v_idx">idx</field><comment pinned="false" h="110" w="520">Pomocná proměnná idx. Převádí dvojici row/col na jediný index v jednorozměrném poli bricks.</comment><value name="VALUE"><shadow type="math_number" id="n0030"><field name="NUM">0</field></shadow></value></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block><block type="program_loop" id="arkanoid_loop" x="690" y="50"><comment pinned="false" h="110" w="520">Hlavní herní smyčka. Nejprve načte joystick a z jeho výchylky vypočítá relativní rychlost pálky. Pálka se posune o vypočtený počet pixelů a její poloha se omezí na displej. Potom se posune míček, vyřeší kolize a stav hry a nakonec se sestaví nový framebuffer. Míček se kreslí před neprůhlednou pálkou.</comment><statement name="DO"><block type="variables_set" id="b0033"><field name="VAR" id="v_joy_x">joy_x</field><comment pinned="false" h="110" w="520">Načte aktuální výchylku osy X joysticku do proměnné joy_x. Hodnota už neurčuje absolutní polohu pálky; v dalších blocích z ní vypočítáme směr a rychlost relativního pohybu.</comment><value name="VALUE"><block type="get_joy_axis_ble" id="b0032"><field name="joy_name">1</field><field name="axis">X</field><comment pinned="false" h="110" w="520">Čtení osy X joysticku č. 1. ESP IDE vrací přibližný rozsah -100 až +100. Čím větší je absolutní výchylka od nuly, tím rychleji se bude pálka pohybovat.</comment></block></value><next><block type="variables_set" id="b_rel_speed_set"><field name="VAR" id="v_paddle_speed">paddle_speed</field><comment pinned="false" h="110" w="520">Převede výchylku joysticku na rychlost pálky. Při dělení 20 vychází přibližně -5 až +5 px za průchod smyčkou. Menší dělitel znamená rychlejší/citlivější pálku, větší dělitel pomalejší pohyb.</comment><value name="VALUE"><block type="math_round" id="b_rel_speed_round"><field name="OP">ROUND</field><comment pinned="false" h="110" w="520">Zaokrouhlí vypočtenou rychlost na celé pixely. Díky běžnému zaokrouhlení je řízení symetrické pro pohyb vlevo i vpravo.</comment><value name="NUM"><block type="math_arithmetic" id="b_rel_speed_div"><field name="OP">DIVIDE</field><comment pinned="false" h="110" w="520">Dělí výchylku joysticku číslem 20. Například +100 → +5 px, +40 → +2 px, -60 → -3 px za jeden průchod smyčkou.</comment><value name="A"><block type="variables_get" id="b_rel_joy_speed"><field name="VAR" id="v_joy_x">joy_x</field></block></value><value name="B"><shadow type="math_number" id="n_rel_speed_divisor"><field name="NUM">25</field></shadow></value></block></value></block></value><next><block type="variables_set" id="b_rel_paddle_set"><field name="VAR" id="v_paddle_x">paddle_x</field><comment pinned="false" h="110" w="520">Relativně posune pálku: k její dosavadní poloze paddle_x přičte paddle_speed. Joystick tedy neurčuje místo na displeji, ale rychlost a směr pohybu.</comment><value name="VALUE"><block type="math_constrain" id="b_rel_paddle_constrain"><comment pinned="false" h="110" w="520">Omezí novou polohu pálky na 0…108. Pálka je široká 20 px, takže při X=108 končí přesně na pravém okraji 128px displeje.</comment><value name="VALUE"><block type="math_arithmetic" id="b_rel_paddle_add"><field name="OP">ADD</field><comment pinned="false" h="110" w="520">Sečte současnou polohu pálky a rychlost vypočtenou z joysticku. Kladná rychlost posouvá doprava, záporná doleva.</comment><value name="A"><block type="variables_get" id="b_rel_paddle_old"><field name="VAR" id="v_paddle_x">paddle_x</field></block></value><value name="B"><block type="variables_get" id="b_rel_speed_get"><field name="VAR" id="v_paddle_speed">paddle_speed</field></block></value></block></value><value name="LOW"><shadow type="math_number" id="n_rel_paddle_low"><field name="NUM">0</field></shadow></value><value name="HIGH"><shadow type="math_number" id="n_rel_paddle_high"><field name="NUM">108</field></shadow></value></block></value><next><block type="variables_set" id="b0049"><field name="VAR" id="v_ball_x">ball_x</field><comment pinned="false" h="110" w="520">Aktualizuje horizontální polohu míčku: ball_x = ball_x + ball_dx. Při rychlosti ±2 se míček posune o dva pixely za snímek.</comment><value name="VALUE"><block type="math_arithmetic" id="b0048"><field name="OP">ADD</field><comment pinned="false" h="110" w="520">Součet aktuální X souřadnice míčku a horizontální rychlosti ball_dx.</comment><value name="A"><block type="variables_get" id="b0046"><field name="VAR" id="v_ball_x">ball_x</field></block></value><value name="B"><block type="variables_get" id="b0047"><field name="VAR" id="v_ball_dx">ball_dx</field></block></value></block></value><next><block type="variables_set" id="b0053"><field name="VAR" id="v_ball_y">ball_y</field><comment pinned="false" h="110" w="520">Aktualizuje vertikální polohu míčku: ball_y = ball_y + ball_dy.</comment><value name="VALUE"><block type="math_arithmetic" id="b0052"><field name="OP">ADD</field><comment pinned="false" h="110" w="520">Součet aktuální Y souřadnice míčku a vertikální rychlosti ball_dy.</comment><value name="A"><block type="variables_get" id="b0050"><field name="VAR" id="v_ball_y">ball_y</field></block></value><value name="B"><block type="variables_get" id="b0051"><field name="VAR" id="v_ball_dy">ball_dy</field></block></value></block></value><next><block type="controls_if" id="b0061"><comment pinned="false" h="110" w="520">Kolize s levou stěnou. Jakmile levý okraj míčku dojede za X=0, vrátíme ho na X=0 a změníme směr pohybu doprava.</comment><value name="IF0"><block type="logic_compare" id="b0060"><field name="OP">LT</field><value name="A"><block type="variables_get" id="b0058"><field name="VAR" id="v_ball_x">ball_x</field></block></value><value name="B"><shadow type="math_number" id="n0059"><field name="NUM">1</field></shadow></value></block></value><statement name="DO0"><block type="variables_set" id="b0055"><field name="VAR" id="v_ball_x">ball_x</field><comment pinned="false" h="110" w="520">Po zásahu levé stěny zarovná míček přesně na X=0, aby nezůstal mimo framebuffer.</comment><value name="VALUE"><shadow type="math_number" id="n0054"><field name="NUM">0</field></shadow></value><next><block type="variables_set" id="b0057"><field name="VAR" id="v_ball_dx">ball_dx</field><comment pinned="false" h="110" w="520">Po zásahu levé stěny nastaví horizontální rychlost na +2, tedy pohyb doprava.</comment><value name="VALUE"><shadow type="math_number" id="n0056"><field name="NUM">2</field></shadow></value></block></next></block></statement><next><block type="controls_if" id="b0069"><comment pinned="false" h="110" w="520">Kolize s pravou stěnou. Hodnota 123 odpovídá poslední bezpečné X pozici čtyřpixelového míčku na 128px displeji.</comment><value name="IF0"><block type="logic_compare" id="b0068"><field name="OP">GT</field><value name="A"><block type="variables_get" id="b0066"><field name="VAR" id="v_ball_x">ball_x</field></block></value><value name="B"><shadow type="math_number" id="n0067"><field name="NUM">123</field></shadow></value></block></value><statement name="DO0"><block type="variables_set" id="b0063"><field name="VAR" id="v_ball_x">ball_x</field><comment pinned="false" h="110" w="520">Po zásahu pravé stěny zarovná levý okraj míčku na X=123.</comment><value name="VALUE"><shadow type="math_number" id="n0062"><field name="NUM">123</field></shadow></value><next><block type="variables_set" id="b0065"><field name="VAR" id="v_ball_dx">ball_dx</field><comment pinned="false" h="110" w="520">Po zásahu pravé stěny nastaví horizontální rychlost na -2, tedy pohyb doleva.</comment><value name="VALUE"><shadow type="math_number" id="n0064"><field name="NUM">-2</field></shadow></value></block></next></block></statement><next><block type="controls_if" id="b0077"><comment pinned="false" h="110" w="520">Kolize s horním okrajem displeje. Při dosažení horní stěny se vertikální směr změní směrem dolů.</comment><value name="IF0"><block type="logic_compare" id="b0076"><field name="OP">LT</field><value name="A"><block type="variables_get" id="b0074"><field name="VAR" id="v_ball_y">ball_y</field></block></value><value name="B"><shadow type="math_number" id="n0075"><field name="NUM">1</field></shadow></value></block></value><statement name="DO0"><block type="variables_set" id="b0071"><field name="VAR" id="v_ball_y">ball_y</field><comment pinned="false" h="110" w="520">Zarovná míček na horní okraj Y=0, aby nezůstal částečně mimo framebuffer.</comment><value name="VALUE"><shadow type="math_number" id="n0070"><field name="NUM">0</field></shadow></value><next><block type="variables_set" id="b0073"><field name="VAR" id="v_ball_dy">ball_dy</field><comment pinned="false" h="110" w="520">Po zásahu horní stěny nastaví vertikální rychlost na +2, tedy pohyb dolů.</comment><value name="VALUE"><shadow type="math_number" id="n0072"><field name="NUM">2</field></shadow></value></block></next></block></statement><next><block type="controls_if" id="b0105"><comment pinned="false" h="110" w="520">První část testu kolize s pálkou: míček už musí být dostatečně nízko, tedy ball_y &gt; 54.</comment><value name="IF0"><block type="logic_compare" id="b0104"><field name="OP">GT</field><value name="A"><block type="variables_get" id="b0102"><field name="VAR" id="v_ball_y">ball_y</field></block></value><value name="B"><shadow type="math_number" id="n0103"><field name="NUM">54</field></shadow></value></block></value><statement name="DO0"><block type="controls_if" id="b0101"><comment pinned="false" h="110" w="520">Druhá část testu: míček ještě nesmí být pod pálkou. Rozmezí Y 55…59 vytváří dostatečně širokou kolizní oblast i při rychlosti 2 px/snímek.</comment><value name="IF0"><block type="logic_compare" id="b0100"><field name="OP">LT</field><value name="A"><block type="variables_get" id="b0098"><field name="VAR" id="v_ball_y">ball_y</field></block></value><value name="B"><shadow type="math_number" id="n0099"><field name="NUM">60</field></shadow></value></block></value><statement name="DO0"><block type="controls_if" id="b0097"><comment pinned="false" h="110" w="520">Test levé hrany pálky. Ball_x musí být více než paddle_x - 4, protože míček má šířku 4 px a může se pálky dotknout svým pravým okrajem.</comment><value name="IF0"><block type="logic_compare" id="b0096"><field name="OP">GT</field><value name="A"><block type="variables_get" id="b0092"><field name="VAR" id="v_ball_x">ball_x</field></block></value><value name="B"><block type="math_arithmetic" id="b0095"><field name="OP">MINUS</field><value name="A"><block type="variables_get" id="b0093"><field name="VAR" id="v_paddle_x">paddle_x</field></block></value><value name="B"><shadow type="math_number" id="n0094"><field name="NUM">4</field></shadow></value></block></value></block></value><statement name="DO0"><block type="controls_if" id="b0091"><comment pinned="false" h="110" w="520">Test pravé hrany pálky. Ball_x musí být menší než paddle_x + 20, tedy než pravý okraj pálky.</comment><value name="IF0"><block type="logic_compare" id="b0090"><field name="OP">LT</field><value name="A"><block type="variables_get" id="b0086"><field name="VAR" id="v_ball_x">ball_x</field></block></value><value name="B"><block type="math_arithmetic" id="b0089"><field name="OP">ADD</field><value name="A"><block type="variables_get" id="b0087"><field name="VAR" id="v_paddle_x">paddle_x</field></block></value><value name="B"><shadow type="math_number" id="n0088"><field name="NUM">20</field></shadow></value></block></value></block></value><statement name="DO0"><block type="controls_if" id="b0085"><comment pinned="false" h="110" w="520">Kolizi s pálkou řešíme jen tehdy, když míček skutečně letí dolů (ball_dy &gt; 0). Tím zabráníme opakovanému odrážení míčku uvnitř pálky.</comment><value name="IF0"><block type="logic_compare" id="b0084"><field name="OP">GT</field><value name="A"><block type="variables_get" id="b0082"><field name="VAR" id="v_ball_dy">ball_dy</field></block></value><value name="B"><shadow type="math_number" id="n0083"><field name="NUM">0</field></shadow></value></block></value><statement name="DO0"><block type="variables_set" id="b0079"><field name="VAR" id="v_ball_y">ball_y</field><comment pinned="false" h="110" w="520">Po zásahu pálky posune míček na Y=55, tedy nad její vykreslenou oblast. To pomáhá zabránit zachycení míčku v pálce.</comment><value name="VALUE"><shadow type="math_number" id="n0078"><field name="NUM">55</field></shadow></value><next><block type="variables_set" id="b0081"><field name="VAR" id="v_ball_dy">ball_dy</field><comment pinned="false" h="110" w="520">Odraz od pálky: vertikální rychlost se nastaví na -2, takže míček začne letět nahoru.</comment><value name="VALUE"><shadow type="math_number" id="n0080"><field name="NUM">-2</field></shadow></value></block></next></block></statement></block></statement></block></statement></block></statement></block></statement><next><block type="controls_if" id="b0153"><comment pinned="false" h="110" w="520">Kolizi s kostkami kontrolujeme až od Y&gt;5. Horní prázdný okraj displeje tak není omylem považován za první řádek kostek.</comment><value name="IF0"><block type="logic_compare" id="b0152"><field name="OP">GT</field><value name="A"><block type="variables_get" id="b0150"><field name="VAR" id="v_ball_y">ball_y</field></block></value><value name="B"><shadow type="math_number" id="n0151"><field name="NUM">5</field></shadow></value></block></value><statement name="DO0"><block type="controls_if" id="b0149"><comment pinned="false" h="110" w="520">Horní herní pole s kostkami končí před Y=24. Jen v tomto pásmu převádíme souřadnice míčku na row/col a hledáme zasaženou kostku.</comment><value name="IF0"><block type="logic_compare" id="b0148"><field name="OP">LT</field><value name="A"><block type="variables_get" id="b0146"><field name="VAR" id="v_ball_y">ball_y</field></block></value><value name="B"><shadow type="math_number" id="n0147"><field name="NUM">24</field></shadow></value></block></value><statement name="DO0"><block type="variables_set" id="b0110"><field name="VAR" id="v_col">col</field><comment pinned="false" h="110" w="520">Vypočítá sloupec kostky: floor(ball_x / 16). Každý z 8 sloupců zabírá vodorovně 16 px.</comment><value name="VALUE"><block type="math_round" id="b0109"><field name="OP">ROUNDDOWN</field><comment pinned="false" h="110" w="520">Zaokrouhlením dolů získáme celé číslo sloupce 0…7.</comment><value name="NUM"><block type="math_arithmetic" id="b0108"><field name="OP">DIVIDE</field><comment pinned="false" h="110" w="520">Dělí X souřadnici míčku šířkou jednoho sloupce 16 px.</comment><value name="A"><block type="variables_get" id="b0106"><field name="VAR" id="v_ball_x">ball_x</field></block></value><value name="B"><shadow type="math_number" id="n0107"><field name="NUM">16</field></shadow></value></block></value></block></value><next><block type="variables_set" id="b0117"><field name="VAR" id="v_row">row</field><comment pinned="false" h="110" w="520">Vypočítá řádek kostky: floor((ball_y - 6) / 6). První řádek začíná na Y=6 a jednotlivé řádky mají krok 6 px.</comment><value name="VALUE"><block type="math_round" id="b0116"><field name="OP">ROUNDDOWN</field><comment pinned="false" h="110" w="520">Zaokrouhlením dolů získáme číslo řádku 0…2.</comment><value name="NUM"><block type="math_arithmetic" id="b0115"><field name="OP">DIVIDE</field><comment pinned="false" h="110" w="520">Vydělí relativní Y souřadnici výškou/krokem řádku 6 px.</comment><value name="A"><block type="math_arithmetic" id="b0113"><field name="OP">MINUS</field><comment pinned="false" h="110" w="520">Odečte horní odsazení 6 px, takže začátek prvního řádku kostek odpovídá nule.</comment><value name="A"><block type="variables_get" id="b0111"><field name="VAR" id="v_ball_y">ball_y</field></block></value><value name="B"><shadow type="math_number" id="n0112"><field name="NUM">6</field></shadow></value></block></value><value name="B"><shadow type="math_number" id="n0114"><field name="NUM">6</field></shadow></value></block></value></block></value><next><block type="variables_set" id="b0123"><field name="VAR" id="v_idx">idx</field><comment pinned="false" h="110" w="520">Převede row/col na lineární index: idx = row × 8 + col. Tím lze jednu kostku najít v jednorozměrném poli bricks.</comment><value name="VALUE"><block type="math_arithmetic" id="b0122"><field name="OP">ADD</field><comment pinned="false" h="110" w="520">Přičtením col vznikne index konkrétní kostky v rozsahu 0…23.</comment><value name="A"><block type="math_arithmetic" id="b0120"><field name="OP">MULTIPLY</field><comment pinned="false" h="110" w="520">Každý dokončený řádek obsahuje 8 kostek, proto row násobíme osmi.</comment><value name="A"><block type="variables_get" id="b0118"><field name="VAR" id="v_row">row</field></block></value><value name="B"><shadow type="math_number" id="n0119"><field name="NUM">8</field></shadow></value></block></value><value name="B"><block type="variables_get" id="b0121"><field name="VAR" id="v_col">col</field></block></value></block></value><next><block type="controls_if" id="b0145"><comment pinned="false" h="110" w="520">Ověří, zda na vypočtené pozici ještě kostka existuje. Hodnota 1 znamená aktivní kostku; hodnota 0 už zničenou.</comment><value name="IF0"><block type="logic_compare" id="b0130"><field name="OP">EQ</field><value name="A"><block type="lists_getIndex" id="b0127"><mutation statement="false" at="true"></mutation><field name="MODE">GET</field><field name="WHERE">FROM_START</field><comment pinned="false" h="110" w="520">Čte stav kostky z pole bricks. Blockly zde používá pozici od začátku pole; proto se k internímu idx 0…23 přičítá 1.</comment><value name="VALUE"><block type="variables_get" id="b0128"><field name="VAR" id="v_bricks">bricks</field></block></value><value name="AT"><block type="math_arithmetic" id="b0126"><field name="OP">ADD</field><comment pinned="false" h="110" w="520">Převod interního indexu 0…23 na jedničkovou pozici 1…24 používanou tímto Blockly blokem seznamu.</comment><value name="A"><block type="variables_get" id="b0124"><field name="VAR" id="v_idx">idx</field></block></value><value name="B"><shadow type="math_number" id="n0125"><field name="NUM">1</field></shadow></value></block></value></block></value><value name="B"><shadow type="math_number" id="n0129"><field name="NUM">1</field></shadow></value></block></value><statement name="DO0"><block type="lists_setIndex" id="b0135"><mutation at="true"></mutation><field name="MODE">SET</field><field name="WHERE">FROM_START</field><comment pinned="false" h="110" w="520">Po zásahu nastaví stav konkrétní kostky v poli bricks na 0. Při dalších snímcích se tato kostka už nekreslí ani nekoliduje.</comment><value name="LIST"><block type="variables_get" id="b0136"><field name="VAR" id="v_bricks">bricks</field></block></value><value name="AT"><block type="math_arithmetic" id="b0133"><field name="OP">ADD</field><comment pinned="false" h="110" w="520">Stejně jako při čtení převádí idx 0…23 na jedničkovou pozici v Blockly seznamu.</comment><value name="A"><block type="variables_get" id="b0131"><field name="VAR" id="v_idx">idx</field></block></value><value name="B"><shadow type="math_number" id="n0132"><field name="NUM">1</field></shadow></value></block></value><value name="TO"><shadow type="math_number" id="n0134"><field name="NUM">0</field></shadow></value><next><block type="variables_set" id="b0140"><field name="VAR" id="v_ball_dy">ball_dy</field><comment pinned="false" h="110" w="520">Obrátí vertikální rychlost míčku pomocí 0 - ball_dy. Díky tomu se zachová velikost rychlosti 2 px a změní se pouze směr.</comment><value name="VALUE"><block type="math_arithmetic" id="b0139"><field name="OP">MINUS</field><comment pinned="false" h="110" w="520">Matematický zápis změny znaménka: 0 - ball_dy. Pro +2 vznikne -2 a pro -2 vznikne +2.</comment><value name="A"><shadow type="math_number" id="n0137"><field name="NUM">0</field></shadow></value><value name="B"><block type="variables_get" id="b0138"><field name="VAR" id="v_ball_dy">ball_dy</field></block></value></block></value><next><block type="variables_set" id="b0144"><field name="VAR" id="v_score">score</field><comment pinned="false" h="110" w="520">Za zničenou kostku zvýší skóre o 1.</comment><value name="VALUE"><block type="math_arithmetic" id="b0143"><field name="OP">ADD</field><comment pinned="false" h="110" w="520">Výpočet nového skóre: score + 1.</comment><value name="A"><block type="variables_get" id="b0141"><field name="VAR" id="v_score">score</field></block></value><value name="B"><shadow type="math_number" id="n0142"><field name="NUM">1</field></shadow></value></block></value></block></next></block></next></block></statement></block></next></block></next></block></next></block></statement></block></statement><next><block type="controls_if" id="b0173"><comment pinned="false" h="110" w="520">Kontrola vítězství. Jakmile score &gt; 23, bylo zničeno všech 24 kostek a připraví se nové kolo.</comment><value name="IF0"><block type="logic_compare" id="b0172"><field name="OP">GT</field><value name="A"><block type="variables_get" id="b0170"><field name="VAR" id="v_score">score</field></block></value><value name="B"><shadow type="math_number" id="n0171"><field name="NUM">23</field></shadow></value></block></value><statement name="DO0"><block type="variables_set" id="b0157"><field name="VAR" id="v_bricks">bricks</field><comment pinned="false" h="110" w="520">Při vítězství vytvoří nové pole 24 aktivních kostek, takže začne další kompletní herní plocha.</comment><value name="VALUE"><block type="lists_repeat" id="b0156"><comment pinned="false" h="110" w="520">Vytvoří 24 jedniček pro reset všech kostek po vítězství.</comment><value name="ITEM"><shadow type="math_number" id="n0154"><field name="NUM">1</field></shadow></value><value name="NUM"><shadow type="math_number" id="n0155"><field name="NUM">24</field></shadow></value></block></value><next><block type="variables_set" id="b0159"><field name="VAR" id="v_score">score</field><comment pinned="false" h="110" w="520">Po vítězství vynuluje skóre pro nové kolo.</comment><value name="VALUE"><shadow type="math_number" id="n0158"><field name="NUM">0</field></shadow></value><next><block type="variables_set" id="b0161"><field name="VAR" id="v_lives">lives</field><comment pinned="false" h="110" w="520">Po vítězství obnoví hráči tři životy.</comment><value name="VALUE"><shadow type="math_number" id="n0160"><field name="NUM">3</field></shadow></value><next><block type="variables_set" id="b0163"><field name="VAR" id="v_ball_x">ball_x</field><comment pinned="false" h="110" w="520">Po vítězství vrátí míček doprostřed na výchozí X souřadnici.</comment><value name="VALUE"><shadow type="math_number" id="n0162"><field name="NUM">62</field></shadow></value><next><block type="variables_set" id="b0165"><field name="VAR" id="v_ball_y">ball_y</field><comment pinned="false" h="110" w="520">Po vítězství vrátí míček na výchozí Y souřadnici nad pálkou.</comment><value name="VALUE"><shadow type="math_number" id="n0164"><field name="NUM">48</field></shadow></value><next><block type="variables_set" id="b0167"><field name="VAR" id="v_ball_dx">ball_dx</field><comment pinned="false" h="110" w="520">Po vítězství nastaví horizontální rychlost na +2.</comment><value name="VALUE"><shadow type="math_number" id="n0166"><field name="NUM">2</field></shadow></value><next><block type="variables_set" id="b0169"><field name="VAR" id="v_ball_dy">ball_dy</field><comment pinned="false" h="110" w="520">Po vítězství nastaví vertikální rychlost na -2, takže nové kolo začne pohybem vzhůru.</comment><value name="VALUE"><shadow type="math_number" id="n0168"><field name="NUM">-2</field></shadow></value></block></next></block></next></block></next></block></next></block></next></block></next></block></statement><next><block type="controls_if" id="b0201"><comment pinned="false" h="110" w="520">Detekce ztraceného míčku. Pokud ball_y &gt; 63, míček už opustil spodní okraj 64px displeje a hráč ztrácí život.</comment><value name="IF0"><block type="logic_compare" id="b0200"><field name="OP">GT</field><value name="A"><block type="variables_get" id="b0198"><field name="VAR" id="v_ball_y">ball_y</field></block></value><value name="B"><shadow type="math_number" id="n0199"><field name="NUM">63</field></shadow></value></block></value><statement name="DO0"><block type="variables_set" id="b0177"><field name="VAR" id="v_lives">lives</field><comment pinned="false" h="110" w="520">Odečte jeden život: lives = lives - 1.</comment><value name="VALUE"><block type="math_arithmetic" id="b0176"><field name="OP">MINUS</field><comment pinned="false" h="110" w="520">Výpočet nového počtu životů po ztraceném míčku.</comment><value name="A"><block type="variables_get" id="b0174"><field name="VAR" id="v_lives">lives</field></block></value><value name="B"><shadow type="math_number" id="n0175"><field name="NUM">1</field></shadow></value></block></value><next><block type="variables_set" id="b0179"><field name="VAR" id="v_ball_x">ball_x</field><comment pinned="false" h="110" w="520">Po ztrátě života vrátí míček na výchozí X pozici.</comment><value name="VALUE"><shadow type="math_number" id="n0178"><field name="NUM">62</field></shadow></value><next><block type="variables_set" id="b0181"><field name="VAR" id="v_ball_y">ball_y</field><comment pinned="false" h="110" w="520">Po ztrátě života vrátí míček na výchozí Y pozici.</comment><value name="VALUE"><shadow type="math_number" id="n0180"><field name="NUM">48</field></shadow></value><next><block type="variables_set" id="b0183"><field name="VAR" id="v_ball_dx">ball_dx</field><comment pinned="false" h="110" w="520">Po ztrátě života nastaví horizontální rychlost znovu na +2.</comment><value name="VALUE"><shadow type="math_number" id="n0182"><field name="NUM">2</field></shadow></value><next><block type="variables_set" id="b0185"><field name="VAR" id="v_ball_dy">ball_dy</field><comment pinned="false" h="110" w="520">Po ztrátě života nastaví vertikální rychlost na -2, takže nový míček vyletí nahoru.</comment><value name="VALUE"><shadow type="math_number" id="n0184"><field name="NUM">-2</field></shadow></value><next><block type="controls_if" id="b0197"><comment pinned="false" h="110" w="520">Kontrola GAME OVER. Když po odečtení klesne lives pod 1, hra se kompletně restartuje.</comment><value name="IF0"><block type="logic_compare" id="b0196"><field name="OP">LT</field><value name="A"><block type="variables_get" id="b0194"><field name="VAR" id="v_lives">lives</field></block></value><value name="B"><shadow type="math_number" id="n0195"><field name="NUM">1</field></shadow></value></block></value><statement name="DO0"><block type="variables_set" id="b0187"><field name="VAR" id="v_lives">lives</field><comment pinned="false" h="110" w="520">Při GAME OVER obnoví počet životů na 3.</comment><value name="VALUE"><shadow type="math_number" id="n0186"><field name="NUM">3</field></shadow></value><next><block type="variables_set" id="b0189"><field name="VAR" id="v_score">score</field><comment pinned="false" h="110" w="520">Při GAME OVER vynuluje skóre.</comment><value name="VALUE"><shadow type="math_number" id="n0188"><field name="NUM">0</field></shadow></value><next><block type="variables_set" id="b0193"><field name="VAR" id="v_bricks">bricks</field><comment pinned="false" h="110" w="520">Při GAME OVER obnoví všech 24 kostek.</comment><value name="VALUE"><block type="lists_repeat" id="b0192"><comment pinned="false" h="110" w="520">Vytvoří nové pole 24 jedniček pro všechny aktivní kostky po GAME OVER.</comment><value name="ITEM"><shadow type="math_number" id="n0190"><field name="NUM">1</field></shadow></value><value name="NUM"><shadow type="math_number" id="n0191"><field name="NUM">24</field></shadow></value></block></value></block></next></block></next></block></statement></block></next></block></next></block></next></block></next></block></next></block></statement><next><block type="fb_fill" id="b0202"><field name="barva">0</field><comment pinned="false" h="110" w="520">Vyčistí celý framebuffer barvou 0 před vykreslením nového snímku. Bez tohoto kroku by za pohybujícími se objekty zůstávaly staré pixely.</comment><next><block type="fb_draw_pic" id="}L?A[iTOi-iO}t|/XgM3"><field name="name">Ball_4x4</field><field name="alpha">-1</field><comment pinned="false" h="110" w="520">Vykreslí 4×4px míček do framebufferu. DŮLEŽITÉ: míček se kreslí před pálkou, protože použitý obrázek nemá průhlednost a pálka má být při překrytí navrchu.</comment><value name="px"><block type="variables_get" id="#)_~VL/HZm@xp:m4]mX8"><field name="VAR" id="v_ball_x">ball_x</field></block></value><value name="py"><block type="variables_get" id="T|YzX7T?xd;7FVpj^}Wn"><field name="VAR" id="v_ball_y">ball_y</field></block></value><value name="data"><shadow type="text" id=")!*{sp[QUL!mLP=p_X6r"><field name="TEXT">bytearray(b'\x06\x0f\x0f\x06'), 4, 8</field></shadow></value><next><block type="controls_for" id="b0236"><field name="VAR" id="v_row">row</field><comment pinned="false" h="110" w="520">Vnější vykreslovací smyčka pro 3 řádky kostek: row = 0…2.</comment><value name="FROM"><shadow type="math_number" id="n0233"><field name="NUM">0</field></shadow></value><value name="TO"><shadow type="math_number" id="n0234"><field name="NUM">2</field></shadow></value><value name="BY"><shadow type="math_number" id="n0235"><field name="NUM">1</field></shadow></value><statement name="DO"><block type="controls_for" id="b0232"><field name="VAR" id="v_col">col</field><comment pinned="false" h="110" w="520">Vnitřní vykreslovací smyčka pro 8 sloupců v každém řádku: col = 0…7.</comment><value name="FROM"><shadow type="math_number" id="n0229"><field name="NUM">0</field></shadow></value><value name="TO"><shadow type="math_number" id="n0230"><field name="NUM">7</field></shadow></value><value name="BY"><shadow type="math_number" id="n0231"><field name="NUM">1</field></shadow></value><statement name="DO"><block type="variables_set" id="b0208"><field name="VAR" id="v_idx">idx</field><comment pinned="false" h="110" w="520">Pro aktuální row/col vypočítá lineární index idx = row × 8 + col, aby bylo možné přečíst stav kostky z pole.</comment><value name="VALUE"><block type="math_arithmetic" id="b0207"><field name="OP">ADD</field><comment pinned="false" h="110" w="520">Spojí offset řádku (row × 8) a číslo sloupce col do jediného indexu.</comment><value name="A"><block type="math_arithmetic" id="b0205"><field name="OP">MULTIPLY</field><comment pinned="false" h="110" w="520">Vypočítá začátek aktuálního řádku v poli bricks: row × 8.</comment><value name="A"><block type="variables_get" id="b0203"><field name="VAR" id="v_row">row</field></block></value><value name="B"><shadow type="math_number" id="n0204"><field name="NUM">8</field></shadow></value></block></value><value name="B"><block type="variables_get" id="b0206"><field name="VAR" id="v_col">col</field></block></value></block></value><next><block type="controls_if" id="b0228"><comment pinned="false" h="110" w="520">Kostku vykreslí pouze tehdy, když její stav v poli bricks stále obsahuje 1. Zničené kostky mají 0 a jsou přeskočeny.</comment><value name="IF0"><block type="logic_compare" id="b0227"><field name="OP">EQ</field><value name="A"><block type="lists_getIndex" id="b0224"><mutation statement="false" at="true"></mutation><field name="MODE">GET</field><field name="WHERE">FROM_START</field><comment pinned="false" h="110" w="520">Čte stav aktuální kostky při vykreslování. K idx se přičítá 1 kvůli jedničkovému indexování tohoto Blockly bloku.</comment><value name="VALUE"><block type="variables_get" id="b0225"><field name="VAR" id="v_bricks">bricks</field></block></value><value name="AT"><block type="math_arithmetic" id="b0223"><field name="OP">ADD</field><comment pinned="false" h="110" w="520">Převádí interní idx 0…23 na pozici 1…24 pro čtení seznamu.</comment><value name="A"><block type="variables_get" id="b0221"><field name="VAR" id="v_idx">idx</field></block></value><value name="B"><shadow type="math_number" id="n0222"><field name="NUM">1</field></shadow></value></block></value></block></value><value name="B"><shadow type="math_number" id="n0226"><field name="NUM">1</field></shadow></value></block></value><statement name="DO0"><block type="fb_rect_fill" id="b0220"><comment pinned="false" h="110" w="520">Vykreslí jednu aktivní kostku jako vyplněný obdélník 15×5 px. Rozteč 16×6 px nechává mezi kostkami jednobodovou mezeru.</comment><value name="px"><block type="math_arithmetic" id="b0211"><field name="OP">MULTIPLY</field><comment pinned="false" h="110" w="520">X souřadnice kostky = col × 16.</comment><value name="A"><block type="variables_get" id="b0209"><field name="VAR" id="v_col">col</field></block></value><value name="B"><shadow type="math_number" id="n0210"><field name="NUM">16</field></shadow></value></block></value><value name="py"><block type="math_arithmetic" id="b0216"><field name="OP">ADD</field><comment pinned="false" h="110" w="520">Y souřadnice kostky = 6 + row × 6. Horních 6 px zůstává jako okraj herní plochy.</comment><value name="A"><shadow type="math_number" id="n0212"><field name="NUM">6</field></shadow></value><value name="B"><block type="math_arithmetic" id="b0215"><field name="OP">MULTIPLY</field><comment pinned="false" h="110" w="520">Vertikální posun aktuálního řádku kostek: row × 6.</comment><value name="A"><block type="variables_get" id="b0213"><field name="VAR" id="v_row">row</field></block></value><value name="B"><shadow type="math_number" id="n0214"><field name="NUM">6</field></shadow></value></block></value></block></value><value name="sirka"><shadow type="math_number" id="n0217"><field name="NUM">15</field></shadow></value><value name="vyska"><shadow type="math_number" id="n0218"><field name="NUM">5</field></shadow></value><value name="col"><shadow type="math_number" id="n0219"><field name="NUM">1</field></shadow></value></block></statement></block></next></block></statement></block></statement><next><block type="fb_rect_fill" id="b0242"><comment pinned="false" h="110" w="520">Vykreslí spodní pálku jako plný obdélník 20×3 px na Y=59. Je úmyslně kreslena až PO míčku, takže její neprůhledná výplň správně překryje míček při kontaktu.</comment><value name="px"><block type="variables_get" id="b0237"><field name="VAR" id="v_paddle_x">paddle_x</field></block></value><value name="py"><shadow type="math_number" id="n0238"><field name="NUM">59</field></shadow></value><value name="sirka"><shadow type="math_number" id="n0239"><field name="NUM">20</field></shadow></value><value name="vyska"><shadow type="math_number" id="n0240"><field name="NUM">3</field></shadow></value><value name="col"><shadow type="math_number" id="n0241"><field name="NUM">1</field></shadow></value><next><block type="oded_refresh" id="b0247"><comment pinned="false" h="110" w="520">Přenese hotový framebuffer na OLED/simulovaný displej. Teprve tím se celý právě sestavený snímek zobrazí uživateli.</comment></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></statement></block>
  <!--ESPIDE_EXTENSIONS_BEGIN-->
eyJ2ZXJzaW9uIjoxLCJwcm9jZXNzb3IiOiJTaW11bGF0b3IiLCJleHRlbnNpb25zIjpbXX0=
