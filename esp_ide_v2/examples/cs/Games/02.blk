<xml xmlns="https://developers.google.com/blockly/xml"><variables><variable id="v_bird_vy">bird_vy</variable><variable id="v_button_prev">button_prev</variable><variable id="v_bird_y">bird_y</variable><variable id="v_pipe_x">pipe_x</variable><variable id="v_gap_y">gap_y</variable><variable id="v_score">score</variable><variable id="E8H2ER~.+qa#;MuK5x+|">i</variable></variables><block type="program_start" id="mini_start" x="60" y="40"><comment pinned="false" h="105" w="500">PROGRAM START se provede jednou. Inicializujeme hardware a šest proměnných, které stačí pro celou hru.</comment><next><block type="oled_init" id="mini_oled"><mutation xmlns="http://www.w3.org/1999/xhtml" display_type="AUTO"></mutation><field name="DISPLAY_TYPE">AUTO</field><comment pinned="false" h="105" w="500">OLED 128×64. Flappy Mini vykresluje celý snímek do framebufferu a pak ho jedním blokem odešle na displej.</comment><value name="SDA_PIN"><shadow type="math_number" id="s0001"><field name="NUM">21</field></shadow></value><value name="SCL_PIN"><shadow type="math_number" id="s0002"><field name="NUM">22</field></shadow></value><next><block type="joystick_init" id="mini_joy"><field name="joy_name">1</field><field name="rot">270</field><comment pinned="false" h="105" w="500">Joystick používáme pouze jako tlačítko. Piny uprav podle své desky; osy v této hře nejsou potřeba.</comment><value name="vrx"><shadow type="math_number" id="s0003"><field name="NUM">13</field></shadow></value><value name="vry"><shadow type="math_number" id="s0004"><field name="NUM">14</field></shadow></value><value name="sw"><shadow type="math_number" id="s0005"><field name="NUM">15</field></shadow></value><next><block type="variables_set" id="b0007"><field name="VAR" id="v_bird_y">bird_y</field><comment pinned="false" h="105" w="500">bird_y je svislá poloha ptáka. X je stále 20 px, takže ho nemusíme ukládat do proměnné.</comment><value name="VALUE"><shadow type="math_number" id="s0006"><field name="NUM">26</field></shadow></value><next><block type="variables_set" id="b0009"><field name="VAR" id="v_bird_vy">bird_vy</field><comment pinned="false" h="105" w="500">bird_vy je svislá rychlost. Záporná hodnota letí nahoru, kladná dolů.</comment><value name="VALUE"><shadow type="math_number" id="s0008"><field name="NUM">0</field></shadow></value><next><block type="variables_set" id="b0011"><field name="VAR" id="v_button_prev">button_prev</field><comment pinned="false" h="105" w="500">Pamatujeme si minulý stav tlačítka, abychom poznali nový stisk a jeden dlouhý stisk neznamenal mnoho skoků.</comment><value name="VALUE"><shadow type="math_number" id="s0010"><field name="NUM">0</field></shadow></value><next><block type="variables_set" id="b0013"><field name="VAR" id="v_pipe_x">pipe_x</field><comment pinned="false" h="105" w="500">X pozice jediné dvojice trubek. Po opuštění displeje ji pouze recyklujeme zpět doprava.</comment><value name="VALUE"><shadow type="math_number" id="s0012"><field name="NUM">128</field></shadow></value><next><block type="variables_set" id="b0015"><field name="VAR" id="v_gap_y">gap_y</field><comment pinned="false" h="105" w="500">Horní hrana průletové mezery. Mezera má pevnou výšku 28 px.</comment><value name="VALUE"><shadow type="math_number" id="s0014"><field name="NUM">18</field></shadow></value><next><block type="variables_set" id="b0017"><field name="VAR" id="v_score">score</field><comment pinned="false" h="105" w="500">Skóre se zvýší pokaždé, když trubka projede za levý okraj a vrátí se doprava.</comment><value name="VALUE"><shadow type="math_number" id="s0016"><field name="NUM">0</field></shadow></value></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block><block type="program_loop" id="mini_loop" x="720" y="40"><comment pinned="false" h="105" w="500">PROGRAM LOOP je celý herní snímek: vstup → fyzika → trubka → kolize → kreslení.</comment><statement name="DO"><block type="controls_if" id="b0024"><comment pinned="false" h="105" w="500">Tlačítko nemění polohu přímo. Mění rychlost, což je důležitý princip jednoduché herní fyziky.</comment><value name="IF0"><block type="logic_operation" id="b0021"><field name="OP">AND</field><comment pinned="false" h="105" w="500">Nový stisk nastane jen tehdy, když je tlačítko nyní stisknuté a před chvílí nebylo.</comment><value name="A"><block type="get_joy_state_ble" id="b0018"><field name="joy_name">1</field><field name="axis">5</field><comment pinned="false" h="105" w="500">Aktuální stav tlačítka joysticku.</comment></block></value><value name="B"><block type="logic_negate" id="b0020"><comment pinned="false" h="105" w="500">NOT minulého stavu vytvoří detekci přechodu 0 → 1.</comment><value name="BOOL"><block type="variables_get" id="b0019"><field name="VAR" id="v_button_prev">button_prev</field></block></value></block></value></block></value><statement name="DO0"><block type="variables_set" id="b0023"><field name="VAR" id="v_bird_vy">bird_vy</field><comment pinned="false" h="105" w="500">Skok je jen změna rychlosti: nastavíme zápornou rychlost a pták začne stoupat.</comment><value name="VALUE"><shadow type="math_number" id="s0022"><field name="NUM">-3</field></shadow></value></block></statement><next><block type="variables_set" id="b0026"><field name="VAR" id="v_button_prev">button_prev</field><comment pinned="false" h="105" w="500">Na konci zpracování vstupu uložíme aktuální stav pro další průchod smyčkou.</comment><value name="VALUE"><block type="get_joy_state_ble" id="b0025"><field name="joy_name">1</field><field name="axis">5</field></block></value><next><block type="variables_set" id="b0030"><field name="VAR" id="v_bird_vy">bird_vy</field><comment pinned="false" h="105" w="500">rychlost = rychlost + gravitace</comment><value name="VALUE"><block type="math_arithmetic" id="b0029"><field name="OP">ADD</field><comment pinned="false" h="105" w="500">Každý snímek k rychlosti přidáme gravitaci +0,22.</comment><value name="A"><block type="variables_get" id="b0027"><field name="VAR" id="v_bird_vy">bird_vy</field></block></value><value name="B"><shadow type="math_number" id="s0028"><field name="NUM">0.22</field></shadow></value></block></value><next><block type="variables_set" id="b0034"><field name="VAR" id="v_bird_y">bird_y</field><comment pinned="false" h="105" w="500">poloha = poloha + rychlost</comment><value name="VALUE"><block type="math_arithmetic" id="b0033"><field name="OP">ADD</field><comment pinned="false" h="105" w="500">Poloha se mění podle aktuální rychlosti.</comment><value name="A"><block type="variables_get" id="b0031"><field name="VAR" id="v_bird_y">bird_y</field></block></value><value name="B"><block type="variables_get" id="b0032"><field name="VAR" id="v_bird_vy">bird_vy</field></block></value></block></value><next><block type="variables_set" id="b0038"><field name="VAR" id="v_pipe_x">pipe_x</field><comment pinned="false" h="105" w="500">Místo pohybu ptáka doprava posouváme celý svět doleva.</comment><value name="VALUE"><block type="math_arithmetic" id="b0037"><field name="OP">MINUS</field><comment pinned="false" h="105" w="500">Trubka se každý snímek posune o 2 pixely doleva.</comment><value name="A"><block type="variables_get" id="b0035"><field name="VAR" id="v_pipe_x">pipe_x</field></block></value><value name="B"><shadow type="math_number" id="s0036"><field name="NUM">2</field></shadow></value></block></value><next><block type="controls_if" id="b0052"><comment pinned="false" h="105" w="500">Recyklace jediné překážky šetří mnoho bloků: nepotřebujeme pole ani druhou trubku.</comment><value name="IF0"><block type="logic_compare" id="b0041"><field name="OP">LT</field><comment pinned="false" h="105" w="500">Je trubka celá mimo levý okraj?</comment><value name="A"><block type="variables_get" id="b0039"><field name="VAR" id="v_pipe_x">pipe_x</field></block></value><value name="B"><shadow type="math_number" id="s0040"><field name="NUM">-12</field></shadow></value></block></value><statement name="DO0"><block type="variables_set" id="b0043"><field name="VAR" id="v_pipe_x">pipe_x</field><comment pinned="false" h="105" w="500">Trubku vrátíme za pravý okraj.</comment><value name="VALUE"><shadow type="math_number" id="s0042"><field name="NUM">128</field></shadow></value><next><block type="variables_set" id="b0047"><field name="VAR" id="v_gap_y">gap_y</field><comment pinned="false" h="105" w="500">Nová mezera je náhodně mezi 6 a 29 px.</comment><value name="VALUE"><block type="math_random_int" id="b0044"><comment pinned="false" h="105" w="500">Náhodná výška zajistí, že další překážka nebude stejná.</comment><value name="FROM"><shadow type="math_number" id="s0045"><field name="NUM">6</field></shadow></value><value name="TO"><shadow type="math_number" id="s0046"><field name="NUM">29</field></shadow></value></block></value><next><block type="variables_set" id="b0051"><field name="VAR" id="v_score">score</field><comment pinned="false" h="105" w="500">Úspěšný průlet přidá jeden bod.</comment><value name="VALUE"><block type="math_arithmetic" id="b0050"><field name="OP">ADD</field><value name="A"><block type="variables_get" id="b0048"><field name="VAR" id="v_score">score</field></block></value><value name="B"><shadow type="math_number" id="s0049"><field name="NUM">1</field></shadow></value></block></value></block></next></block></next></block></statement><next><block type="controls_if" id="b0094"><comment pinned="false" h="105" w="500">Mini verze nemá samostatný GAME OVER stav. Nárazu využijeme k okamžitému resetu, čímž ušetříme mnoho bloků.</comment><value name="IF0"><block type="logic_operation" id="b0081"><field name="OP">OR</field><comment pinned="false" h="105" w="500">Havárie = okraj obrazovky NEBO trubka.</comment><value name="A"><block type="logic_operation" id="b0059"><field name="OP">OR</field><comment pinned="false" h="105" w="500">Pták má výšku 8 px, proto maximální horní souřadnice je 56.</comment><value name="A"><block type="logic_compare" id="b0055"><field name="OP">LT</field><value name="A"><block type="variables_get" id="b0053"><field name="VAR" id="v_bird_y">bird_y</field></block></value><value name="B"><shadow type="math_number" id="s0054"><field name="NUM">0</field></shadow></value></block></value><value name="B"><block type="logic_compare" id="b0058"><field name="OP">GT</field><value name="A"><block type="variables_get" id="b0056"><field name="VAR" id="v_bird_y">bird_y</field></block></value><value name="B"><shadow type="math_number" id="s0057"><field name="NUM">56</field></shadow></value></block></value></block></value><value name="B"><block type="logic_operation" id="b0080"><field name="OP">AND</field><comment pinned="false" h="105" w="500">Trubka zasáhne ptáka jen při současném překrytí v ose X a pobytu mimo mezeru.</comment><value name="A"><block type="logic_operation" id="b0066"><field name="OP">AND</field><comment pinned="false" h="105" w="500">Pták je kolem X=20 a má šířku 10 px. Tento jednoduchý test říká, že trubka právě prochází přes jeho X oblast.</comment><value name="A"><block type="logic_compare" id="b0062"><field name="OP">LT</field><value name="A"><block type="variables_get" id="b0060"><field name="VAR" id="v_pipe_x">pipe_x</field></block></value><value name="B"><shadow type="math_number" id="s0061"><field name="NUM">30</field></shadow></value></block></value><value name="B"><block type="logic_compare" id="b0065"><field name="OP">GT</field><value name="A"><block type="variables_get" id="b0063"><field name="VAR" id="v_pipe_x">pipe_x</field></block></value><value name="B"><shadow type="math_number" id="s0064"><field name="NUM">8</field></shadow></value></block></value></block></value><value name="B"><block type="logic_operation" id="b0079"><field name="OP">OR</field><comment pinned="false" h="105" w="500">Kolize nastane, pokud střed ptáka není uvnitř 28px mezery.</comment><value name="A"><block type="logic_compare" id="b0071"><field name="OP">LT</field><value name="A"><block type="math_arithmetic" id="b0069"><field name="OP">ADD</field><comment pinned="false" h="105" w="500">Pro Mini verzi testujeme střed ptáka místo celého obdélníku. Tím výrazně snížíme počet bloků.</comment><value name="A"><block type="variables_get" id="b0067"><field name="VAR" id="v_bird_y">bird_y</field></block></value><value name="B"><shadow type="math_number" id="s0068"><field name="NUM">4</field></shadow></value></block></value><value name="B"><block type="variables_get" id="b0070"><field name="VAR" id="v_gap_y">gap_y</field></block></value></block></value><value name="B"><block type="logic_compare" id="b0078"><field name="OP">GT</field><value name="A"><block type="math_arithmetic" id="b0074"><field name="OP">ADD</field><value name="A"><block type="variables_get" id="b0072"><field name="VAR" id="v_bird_y">bird_y</field></block></value><value name="B"><shadow type="math_number" id="s0073"><field name="NUM">4</field></shadow></value></block></value><value name="B"><block type="math_arithmetic" id="b0077"><field name="OP">ADD</field><value name="A"><block type="variables_get" id="b0075"><field name="VAR" id="v_gap_y">gap_y</field></block></value><value name="B"><shadow type="math_number" id="s0076"><field name="NUM">28</field></shadow></value></block></value></block></value></block></value></block></value></block></value><statement name="DO0"><block type="variables_set" id="b0083"><field name="VAR" id="v_bird_y">bird_y</field><comment pinned="false" h="105" w="500">Po nárazu Mini verze ihned začne nové kolo.</comment><value name="VALUE"><shadow type="math_number" id="s0082"><field name="NUM">26</field></shadow></value><next><block type="variables_set" id="b0085"><field name="VAR" id="v_bird_vy">bird_vy</field><comment pinned="false" h="105" w="500">Vynulujeme rychlost.</comment><value name="VALUE"><shadow type="math_number" id="s0084"><field name="NUM">0</field></shadow></value><next><block type="variables_set" id="b0087"><field name="VAR" id="v_pipe_x">pipe_x</field><comment pinned="false" h="105" w="500">Překážku vrátíme doprava.</comment><value name="VALUE"><shadow type="math_number" id="s0086"><field name="NUM">128</field></shadow></value><next><block type="variables_set" id="b0091"><field name="VAR" id="v_gap_y">gap_y</field><comment pinned="false" h="105" w="500">Nové kolo dostane novou mezeru.</comment><value name="VALUE"><block type="math_random_int" id="b0088"><value name="FROM"><shadow type="math_number" id="s0089"><field name="NUM">6</field></shadow></value><value name="TO"><shadow type="math_number" id="s0090"><field name="NUM">29</field></shadow></value></block></value><next><block type="variables_set" id="b0093"><field name="VAR" id="v_score">score</field><comment pinned="false" h="105" w="500">Skóre se po nárazu vynuluje.</comment><value name="VALUE"><shadow type="math_number" id="s0092"><field name="NUM">0</field></shadow></value><next><block type="fb_fill" id=".g{p#e{B)u[!QcR{]8k_"><field name="barva">0</field><comment pinned="false" h="105" w="500">Vymažeme předchozí snímek. Všechny objekty hry se pak nakreslí znovu do čistého framebufferu.</comment><next><block type="fb_txt" id="(*!(#.5~E[.A083B!))B"><value name="text"><shadow type="text" id="SM]kB!.n4H!QbsN;szGc"><field name="TEXT">GAME OVER</field></shadow></value><value name="px"><shadow type="math_number" id="A$4a!CgOLTbrH117v_mw"><field name="NUM">28</field></shadow></value><value name="py"><shadow type="math_number" id="XV2-2ME`D{/#]#nDRz%A"><field name="NUM">28</field></shadow></value><value name="barva"><shadow type="math_number" id="Kjfj2X04#na^*nx)veEA"><field name="NUM">1</field></shadow></value><next><block type="oded_refresh" id=":Ddlm(%d4{N=se00xLQS"><comment pinned="false" h="105" w="500">Hotový framebuffer odešleme na OLED najednou.</comment><next><block type="utime.delay" id="Mr[[wX[4S`$c2|M-a~}#"><field name="SCALE">sleep</field><value name="TIME"><shadow type="math_number" id="@x_Fpxw9Btx2$t$+m}+/"><field name="NUM">1</field></shadow></value><next><block type="controls_for" id="]Aixs7TyE)~X,1l4PyE%"><field name="VAR" id="E8H2ER~.+qa#;MuK5x+|">i</field><comment pinned="false" h="80" w="160">odpočet 3, 2, 1 s vypsáním čísla na display</comment><value name="FROM"><shadow type="math_number" id="]SELXlr(.n!{N:`7EGc:"><field name="NUM">3</field></shadow></value><value name="TO"><shadow type="math_number" id="1^c:N)ZlrP+H3Hr-B[Yq"><field name="NUM">1</field></shadow></value><value name="BY"><shadow type="math_number" id="jx5El`hVlSiu~D}YErfE"><field name="NUM">1</field></shadow></value><statement name="DO"><block type="fb_fill" id="wDm5G-E7N2FP)Vy/tL-6"><field name="barva">0</field><comment pinned="false" h="105" w="500">Vymažeme předchozí snímek. Všechny objekty hry se pak nakreslí znovu do čistého framebufferu.</comment><next><block type="fb_txt" id="Eya68RFXd|C6=C*#J$.3"><value name="text"><shadow type="text" id="c4rl#rcg7$zU`9}kt@!-"><field name="TEXT">GAME OVER</field></shadow><block type="variables_get" id="RROe`?;48_oewNEg|2H6"><field name="VAR" id="E8H2ER~.+qa#;MuK5x+|">i</field></block></value><value name="px"><shadow type="math_number" id="WC$S-EGSaoVA96pt_}o}"><field name="NUM">60</field></shadow></value><value name="py"><shadow type="math_number" id="F4MFZtA$1yuwB.6)q@65"><field name="NUM">28</field></shadow></value><value name="barva"><shadow type="math_number" id="=0jte7zyr]bPEqE21^00"><field name="NUM">1</field></shadow></value><next><block type="oded_refresh" id="P9/+`t@i5@]KX.9#Hmrr"><comment pinned="false" h="105" w="500">Hotový framebuffer odešleme na OLED najednou.</comment><next><block type="utime.delay" id="hzLL:6*b^o%FRBqdAF;m"><field name="SCALE">sleep_ms</field><value name="TIME"><shadow type="math_number" id="ki~I1jzB]Ymf1%$1mV_D"><field name="NUM">400</field></shadow></value></block></next></block></next></block></next></block></statement></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></statement><next><block type="fb_fill" id="b0095"><field name="barva">0</field><comment pinned="false" h="105" w="500">Vymažeme předchozí snímek. Všechny objekty hry se pak nakreslí znovu do čistého framebufferu.</comment><next><block type="fb_draw_pic" id="b0098"><field name="name">FlappyMini_Bird</field><field name="alpha">-1</field><comment pinned="false" h="105" w="500">Bitmapa ptáka 10×8 px je uložená přímo v projektu:
...##.....
..####....
.######...
####.####.
##########
.######...
..####....
...##.....
Kreslí se přímo do framebufferu stejně jako grafika ve Space Invaders.</comment><value name="px"><shadow type="math_number" id="s0099"><field name="NUM">20</field></shadow></value><value name="py"><block type="math_round" id="b0097"><field name="OP">ROUND</field><comment pinned="false" h="105" w="500">Framebuffer pracuje s celými pixely, proto fyzikální polohu při kreslení zaokrouhlíme.</comment><value name="NUM"><block type="variables_get" id="b0096"><field name="VAR" id="v_bird_y">bird_y</field></block></value></block></value><value name="data"><shadow type="text" id="s0100"><field name="TEXT">bytearray(b'\x18\x3c\x7e\xff\xf7\x7e\x3c\x18\x18\x10'), 10, 8</field></shadow></value><next><block type="fb_rect_fill" id="b0103"><comment pinned="false" h="105" w="500">Horní část trubky je jednoduchý vyplněný obdélník.</comment><value name="px"><block type="variables_get" id="b0101"><field name="VAR" id="v_pipe_x">pipe_x</field></block></value><value name="py"><shadow type="math_number" id="s0104"><field name="NUM">0</field></shadow></value><value name="sirka"><shadow type="math_number" id="s0105"><field name="NUM">10</field></shadow></value><value name="vyska"><block type="variables_get" id="b0102"><field name="VAR" id="v_gap_y">gap_y</field></block></value><value name="col"><shadow type="math_number" id="s0106"><field name="NUM">1</field></shadow></value><next><block type="fb_rect_fill" id="b0116"><comment pinned="false" h="105" w="500">Spodní část trubky se dopočítá z výšky displeje 64 px.</comment><value name="px"><block type="variables_get" id="b0115"><field name="VAR" id="v_pipe_x">pipe_x</field></block></value><value name="py"><block type="math_arithmetic" id="b0109"><field name="OP">ADD</field><comment pinned="false" h="105" w="500">Spodní trubka začíná 28 px pod horní hranou mezery.</comment><value name="A"><block type="variables_get" id="b0107"><field name="VAR" id="v_gap_y">gap_y</field></block></value><value name="B"><shadow type="math_number" id="s0108"><field name="NUM">28</field></shadow></value></block></value><value name="sirka"><shadow type="math_number" id="s0117"><field name="NUM">10</field></shadow></value><value name="vyska"><block type="math_arithmetic" id="b0114"><field name="OP">MINUS</field><comment pinned="false" h="105" w="500">Výška spodní trubky je zbytek displeje pod mezerou.</comment><value name="A"><shadow type="math_number" id="s0110"><field name="NUM">64</field></shadow></value><value name="B"><block type="math_arithmetic" id="b0113"><field name="OP">ADD</field><value name="A"><block type="variables_get" id="b0111"><field name="VAR" id="v_gap_y">gap_y</field></block></value><value name="B"><shadow type="math_number" id="s0112"><field name="NUM">28</field></shadow></value></block></value></block></value><value name="col"><shadow type="math_number" id="s0118"><field name="NUM">1</field></shadow></value><next><block type="fb_rect_fill" id="b0122"><comment pinned="false" h="105" w="500">Skóre zobrazíme bez textu jako jednoduchý proužek. I to šetří několik bloků.</comment><value name="px"><shadow type="math_number" id="s0123"><field name="NUM">2</field></shadow></value><value name="py"><shadow type="math_number" id="s0124"><field name="NUM">2</field></shadow></value><value name="sirka"><block type="math_arithmetic" id="b0121"><field name="OP">MULTIPLY</field><comment pinned="false" h="105" w="500">Každý bod prodlouží ukazatel o 2 pixely.</comment><value name="A"><block type="variables_get" id="b0119"><field name="VAR" id="v_score">score</field></block></value><value name="B"><shadow type="math_number" id="s0120"><field name="NUM">2</field></shadow></value></block></value><value name="vyska"><shadow type="math_number" id="s0125"><field name="NUM">2</field></shadow></value><value name="col"><shadow type="math_number" id="s0126"><field name="NUM">1</field></shadow></value><next><block type="oded_refresh" id="b0127"><comment pinned="false" h="105" w="500">Hotový framebuffer odešleme na OLED najednou.</comment></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></statement></block>
  <!--ESPIDE_EXTENSIONS_BEGIN-->
eyJ2ZXJzaW9uIjoxLCJwcm9jZXNzb3IiOiJTaW11bGF0b3IiLCJleHRlbnNpb25zIjpbXX0=
