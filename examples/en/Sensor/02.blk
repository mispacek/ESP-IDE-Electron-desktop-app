<xml xmlns="https://developers.google.com/blockly/xml"><variables><variable id="encoder-position">position</variable><variable id="encoder-brightness">led_brightness</variable></variables><block type="program_start" id="encoder-start" x="60" y="50"><comment pinned="false" h="135" w="410">Connect the rotary encoder as follows: A to GPIO18, B to GPIO19, and GND to GND. Use a module with pull-up resistors or add 10 kΩ resistors to 3.3 V. Connect the LED through a resistor to GPIO 1.</comment><next><block type="oled_init" id="Y%leO8aAL-C=n`0rUe2H"><mutation xmlns="http://www.w3.org/1999/xhtml" display_type="AUTO"></mutation><field name="DISPLAY_TYPE">AUTO</field><comment pinned="false" h="76.39999389648438" w="264.39996337890625">Initialize an I2C OLED with an SSD1306 controller on SDA: GPIO21 and SCL: GPIO22.</comment><data>@espide-display-target-used:2</data><value name="SDA_PIN"><shadow type="math_number" id="C}2-qsTUuY4=C1X1xf$?"><field name="NUM">21</field></shadow></value><value name="SCL_PIN"><shadow type="math_number" id="k-XR$t~Unb$lD|j~7OaX"><field name="NUM">22</field></shadow></value><next><block type="encoder_init" id="encoder-init"><field name="index">1</field><comment pinned="false" h="95" w="360">One full encoder step changes the value by 1. The direction can be reversed with the checkbox.</comment><value name="A"><shadow type="math_number" id="encoder-pin-a"><field name="NUM">18</field></shadow></value><value name="B"><shadow type="math_number" id="encoder-pin-b"><field name="NUM">19</field></shadow></value><value name="reverse"><shadow type="logic_boolean" id="encoder-reverse"><field name="BOOL">FALSE</field></shadow></value><value name="scale"><shadow type="math_number" id="encoder-scale"><field name="NUM">1</field></shadow></value><next><block type="encoder_set" id="encoder-reset"><field name="index">1</field><comment pinned="false" h="70" w="330">Start at position 0 after power-up.</comment><value name="Val"><shadow type="math_number" id="encoder-zero"><field name="NUM">0</field></shadow></value><next><block type="pwm_RP2040" id="encoder-pwm-init"><field name="ID">1</field><comment pinned="false" h="85" w="350">PWM on GPIO 1 changes the LED brightness smoothly instead of only turning it on or off.</comment><value name="pin"><shadow type="math_number" id="encoder-led-pin"><field name="NUM">1</field></shadow></value><value name="frequency"><shadow type="math_number" id="encoder-pwm-frequency"><field name="NUM">1000</field></shadow></value><value name="duty"><shadow type="math_number" id="encoder-pwm-zero"><field name="NUM">0</field></shadow></value><next><block type="text_print" id="encoder-ready-print"><value name="TEXT"><shadow type="text" id="encoder-ready-text"><field name="TEXT">The brightness control is ready.</field></shadow></value></block></next></block></next></block></next></block></next></block></next></block><block type="program_loop" id="encoder-loop" x="60" y="500"><comment pinned="false" h="95" w="370">Limit the position to values from 0 to 20, so the brightness stops changing at either end.</comment><statement name="DO"><block type="variables_set" id="encoder-read-position"><field name="VAR" id="encoder-position">position</field><value name="VALUE"><block type="math_constrain" id="encoder-limit-position"><value name="VALUE"><block type="encoder_get" id="encoder-position-value"><field name="index">1</field></block></value><value name="LOW"><shadow type="math_number" id="encoder-low"><field name="NUM">0</field></shadow></value><value name="HIGH"><shadow type="math_number" id="encoder-high"><field name="NUM">20</field></shadow></value></block></value><next><block type="encoder_set" id="encoder-write-limited-position"><field name="index">1</field><comment pinned="false" h="80" w="350">Write the limited value back so that the encoder cannot count below 0 or above 20.</comment><value name="Val"><block type="variables_get" id="encoder-limited-position"><field name="VAR" id="encoder-position">position</field></block></value><next><block type="variables_set" id="encoder-convert-brightness"><field name="VAR" id="encoder-brightness">led_brightness</field><comment pinned="false" h="100" w="370">Map the position range of 0 to 20 to the full PWM range of 0 to 65535.</comment><value name="VALUE"><block type="zmena_rozsahu" id="encoder-brightness-map"><field name="celociselne">TRUE</field><field name="limitovat">TRUE</field><value name="in_value"><block type="variables_get" id="encoder-map-position"><field name="VAR" id="encoder-position">position</field></block></value><value name="in_min"><shadow type="math_number" id="encoder-map-in-min"><field name="NUM">0</field></shadow></value><value name="in_max"><shadow type="math_number" id="encoder-map-in-max"><field name="NUM">20</field></shadow></value><value name="out_min"><shadow type="math_number" id="encoder-map-out-min"><field name="NUM">0</field></shadow></value><value name="out_max"><shadow type="math_number" id="encoder-map-out-max"><field name="NUM">65535</field></shadow></value></block></value><next><block type="espide_display_designer" id="TY)d6a5#P5FN5Eo_J{yB"><mutation xmlns="http://www.w3.org/1999/xhtml" display_designer_version="1" scene="{&quot;schema&quot;:&quot;espide.display-designer&quot;,&quot;version&quot;:1,&quot;width&quot;:128,&quot;height&quot;:64,&quot;mode&quot;:&quot;mono&quot;,&quot;name&quot;:&quot;Display&quot;,&quot;layers&quot;:[{&quot;id&quot;:&quot;rect-2&quot;,&quot;type&quot;:&quot;rect&quot;,&quot;label&quot;:&quot;&quot;,&quot;x&quot;:0,&quot;y&quot;:0,&quot;width&quot;:128,&quot;height&quot;:16,&quot;radius&quot;:5,&quot;filled&quot;:false,&quot;color&quot;:1,&quot;bindings&quot;:{},&quot;visible&quot;:true},{&quot;id&quot;:&quot;text-1&quot;,&quot;type&quot;:&quot;text&quot;,&quot;label&quot;:&quot;&quot;,&quot;x&quot;:15,&quot;y&quot;:1,&quot;width&quot;:98,&quot;height&quot;:16,&quot;text&quot;:&quot;Encoder PWM&quot;,&quot;fontId&quot;:&quot;builtin-spleen-16&quot;,&quot;color&quot;:1,&quot;parameterId&quot;:null,&quot;bindings&quot;:{},&quot;visible&quot;:true},{&quot;id&quot;:&quot;text-2&quot;,&quot;type&quot;:&quot;text&quot;,&quot;label&quot;:&quot;PWM_Value&quot;,&quot;x&quot;:69,&quot;y&quot;:21,&quot;width&quot;:54,&quot;height&quot;:20,&quot;text&quot;:&quot;65535&quot;,&quot;fontId&quot;:&quot;builtin-ter-20-bold&quot;,&quot;color&quot;:1,&quot;parameterId&quot;:&quot;text-2-text&quot;,&quot;bindings&quot;:{&quot;text&quot;:true},&quot;visible&quot;:true},{&quot;id&quot;:&quot;text-3&quot;,&quot;type&quot;:&quot;text&quot;,&quot;label&quot;:&quot;PWM&quot;,&quot;x&quot;:26,&quot;y&quot;:21,&quot;width&quot;:43,&quot;height&quot;:20,&quot;text&quot;:&quot;PWM:&quot;,&quot;fontId&quot;:&quot;builtin-ter-20-bold&quot;,&quot;color&quot;:1,&quot;parameterId&quot;:null,&quot;bindings&quot;:{},&quot;visible&quot;:true},{&quot;id&quot;:&quot;text-4&quot;,&quot;type&quot;:&quot;text&quot;,&quot;label&quot;:&quot;PWM_Pct&quot;,&quot;x&quot;:69,&quot;y&quot;:41,&quot;width&quot;:43,&quot;height&quot;:20,&quot;text&quot;:&quot;100%&quot;,&quot;fontId&quot;:&quot;builtin-ter-20-bold&quot;,&quot;color&quot;:1,&quot;parameterId&quot;:&quot;text-2-text&quot;,&quot;bindings&quot;:{&quot;text&quot;:true},&quot;visible&quot;:true},{&quot;id&quot;:&quot;text-5&quot;,&quot;type&quot;:&quot;text&quot;,&quot;label&quot;:&quot;Value&quot;,&quot;x&quot;:4,&quot;y&quot;:41,&quot;width&quot;:65,&quot;height&quot;:20,&quot;text&quot;:&quot;Value:&quot;,&quot;fontId&quot;:&quot;builtin-ter-20-bold&quot;,&quot;color&quot;:1,&quot;parameterId&quot;:null,&quot;bindings&quot;:{},&quot;visible&quot;:true}],&quot;fonts&quot;:[{&quot;id&quot;:&quot;builtin-spleen-16&quot;,&quot;name&quot;:&quot;Spleen&quot;,&quot;fileName&quot;:&quot;spleen_16.mfnt&quot;,&quot;data&quot;:&quot;&quot;,&quot;source&quot;:&quot;builtin&quot;,&quot;catalogId&quot;:&quot;spleen-16&quot;},{&quot;id&quot;:&quot;builtin-ter-20-bold&quot;,&quot;name&quot;:&quot;Terminus Bold&quot;,&quot;fileName&quot;:&quot;ter_20_bold.mfnt&quot;,&quot;data&quot;:&quot;&quot;,&quot;source&quot;:&quot;builtin&quot;,&quot;catalogId&quot;:&quot;ter-20-bold&quot;}],&quot;parameters&quot;:[],&quot;extensions&quot;:{&quot;espide.adaptive-display-v1&quot;:{&quot;version&quot;:1,&quot;width&quot;:128,&quot;height&quot;:64,&quot;profileId&quot;:&quot;espide-mono-128x64&quot;,&quot;label&quot;:&quot;128×64&quot;,&quot;source&quot;:&quot;workspace&quot;}},&quot;target&quot;:{&quot;profileId&quot;:&quot;espide-mono-128x64&quot;,&quot;label&quot;:&quot;128×64&quot;,&quot;source&quot;:&quot;workspace&quot;}}"></mutation><field name="PRECOMPUTE_STATIC">TRUE</field><field name="SHOW_DISPLAY">TRUE</field><field name="STORE_SCENE_FILE">FALSE</field><comment pinned="false" h="216.79998779296875" w="421.60003662109375">Display Designer block.
Here you can create a display layout, set the correct size and font style, and specify which values and texts are static and which are controlled by the program.

This example has two dynamic values. One, PWM_Value, displays the value sent to the PWM block and ranges from 0 to 65535 (a 16-bit integer).

The second variable displays the LED power as a percentage.
The encoder returns a value from 0 to 20, which we can multiply by 5 to display a percentage because 20 × 5 = 100.</comment><value name="DDYN_text_2_TEXT"><block type="variables_get" id="IwmN12yM)*0ZWv1DikkJ"><field name="VAR" id="encoder-brightness">led_brightness</field></block></value><value name="DDYN_text_4_TEXT"><block type="text_join" id="HWEOD%LaSfUJr/SVU_4H" inline="true"><mutation items="2"></mutation><comment pinned="false" h="40.4000244140625" w="578.7999267578125">We can combine numbers and strings in text and perform mathematical operations on it.</comment><value name="ADD0"><block type="math_arithmetic" id="DkEMIh=!2F%(m?h+5|`n"><field name="OP">MULTIPLY</field><value name="A"><shadow type="math_number" id="y;Rv9Actw5ZS6MIufWXj"><field name="NUM">1</field></shadow><block type="variables_get" id="!eS.^%5YRBB;iItmJ7Yg"><field name="VAR" id="encoder-position">position</field></block></value><value name="B"><shadow type="math_number" id="+IUuXx,FuR$bn[;!`=4Y"><field name="NUM">5</field></shadow></value></block></value><value name="ADD1"><block type="text" id="326SPrzn4!HuX)qlg$vU"><field name="TEXT">%</field></block></value></block></value><next><block type="pwm.duty_u16" id="encoder-set-brightness"><field name="ID">1</field><value name="duty"><block type="variables_get" id="encoder-brightness-value"><field name="VAR" id="encoder-brightness">led_brightness</field></block></value><next><block type="text_print" id="encoder-print-values"><value name="TEXT"><block type="text_join" id="encoder-values-text"><mutation items="4"></mutation><value name="ADD0"><shadow type="text" id="encoder-position-label"><field name="TEXT">Position: </field></shadow></value><value name="ADD1"><block type="variables_get" id="encoder-position-print"><field name="VAR" id="encoder-position">position</field></block></value><value name="ADD2"><shadow type="text" id="encoder-brightness-label"><field name="TEXT">       PWM: </field></shadow></value><value name="ADD3"><block type="variables_get" id="encoder-brightness-print"><field name="VAR" id="encoder-brightness">led_brightness</field></block></value></block></value><next><block type="utime.delay" id="encoder-loop-wait"><field name="SCALE">sleep_ms</field><comment pinned="false" h="70" w="330">Check the value ten times per second.</comment><value name="TIME"><shadow type="math_number" id="encoder-loop-time"><field name="NUM">100</field></shadow></value></block></next></block></next></block></next></block></next></block></next></block></next></block></statement></block>
