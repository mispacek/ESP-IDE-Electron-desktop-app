<xml xmlns="https://developers.google.com/blockly/xml"><variables><variable id="joystick-x">axis_x</variable><variable id="joystick-y">axis_y</variable></variables><block type="program_start" id="joystick-start" x="60" y="50"><comment pinned="false" h="135" w="410">Connect the joystick as follows: VRX to analog GPIO 1, VRY to analog GPIO 2, SW to GPIO 5, VCC to 3.3 V, and GND to GND. Adjust the pin numbers if your board uses different analog pins.</comment><next><block type="joystick_init" id="joystick-init"><field name="joy_name">1</field><field name="rot">270</field><comment pinned="false" h="102" w="494">Initialize physical joystick number 1. A rotation of 0° keeps the usual X- and Y-axis orientation.

Changing the joystick rotation lets you compensate for how the joystick module is physically mounted in the project.</comment><value name="vrx"><shadow type="math_number" id="joystick-vrx-pin"><field name="NUM">13</field></shadow></value><value name="vry"><shadow type="math_number" id="joystick-vry-pin"><field name="NUM">14</field></shadow></value><value name="sw"><shadow type="math_number" id="joystick-switch-pin"><field name="NUM">15</field></shadow></value><next><block type="text_print" id="joystick-ready-print"><value name="TEXT"><shadow type="text" id="joystick-ready-text"><field name="TEXT">The joystick is ready.</field></shadow></value></block></next></block></next></block><block type="program_loop" id="joystick-loop" x="60" y="380"><comment pinned="false" h="95" w="370">Both axes range approximately from -100 to 100. Near the center, their values are close to zero.</comment><statement name="DO"><block type="variables_set" id="joystick-read-x"><field name="VAR" id="joystick-x">axis_x</field><value name="VALUE"><block type="get_joy_axis_ble" id="joystick-x-value"><field name="joy_name">1</field><field name="axis">X</field></block></value><next><block type="variables_set" id="joystick-read-y"><field name="VAR" id="joystick-y">axis_y</field><value name="VALUE"><block type="get_joy_axis_ble" id="joystick-y-value"><field name="joy_name">1</field><field name="axis">Y</field></block></value><next><block type="text_print" id="joystick-print-axes"><comment pinned="false" h="75" w="350">Print the joystick coordinates to the REPL console.</comment><value name="TEXT"><block type="text_join" id="joystick-axes-text"><mutation items="4"></mutation><value name="ADD0"><shadow type="text" id="joystick-x-label"><field name="TEXT">X: </field></shadow></value><value name="ADD1"><block type="variables_get" id="joystick-x-print"><field name="VAR" id="joystick-x">axis_x</field></block></value><value name="ADD2"><shadow type="text" id="joystick-y-label"><field name="TEXT">      Y: </field></shadow></value><value name="ADD3"><block type="variables_get" id="joystick-y-print"><field name="VAR" id="joystick-y">axis_y</field></block></value></block></value><next><block type="controls_if" id="joystick-direction-if"><mutation elseif="3"></mutation><comment pinned="false" h="100" w="370">A value greater than 40 or less than -40 means the stick is clearly away from the center.</comment><value name="IF0"><block type="logic_compare" id="joystick-up-compare"><field name="OP">GT</field><value name="A"><block type="variables_get" id="joystick-up-y"><field name="VAR" id="joystick-y">axis_y</field></block></value><value name="B"><shadow type="math_number" id="joystick-up-limit"><field name="NUM">40</field></shadow></value></block></value><statement name="DO0"><block type="text_print" id="joystick-up-print"><value name="TEXT"><shadow type="text" id="joystick-up-text"><field name="TEXT">Direction: up</field></shadow></value></block></statement><value name="IF1"><block type="logic_compare" id="joystick-right-compare"><field name="OP">GT</field><value name="A"><block type="variables_get" id="joystick-right-x"><field name="VAR" id="joystick-x">axis_x</field></block></value><value name="B"><shadow type="math_number" id="joystick-right-limit"><field name="NUM">40</field></shadow></value></block></value><statement name="DO1"><block type="text_print" id="joystick-right-print"><value name="TEXT"><shadow type="text" id="joystick-right-text"><field name="TEXT">Direction: right</field></shadow></value></block></statement><value name="IF2"><block type="logic_compare" id="joystick-down-compare"><field name="OP">LT</field><value name="A"><block type="variables_get" id="joystick-down-y"><field name="VAR" id="joystick-y">axis_y</field></block></value><value name="B"><shadow type="math_number" id="joystick-down-limit"><field name="NUM">-40</field></shadow></value></block></value><statement name="DO2"><block type="text_print" id="joystick-down-print"><value name="TEXT"><shadow type="text" id="joystick-down-text"><field name="TEXT">Direction: down</field></shadow></value></block></statement><value name="IF3"><block type="logic_compare" id="joystick-left-compare"><field name="OP">LT</field><value name="A"><block type="variables_get" id="joystick-left-x"><field name="VAR" id="joystick-x">axis_x</field></block></value><value name="B"><shadow type="math_number" id="joystick-left-limit"><field name="NUM">-40</field></shadow></value></block></value><statement name="DO3"><block type="text_print" id="joystick-left-print"><value name="TEXT"><shadow type="text" id="joystick-left-text"><field name="TEXT">Direction: left</field></shadow></value></block></statement><next><block type="controls_if" id="joystick-button-if"><comment pinned="false" h="75" w="350">The stick can also be pressed like a regular button.</comment><value name="IF0"><block type="get_joy_state_ble" id="joystick-button-state"><field name="joy_name">1</field><field name="axis">5</field></block></value><statement name="DO0"><block type="text_print" id="joystick-button-print"><value name="TEXT"><shadow type="text" id="joystick-button-text"><field name="TEXT">The joystick button is pressed.</field></shadow></value></block></statement><next><block type="utime.delay" id="joystick-loop-wait"><field name="SCALE">sleep_ms</field><comment pinned="false" h="70" w="330">Update the values five times per second.</comment><value name="TIME"><shadow type="math_number" id="joystick-loop-time"><field name="NUM">200</field></shadow></value></block></next></block></next></block></next></block></next></block></next></block></statement></block>
  <!--ESPIDE_EXTENSIONS_BEGIN-->
eyJ2ZXJzaW9uIjoxLCJwcm9jZXNzb3IiOiJTaW11bGF0b3IiLCJleHRlbnNpb25zIjpbXX0=
