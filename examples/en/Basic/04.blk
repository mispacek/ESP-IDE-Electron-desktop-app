<xml xmlns="https://developers.google.com/blockly/xml"><variables><variable id="dimmer-analog">analog_value</variable><variable id="dimmer-voltage">voltage</variable><variable id="dimmer-brightness">led_brightness</variable></variables><block type="program_start" id="dimmer-start" x="60" y="50"><comment pinned="false" h="90" w="350">Connect the LED through a 160-500 ohm resistor between the selected pin and GND. Connect the outer potentiometer terminals to 3.3 V and GND, and the center terminal to an analog pin on the development board.</comment><next><block type="pwm_RP2040" id="dimmer-pwm-init"><field name="ID">1</field><comment pinned="false" h="75" w="330">Start PWM at 1000 Hz with an initial brightness of 0, so the LED is off.</comment><value name="pin"><shadow type="math_number" id="dimmer-led-pin"><field name="NUM">1</field></shadow></value><value name="frequency"><shadow type="math_number" id="dimmer-frequency"><field name="NUM">1000</field></shadow></value><value name="duty"><shadow type="math_number" id="dimmer-duty-zero"><field name="NUM">0</field></shadow></value><next><block type="text_print" id="dimmer-ready-print"><comment pinned="false" h="55" w="342">Print the selected information to the REPL console (at the bottom of the screen).</comment><value name="TEXT"><shadow type="text" id="dimmer-ready-text"><field name="TEXT">The dimmer is ready.</field></shadow></value></block></next></block></next></block><block type="program_loop" id="dimmer-loop" x="60" y="330"><comment pinned="false" h="75" w="340">The loop repeatedly reads the potentiometer, recalculates the values, and sets the LED brightness.</comment><statement name="DO"><block type="variables_set" id="dimmer-read-analog"><field name="VAR" id="dimmer-analog">analog_value</field><comment pinned="false" h="56" w="350">The selected analog input returns a value from 0 to 65535.</comment><value name="VALUE"><block type="RP2040_adc" id="dimmer-adc-read"><field name="Width: ">1</field><value name="pin"><shadow type="math_number" id="dimmer-adc-pin"><field name="NUM">10</field></shadow></value></block></value><next><block type="variables_set" id="dimmer-convert-voltage"><field name="VAR" id="dimmer-voltage">voltage</field><comment pinned="false" h="80" w="421">Calculate the maximum value (3.3 V) from the analog input range of 0-65535 and store it in the "voltage" variable.</comment><value name="VALUE"><block type="zmena_rozsahu" id="dimmer-voltage-map"><field name="celociselne">FALSE</field><field name="limitovat">TRUE</field><value name="in_value"><block type="variables_get" id="dimmer-voltage-source"><field name="VAR" id="dimmer-analog">analog_value</field></block></value><value name="in_min"><shadow type="math_number" id="dimmer-voltage-in-min"><field name="NUM">0</field></shadow></value><value name="in_max"><shadow type="math_number" id="dimmer-voltage-in-max"><field name="NUM">65535</field></shadow></value><value name="out_min"><shadow type="math_number" id="dimmer-voltage-out-min"><field name="NUM">0</field></shadow></value><value name="out_max"><shadow type="math_number" id="dimmer-voltage-out-max"><field name="NUM">3.3</field></shadow></value></block></value><next><block type="variables_set" id="dimmer-convert-brightness"><field name="VAR" id="dimmer-brightness">led_brightness</field><comment pinned="false" h="105" w="360">PWM uses the same range as the analog value: 0 to 65535. The analog input value can be sent directly as the PWM value for the LED.</comment><value name="VALUE"><block type="variables_get" id="`mj28(/S4;/?a#XBp`zM"><field name="VAR" id="dimmer-analog">analog_value</field></block></value><next><block type="pwm.duty_u16" id="dimmer-set-duty"><field name="ID">1</field><comment pinned="false" h="70" w="320">Use the new PWM value to smoothly set the LED brightness on the selected output pin. </comment><value name="duty"><block type="variables_get" id="dimmer-duty-value"><field name="VAR" id="dimmer-brightness">led_brightness</field></block></value><next><block type="text_print" id="dimmer-print-voltage"><comment pinned="false" h="75" w="330">Display the currently calculated voltage in the REPL console.</comment><value name="TEXT"><block type="text_join" id="dimmer-voltage-text"><mutation items="3"></mutation><value name="ADD0"><shadow type="text" id="dimmer-voltage-label"><field name="TEXT">Voltage: </field></shadow></value><value name="ADD1"><block type="variables_get" id="dimmer-print-voltage-value"><field name="VAR" id="dimmer-voltage">voltage</field></block></value><value name="ADD2"><shadow type="text" id="dimmer-voltage-unit"><field name="TEXT"> V</field></shadow></value></block></value><next><block type="utime.delay" id="dimmer-loop-wait"><field name="SCALE">sleep_ms</field><comment pinned="false" h="70" w="320">Update the value ten times per second to keep the output easy to read.</comment><value name="TIME"><shadow type="math_number" id="dimmer-loop-time"><field name="NUM">100</field></shadow></value></block></next></block></next></block></next></block></next></block></next></block></statement></block>
  <!--ESPIDE_EXTENSIONS_BEGIN-->
eyJ2ZXJzaW9uIjoxLCJwcm9jZXNzb3IiOiJTaW11bGF0b3IiLCJleHRlbnNpb25zIjpbXX0=
<!--ESPIDE_EXTENSIONS_END-->
</xml>