<xml xmlns="https://developers.google.com/blockly/xml"><block type="program_start" id="traffic-start" x="50" y="50"><comment pinned="false" h="105" w="370">Connect the red LED to GPIO 1, the yellow LED to GPIO 2, and the green LED to GPIO 3. Each LED must have its own resistor and its other terminal connected to GND.</comment><next><block type="gpio_set" id="x9iMkYl?%uvJ0e;nkE_k"><value name="pin"><shadow type="math_number" id="lxDGy5[.jj%$*F?SFMJ:"><field name="NUM">1</field></shadow></value><value name="value"><shadow type="math_number" id="~)!7pW.B=$}(~sueH(P/"><field name="NUM">0</field></shadow></value><next><block type="gpio_set" id="`w.IP@nk_3@K2OvK_f=~"><value name="pin"><shadow type="math_number" id="sWYyzdR.8$b3zXd~0JJg"><field name="NUM">2</field></shadow></value><value name="value"><shadow type="math_number" id=":Rl#Y5/zN-g%DR|WPvh~"><field name="NUM">0</field></shadow></value><next><block type="gpio_set" id="W/Z7@A(fX]qr7jD~+}Kh"><value name="pin"><shadow type="math_number" id="_XiB,$Ai)Zri:6v`)SCf"><field name="NUM">3</field></shadow></value><value name="value"><shadow type="math_number" id="rqqI3);7=tG;,+EVnfj8"><field name="NUM">0</field></shadow></value></block></next></block></next></block></next></block><block type="procedures_defnoreturn" id="traffic-procedure-red" x="440" y="50"><field name="NAME">stop</field><comment pinned="false" h="75" w="330">STOP state: only the red LED is on. The procedure (function) always sets all three outputs.</comment><statement name="STACK"><block type="gpio_set" id="traffic-red-red-on"><value name="pin"><shadow type="math_number" id="traffic-red-red-pin"><field name="NUM">1</field></shadow></value><value name="value"><shadow type="math_number" id="traffic-red-red-value"><field name="NUM">1</field></shadow></value><next><block type="gpio_set" id="traffic-red-yellow-off"><value name="pin"><shadow type="math_number" id="traffic-red-yellow-pin"><field name="NUM">2</field></shadow></value><value name="value"><shadow type="math_number" id="traffic-red-yellow-value"><field name="NUM">0</field></shadow></value><next><block type="gpio_set" id="traffic-red-green-off"><value name="pin"><shadow type="math_number" id="traffic-red-green-pin"><field name="NUM">3</field></shadow></value><value name="value"><shadow type="math_number" id="traffic-red-green-value"><field name="NUM">0</field></shadow></value></block></next></block></next></block></statement></block><block type="procedures_defnoreturn" id="traffic-procedure-red-yellow" x="740" y="50"><field name="NAME">get_ready</field><comment pinned="false" h="75" w="340">GET READY state: the red and yellow LEDs are on, while the green LED is off.</comment><statement name="STACK"><block type="gpio_set" id="traffic-red-yellow-red-on"><value name="pin"><shadow type="math_number" id="traffic-red-yellow-red-pin"><field name="NUM">1</field></shadow></value><value name="value"><shadow type="math_number" id="traffic-red-yellow-red-value"><field name="NUM">1</field></shadow></value><next><block type="gpio_set" id="traffic-red-yellow-yellow-on"><value name="pin"><shadow type="math_number" id="traffic-red-yellow-yellow-pin"><field name="NUM">2</field></shadow></value><value name="value"><shadow type="math_number" id="traffic-red-yellow-yellow-value"><field name="NUM">1</field></shadow></value><next><block type="gpio_set" id="traffic-red-yellow-green-off"><value name="pin"><shadow type="math_number" id="traffic-red-yellow-green-pin"><field name="NUM">3</field></shadow></value><value name="value"><shadow type="math_number" id="traffic-red-yellow-green-value"><field name="NUM">0</field></shadow></value></block></next></block></next></block></statement></block><block type="program_loop" id="traffic-loop" x="52" y="291"><comment pinned="false" h="85" w="350">The main program only calls the individual traffic-light states. The LED settings are clearly kept inside the procedures (functions).</comment><statement name="DO"><block type="procedures_callnoreturn" id="traffic-call-red"><mutation name="stop"></mutation><next><block type="utime.delay" id="traffic-red-wait"><field name="SCALE">sleep</field><value name="TIME"><shadow type="math_number" id="traffic-red-time"><field name="NUM">3</field></shadow></value><next><block type="procedures_callnoreturn" id="traffic-call-red-yellow"><mutation name="get_ready"></mutation><next><block type="utime.delay" id="traffic-red-yellow-wait"><field name="SCALE">sleep</field><value name="TIME"><shadow type="math_number" id="traffic-red-yellow-time"><field name="NUM">1</field></shadow></value><next><block type="procedures_callnoreturn" id="traffic-call-green"><mutation name="go"></mutation><next><block type="utime.delay" id="traffic-green-wait"><field name="SCALE">sleep</field><value name="TIME"><shadow type="math_number" id="traffic-green-time"><field name="NUM">3</field></shadow></value><next><block type="procedures_callnoreturn" id="traffic-call-yellow"><mutation name="caution"></mutation><next><block type="utime.delay" id="traffic-yellow-wait"><field name="SCALE">sleep</field><value name="TIME"><shadow type="math_number" id="traffic-yellow-time"><field name="NUM">1</field></shadow></value></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></statement></block><block type="procedures_defnoreturn" id="traffic-procedure-green" x="440" y="390"><field name="NAME">go</field><comment pinned="false" h="75" w="330">GO state: only the green LED is on. The red and yellow LEDs are off.</comment><statement name="STACK"><block type="gpio_set" id="traffic-green-red-off"><value name="pin"><shadow type="math_number" id="traffic-green-red-pin"><field name="NUM">1</field></shadow></value><value name="value"><shadow type="math_number" id="traffic-green-red-value"><field name="NUM">0</field></shadow></value><next><block type="gpio_set" id="traffic-green-yellow-off"><value name="pin"><shadow type="math_number" id="traffic-green-yellow-pin"><field name="NUM">2</field></shadow></value><value name="value"><shadow type="math_number" id="traffic-green-yellow-value"><field name="NUM">0</field></shadow></value><next><block type="gpio_set" id="traffic-green-green-on"><value name="pin"><shadow type="math_number" id="traffic-green-green-pin"><field name="NUM">3</field></shadow></value><value name="value"><shadow type="math_number" id="traffic-green-green-value"><field name="NUM">1</field></shadow></value></block></next></block></next></block></statement></block><block type="procedures_defnoreturn" id="traffic-procedure-yellow" x="740" y="390"><field name="NAME">caution</field><comment pinned="false" h="75" w="330">CAUTION state: only the yellow LED is on. The red and green LEDs are off.</comment><statement name="STACK"><block type="gpio_set" id="traffic-yellow-red-off"><value name="pin"><shadow type="math_number" id="traffic-yellow-red-pin"><field name="NUM">1</field></shadow></value><value name="value"><shadow type="math_number" id="traffic-yellow-red-value"><field name="NUM">0</field></shadow></value><next><block type="gpio_set" id="traffic-yellow-yellow-on"><value name="pin"><shadow type="math_number" id="traffic-yellow-yellow-pin"><field name="NUM">2</field></shadow></value><value name="value"><shadow type="math_number" id="traffic-yellow-yellow-value"><field name="NUM">1</field></shadow></value><next><block type="gpio_set" id="traffic-yellow-green-off"><value name="pin"><shadow type="math_number" id="traffic-yellow-green-pin"><field name="NUM">3</field></shadow></value><value name="value"><shadow type="math_number" id="traffic-yellow-green-value"><field name="NUM">0</field></shadow></value></block></next></block></next></block></statement></block>
