<xml xmlns="https://developers.google.com/blockly/xml"><variables><variable id="rainbow-pixel">led</variable><variable id="rainbow-hue">odstin</variable></variables><block type="program_start" id="rainbow-start" x="50" y="50"><comment pinned="false" h="105" w="380">Pásek s 8x NeoPixel LED připojte datovým vstupem na GPIO 29. Napájení pásku zapojte podle jeho typu a propojte GND pásku s GND desky.</comment><next><block type="neopixel_init" id="rainbow-init-strip"><comment pinned="false" h="70" w="330">Inicializujeme pásek s osmi adresovatelnými neopixel LED. Na GPIO29</comment><value name="pin"><shadow type="math_number" id="rainbow-pin"><field name="NUM">29</field></shadow></value><value name="number"><shadow type="math_number" id="rainbow-count"><field name="NUM">8</field></shadow></value><next><block type="variables_set" id="rainbow-reset-hue"><field name="VAR" id="rainbow-hue">odstin</field><comment pinned="false" h="107" w="758">Výchozí hodnota odstínu. Odstín si představte jako barevné kolečko, ve kterém jsou všechny barvy duhy. 

https://developer.mozilla.org/en-US/docs/Web/CSS/Reference/Values/hue</comment><value name="VALUE"><shadow type="math_number" id="rainbow-hue-zero"><field name="NUM">0</field></shadow></value><next><block type="text_print" id="rainbow-ready-print"><value name="TEXT"><shadow type="text" id="rainbow-ready-text"><field name="TEXT">NeoPixel duha</field></shadow></value></block></next></block></next></block></next></block><block type="program_loop" id="rainbow-loop" x="51" y="278"><comment pinned="false" h="85" w="350">Každé LED přiřadíme odstín posunutý o 45°. Osm LED tak rovnoměrně pokryje celý barevný kruh.</comment><statement name="DO"><block type="controls_for" id="rainbow-for-pixels"><field name="VAR" id="rainbow-pixel">led</field><comment pinned="false" h="54" w="317">Smyčka, která udělá 8 průchodů (0-7)
každý průchod se mění proměnná LED o 1</comment><value name="FROM"><shadow type="math_number" id="rainbow-from"><field name="NUM">0</field></shadow></value><value name="TO"><shadow type="math_number" id="rainbow-to"><field name="NUM">7</field></shadow></value><value name="BY"><shadow type="math_number" id="rainbow-by"><field name="NUM">1</field></shadow></value><statement name="DO"><block type="neopixel_control" id="rainbow-set-pixel"><comment pinned="false" h="100" w="360">HSL barvu převedeme na RGB. Modulo 360 udrží vypočtený odstín v rozsahu barevného kruhu.</comment><value name="address"><block type="variables_get" id="rainbow-pixel-address"><field name="VAR" id="rainbow-pixel">led</field><comment pinned="false" h="72" w="216">Určuje pořadí neopixelu
0 je první neopixel
7 je poslední neopixel</comment></block></value><value name="color"><block type="HSL_to_RGB" id="rainbow-hsl-color"><comment pinned="false" h="81" w="302">Blok pro přepočet Odstínu, sytosti a světlosti na RGB barvu.  Povolené rozsahy proměnných jsou v hranatých závorkách</comment><value name="hue"><block type="math_modulo" id="rainbow-pixel-hue-modulo"><value name="DIVIDEND"><block type="math_arithmetic" id="rainbow-pixel-hue-add"><field name="OP">ADD</field><comment pinned="false" h="89" w="252">K základnímu odstínu přičteme ještě posun pro každou LED, aby každá led měla jiný odstín a vytvořili jsme tak duhu</comment><value name="A"><block type="variables_get" id="rainbow-base-hue"><field name="VAR" id="rainbow-hue">odstin</field></block></value><value name="B"><block type="math_arithmetic" id="rainbow-pixel-offset"><field name="OP">MULTIPLY</field><comment pinned="false" h="48" w="292">Každý neopixel má odstín posunutý o 45° na barevném kruhu</comment><value name="A"><block type="variables_get" id="rainbow-pixel-index"><field name="VAR" id="rainbow-pixel">led</field></block></value><value name="B"><shadow type="math_number" id="rainbow-hue-step"><field name="NUM">45</field></shadow></value></block></value></block></value><value name="DIVISOR"><shadow type="math_number" id="rainbow-circle"><field name="NUM">360</field></shadow></value></block></value><value name="saturation"><shadow type="math_number" id="rainbow-saturation"><field name="NUM">100</field></shadow></value><value name="lightness"><shadow type="math_number" id="rainbow-lightness"><field name="NUM">50</field></shadow></value></block></value></block></statement><next><block type="neopixel_write" id="rainbow-show"><comment pinned="false" h="65" w="320">Po nastavení všech osmi LED odešleme barvy do pásku najednou.</comment><next><block type="math_change" id="rainbow-increment-hue"><field name="VAR" id="rainbow-hue">odstin</field><comment pinned="false" h="75" w="363">V Každém průchodu posouváme odstín o 3 kroky.

Změnou odstínu vznikne plynulý pohyb duhy.</comment><value name="DELTA"><shadow type="math_number" id="rainbow-animation-step"><field name="NUM">3</field></shadow></value><next><block type="utime.delay" id="rainbow-delay"><field name="SCALE">sleep_ms</field><comment pinned="false" h="53" w="409">Krátká čekací smyčka, aby animace nebyla moc rychlá</comment><value name="TIME"><shadow type="math_number" id="rainbow-delay-time"><field name="NUM">20</field></shadow></value></block></next></block></next></block></next></block></statement></block>
  <!--ESPIDE_EXTENSIONS_BEGIN-->
