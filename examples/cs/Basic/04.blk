<xml xmlns="https://developers.google.com/blockly/xml"><variables><variable id="dimmer-analog">analogova_hodnota</variable><variable id="dimmer-voltage">napeti</variable><variable id="dimmer-brightness">jas_led</variable></variables><block type="program_start" id="dimmer-start" x="60" y="50"><comment pinned="false" h="90" w="350">LED připojte přes rezistor 160-500 Ohm mezi zvolený pin a GND. Potenciometr: krajní vývody na 3,3 V a GND, prostřední na analogový pin vývojové desky.</comment><next><block type="pwm_RP2040" id="dimmer-pwm-init"><field name="ID">1</field><comment pinned="false" h="75" w="330">PWM zapínáme s frekvencí 1000 Hz a počátečním jasem 0, tedy zhasnuto.</comment><value name="pin"><shadow type="math_number" id="dimmer-led-pin"><field name="NUM">1</field></shadow></value><value name="frequency"><shadow type="math_number" id="dimmer-frequency"><field name="NUM">1000</field></shadow></value><value name="duty"><shadow type="math_number" id="dimmer-duty-zero"><field name="NUM">0</field></shadow></value><next><block type="text_print" id="dimmer-ready-print"><comment pinned="false" h="55" w="342">Do REPL konzole (ve spodní části obrazovky) vypíšeme zvolenou informaci.</comment><value name="TEXT"><shadow type="text" id="dimmer-ready-text"><field name="TEXT">Stmívač je připravený.</field></shadow></value></block></next></block></next></block><block type="program_loop" id="dimmer-loop" x="60" y="330"><comment pinned="false" h="75" w="340">Smyčka opakovaně měří hodnotu potenciometru, přepočítá hodnoty a nastaví jas LED.</comment><statement name="DO"><block type="variables_set" id="dimmer-read-analog"><field name="VAR" id="dimmer-analog">analogova_hodnota</field><comment pinned="false" h="56" w="350">Vstup na zvoleném analogovém pinu vrací hodnotu od 0 do 65535.</comment><value name="VALUE"><block type="RP2040_adc" id="dimmer-adc-read"><field name="Width: ">1</field><value name="pin"><shadow type="math_number" id="dimmer-adc-pin"><field name="NUM">10</field></shadow></value></block></value><next><block type="variables_set" id="dimmer-convert-voltage"><field name="VAR" id="dimmer-voltage">napeti</field><comment pinned="false" h="80" w="421">Maximální hodnotu (3.3V) si vypočítáme z rozsahu analogového vstupu 0-65535 a zapíšeme do proměnné "napeti"</comment><value name="VALUE"><block type="zmena_rozsahu" id="dimmer-voltage-map"><field name="celociselne">FALSE</field><field name="limitovat">TRUE</field><value name="in_value"><block type="variables_get" id="dimmer-voltage-source"><field name="VAR" id="dimmer-analog">analogova_hodnota</field></block></value><value name="in_min"><shadow type="math_number" id="dimmer-voltage-in-min"><field name="NUM">0</field></shadow></value><value name="in_max"><shadow type="math_number" id="dimmer-voltage-in-max"><field name="NUM">65535</field></shadow></value><value name="out_min"><shadow type="math_number" id="dimmer-voltage-out-min"><field name="NUM">0</field></shadow></value><value name="out_max"><shadow type="math_number" id="dimmer-voltage-out-max"><field name="NUM">3.3</field></shadow></value></block></value><next><block type="variables_set" id="dimmer-convert-brightness"><field name="VAR" id="dimmer-brightness">jas_led</field><comment pinned="false" h="105" w="360">PWM má stejný rozsah jako Analogová hodnota : 0 až 65535. Hodnotu z Analogového vstupu můžeme poslat rovnou jako hodnotu PWM pro LED.</comment><value name="VALUE"><block type="variables_get" id="`mj28(/S4;/?a#XBp`zM"><field name="VAR" id="dimmer-analog">analogova_hodnota</field></block></value><next><block type="pwm.duty_u16" id="dimmer-set-duty"><field name="ID">1</field><comment pinned="false" h="70" w="320">Novou hodnotou PWM plynule nastavíme jas LED na výstupu zvoleného analogového pinu. </comment><value name="duty"><block type="variables_get" id="dimmer-duty-value"><field name="VAR" id="dimmer-brightness">jas_led</field></block></value><next><block type="text_print" id="dimmer-print-voltage"><comment pinned="false" h="75" w="330">Aktuální vypočtené napětí zobrazíme v REPL konzoli.</comment><value name="TEXT"><block type="text_join" id="dimmer-voltage-text"><mutation items="3"></mutation><value name="ADD0"><shadow type="text" id="dimmer-voltage-label"><field name="TEXT">Napětí: </field></shadow></value><value name="ADD1"><block type="variables_get" id="dimmer-print-voltage-value"><field name="VAR" id="dimmer-voltage">napeti</field></block></value><value name="ADD2"><shadow type="text" id="dimmer-voltage-unit"><field name="TEXT"> V</field></shadow></value></block></value><next><block type="utime.delay" id="dimmer-loop-wait"><field name="SCALE">sleep_ms</field><comment pinned="false" h="70" w="320">Hodnotu obnovujeme desetkrát za sekundu, aby byl výpis přehledný.</comment><value name="TIME"><shadow type="math_number" id="dimmer-loop-time"><field name="NUM">100</field></shadow></value></block></next></block></next></block></next></block></next></block></next></block></statement></block>
  <!--ESPIDE_EXTENSIONS_BEGIN-->
eyJ2ZXJzaW9uIjoxLCJwcm9jZXNzb3IiOiJTaW11bGF0b3IiLCJleHRlbnNpb25zIjpbXX0=
<!--ESPIDE_EXTENSIONS_END-->
</xml>