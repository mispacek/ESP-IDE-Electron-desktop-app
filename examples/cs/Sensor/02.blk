<xml xmlns="https://developers.google.com/blockly/xml"><variables><variable id="encoder-position">poloha</variable><variable id="encoder-brightness">jas_led</variable></variables><block type="program_start" id="encoder-start" x="60" y="50"><comment pinned="false" h="135" w="410">Rotační enkodér zapojte: A na GPIO18, B na GPIO19 a GND na GND. Použijte modul s pull-up odpory nebo přidejte odpory 10 kΩ k 3,3 V. LED připojte přes rezistor na GPIO 1.</comment><next><block type="oled_init" id="Y%leO8aAL-C=n`0rUe2H"><mutation xmlns="http://www.w3.org/1999/xhtml" display_type="AUTO"></mutation><field name="DISPLAY_TYPE">AUTO</field><comment pinned="false" h="76.39999389648438" w="264.39996337890625">Inicializace I2C OLED s řadičem SSD1306 na pinech SDA: GPIO21 a SCL: GPIO22</comment><data>@espide-display-target-used:2</data><value name="SDA_PIN"><shadow type="math_number" id="C}2-qsTUuY4=C1X1xf$?"><field name="NUM">21</field></shadow></value><value name="SCL_PIN"><shadow type="math_number" id="k-XR$t~Unb$lD|j~7OaX"><field name="NUM">22</field></shadow></value><next><block type="encoder_init" id="encoder-init"><field name="index">1</field><comment pinned="false" h="95" w="360">Jeden celý krok enkodéru změní hodnotu o 1. Směr lze obrátit zaškrtnutím volby.</comment><value name="A"><shadow type="math_number" id="encoder-pin-a"><field name="NUM">18</field></shadow></value><value name="B"><shadow type="math_number" id="encoder-pin-b"><field name="NUM">19</field></shadow></value><value name="reverse"><shadow type="logic_boolean" id="encoder-reverse"><field name="BOOL">FALSE</field></shadow></value><value name="scale"><shadow type="math_number" id="encoder-scale"><field name="NUM">1</field></shadow></value><next><block type="encoder_set" id="encoder-reset"><field name="index">1</field><comment pinned="false" h="70" w="330">Po zapnutí začínáme na poloze 0.</comment><value name="Val"><shadow type="math_number" id="encoder-zero"><field name="NUM">0</field></shadow></value><next><block type="pwm_RP2040" id="encoder-pwm-init"><field name="ID">1</field><comment pinned="false" h="85" w="350">PWM na GPIO 1 umožní měnit jas LED plynule, ne pouze zapnout nebo vypnout.</comment><value name="pin"><shadow type="math_number" id="encoder-led-pin"><field name="NUM">1</field></shadow></value><value name="frequency"><shadow type="math_number" id="encoder-pwm-frequency"><field name="NUM">1000</field></shadow></value><value name="duty"><shadow type="math_number" id="encoder-pwm-zero"><field name="NUM">0</field></shadow></value><next><block type="text_print" id="encoder-ready-print"><value name="TEXT"><shadow type="text" id="encoder-ready-text"><field name="TEXT">Ovládání jasu je připravené.</field></shadow></value></block></next></block></next></block></next></block></next></block></next></block><block type="program_loop" id="encoder-loop" x="60" y="500"><comment pinned="false" h="95" w="370">Polohu omezíme na hodnoty 0 až 20. Na krajích se proto jas už dál nemění.</comment><statement name="DO"><block type="variables_set" id="encoder-read-position"><field name="VAR" id="encoder-position">poloha</field><value name="VALUE"><block type="math_constrain" id="encoder-limit-position"><value name="VALUE"><block type="encoder_get" id="encoder-position-value"><field name="index">1</field></block></value><value name="LOW"><shadow type="math_number" id="encoder-low"><field name="NUM">0</field></shadow></value><value name="HIGH"><shadow type="math_number" id="encoder-high"><field name="NUM">20</field></shadow></value></block></value><next><block type="encoder_set" id="encoder-write-limited-position"><field name="index">1</field><comment pinned="false" h="80" w="350">Omezenou hodnotu zapíšeme zpět, aby enkodér nemohl počítat pod 0 ani nad 20.</comment><value name="Val"><block type="variables_get" id="encoder-limited-position"><field name="VAR" id="encoder-position">poloha</field></block></value><next><block type="variables_set" id="encoder-convert-brightness"><field name="VAR" id="encoder-brightness">jas_led</field><comment pinned="false" h="100" w="370">Rozsah polohy 0 až 20 převedeme na celý rozsah PWM 0 až 65535.</comment><value name="VALUE"><block type="zmena_rozsahu" id="encoder-brightness-map"><field name="celociselne">TRUE</field><field name="limitovat">TRUE</field><value name="in_value"><block type="variables_get" id="encoder-map-position"><field name="VAR" id="encoder-position">poloha</field></block></value><value name="in_min"><shadow type="math_number" id="encoder-map-in-min"><field name="NUM">0</field></shadow></value><value name="in_max"><shadow type="math_number" id="encoder-map-in-max"><field name="NUM">20</field></shadow></value><value name="out_min"><shadow type="math_number" id="encoder-map-out-min"><field name="NUM">0</field></shadow></value><value name="out_max"><shadow type="math_number" id="encoder-map-out-max"><field name="NUM">65535</field></shadow></value></block></value><next><block type="espide_display_designer" id="TY)d6a5#P5FN5Eo_J{yB"><mutation xmlns="http://www.w3.org/1999/xhtml" display_designer_version="1" scene="{&quot;schema&quot;:&quot;espide.display-designer&quot;,&quot;version&quot;:1,&quot;width&quot;:128,&quot;height&quot;:64,&quot;mode&quot;:&quot;mono&quot;,&quot;name&quot;:&quot;Obrazovka&quot;,&quot;layers&quot;:[{&quot;id&quot;:&quot;rect-2&quot;,&quot;type&quot;:&quot;rect&quot;,&quot;label&quot;:&quot;&quot;,&quot;x&quot;:0,&quot;y&quot;:0,&quot;width&quot;:128,&quot;height&quot;:16,&quot;radius&quot;:5,&quot;filled&quot;:false,&quot;color&quot;:1,&quot;bindings&quot;:{},&quot;visible&quot;:true},{&quot;id&quot;:&quot;text-1&quot;,&quot;type&quot;:&quot;text&quot;,&quot;label&quot;:&quot;&quot;,&quot;x&quot;:15,&quot;y&quot;:1,&quot;width&quot;:98,&quot;height&quot;:16,&quot;text&quot;:&quot;Encoder PWM&quot;,&quot;fontId&quot;:&quot;builtin-spleen-16&quot;,&quot;color&quot;:1,&quot;parameterId&quot;:null,&quot;bindings&quot;:{},&quot;visible&quot;:true},{&quot;id&quot;:&quot;text-2&quot;,&quot;type&quot;:&quot;text&quot;,&quot;label&quot;:&quot;PWM_Value&quot;,&quot;x&quot;:69,&quot;y&quot;:21,&quot;width&quot;:54,&quot;height&quot;:20,&quot;text&quot;:&quot;65535&quot;,&quot;fontId&quot;:&quot;builtin-ter-20-bold&quot;,&quot;color&quot;:1,&quot;parameterId&quot;:&quot;text-2-text&quot;,&quot;bindings&quot;:{&quot;text&quot;:true},&quot;visible&quot;:true},{&quot;id&quot;:&quot;text-3&quot;,&quot;type&quot;:&quot;text&quot;,&quot;label&quot;:&quot;PWM&quot;,&quot;x&quot;:26,&quot;y&quot;:21,&quot;width&quot;:43,&quot;height&quot;:20,&quot;text&quot;:&quot;PWM:&quot;,&quot;fontId&quot;:&quot;builtin-ter-20-bold&quot;,&quot;color&quot;:1,&quot;parameterId&quot;:null,&quot;bindings&quot;:{},&quot;visible&quot;:true},{&quot;id&quot;:&quot;text-4&quot;,&quot;type&quot;:&quot;text&quot;,&quot;label&quot;:&quot;PWM_Pct&quot;,&quot;x&quot;:69,&quot;y&quot;:41,&quot;width&quot;:43,&quot;height&quot;:20,&quot;text&quot;:&quot;100%&quot;,&quot;fontId&quot;:&quot;builtin-ter-20-bold&quot;,&quot;color&quot;:1,&quot;parameterId&quot;:&quot;text-2-text&quot;,&quot;bindings&quot;:{&quot;text&quot;:true},&quot;visible&quot;:true},{&quot;id&quot;:&quot;text-5&quot;,&quot;type&quot;:&quot;text&quot;,&quot;label&quot;:&quot;Value&quot;,&quot;x&quot;:4,&quot;y&quot;:41,&quot;width&quot;:65,&quot;height&quot;:20,&quot;text&quot;:&quot;Value:&quot;,&quot;fontId&quot;:&quot;builtin-ter-20-bold&quot;,&quot;color&quot;:1,&quot;parameterId&quot;:null,&quot;bindings&quot;:{},&quot;visible&quot;:true}],&quot;fonts&quot;:[{&quot;id&quot;:&quot;builtin-spleen-16&quot;,&quot;name&quot;:&quot;Spleen&quot;,&quot;fileName&quot;:&quot;spleen_16.mfnt&quot;,&quot;data&quot;:&quot;&quot;,&quot;source&quot;:&quot;builtin&quot;,&quot;catalogId&quot;:&quot;spleen-16&quot;},{&quot;id&quot;:&quot;builtin-ter-20-bold&quot;,&quot;name&quot;:&quot;Terminus Bold&quot;,&quot;fileName&quot;:&quot;ter_20_bold.mfnt&quot;,&quot;data&quot;:&quot;&quot;,&quot;source&quot;:&quot;builtin&quot;,&quot;catalogId&quot;:&quot;ter-20-bold&quot;}],&quot;parameters&quot;:[],&quot;extensions&quot;:{&quot;espide.adaptive-display-v1&quot;:{&quot;version&quot;:1,&quot;width&quot;:128,&quot;height&quot;:64,&quot;profileId&quot;:&quot;espide-mono-128x64&quot;,&quot;label&quot;:&quot;128×64&quot;,&quot;source&quot;:&quot;workspace&quot;}},&quot;target&quot;:{&quot;profileId&quot;:&quot;espide-mono-128x64&quot;,&quot;label&quot;:&quot;128×64&quot;,&quot;source&quot;:&quot;workspace&quot;}}"></mutation><field name="PRECOMPUTE_STATIC">TRUE</field><field name="SHOW_DISPLAY">TRUE</field><field name="STORE_SCENE_FILE">FALSE</field><comment pinned="false" h="216.79998779296875" w="421.60003662109375">Blok pro grafický návrh displeje.
Zde je možné si připravt návrh zobrazení, nastavit správnou velikost a styl fontu a také určit, které hodnoty a texty jsou statické a které se budou řídit programem.

V našem příkladu máme dvě dynamické hodnoty, jedna PWM_Value zobrazuje hodnotu, která jde do PWM bloku a má rozsah 0-65535 (16bit celé číslo)

Druhá proměnná je zobrazení procent výkonu LED.
Enkodér nám vrací hodnotu 0-20 a pro zobrazení procent ji můžeme vynásobit 5x protože 20x5 = 100</comment><value name="DDYN_text_2_TEXT"><block type="variables_get" id="IwmN12yM)*0ZWv1DikkJ"><field name="VAR" id="encoder-brightness">jas_led</field></block></value><value name="DDYN_text_4_TEXT"><block type="text_join" id="HWEOD%LaSfUJr/SVU_4H" inline="true"><mutation items="2"></mutation><comment pinned="false" h="40.4000244140625" w="578.7999267578125">Text můžeme skládat z čísel i stringů a provádět v něm matematické operace</comment><value name="ADD0"><block type="math_arithmetic" id="DkEMIh=!2F%(m?h+5|`n"><field name="OP">MULTIPLY</field><value name="A"><shadow type="math_number" id="y;Rv9Actw5ZS6MIufWXj"><field name="NUM">1</field></shadow><block type="variables_get" id="!eS.^%5YRBB;iItmJ7Yg"><field name="VAR" id="encoder-position">poloha</field></block></value><value name="B"><shadow type="math_number" id="+IUuXx,FuR$bn[;!`=4Y"><field name="NUM">5</field></shadow></value></block></value><value name="ADD1"><block type="text" id="326SPrzn4!HuX)qlg$vU"><field name="TEXT">%</field></block></value></block></value><next><block type="pwm.duty_u16" id="encoder-set-brightness"><field name="ID">1</field><value name="duty"><block type="variables_get" id="encoder-brightness-value"><field name="VAR" id="encoder-brightness">jas_led</field></block></value><next><block type="text_print" id="encoder-print-values"><value name="TEXT"><block type="text_join" id="encoder-values-text"><mutation items="4"></mutation><value name="ADD0"><shadow type="text" id="encoder-position-label"><field name="TEXT">Poloha: </field></shadow></value><value name="ADD1"><block type="variables_get" id="encoder-position-print"><field name="VAR" id="encoder-position">poloha</field></block></value><value name="ADD2"><shadow type="text" id="encoder-brightness-label"><field name="TEXT">       PWM: </field></shadow></value><value name="ADD3"><block type="variables_get" id="encoder-brightness-print"><field name="VAR" id="encoder-brightness">jas_led</field></block></value></block></value><next><block type="utime.delay" id="encoder-loop-wait"><field name="SCALE">sleep_ms</field><comment pinned="false" h="70" w="330">Hodnotu kontrolujeme desetkrát za sekundu.</comment><value name="TIME"><shadow type="math_number" id="encoder-loop-time"><field name="NUM">100</field></shadow></value></block></next></block></next></block></next></block></next></block></next></block></next></block></statement></block>
