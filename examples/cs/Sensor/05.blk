<xml xmlns="https://developers.google.com/blockly/xml"><variables><variable id="gauge-adc-value">hodnota_potenciometru</variable><variable id="gauge-adc-min">adc_minimum</variable><variable id="gauge-angle">uhel_serva</variable><variable id="gauge-adc-max">adc_maximum</variable></variables><block type="program_start" id="gauge-start" x="50" y="50"><comment pinned="false" h="102" w="456">Potenciometr zapojte krajními vývody na 3,3 V a GND, prostředním na analogový GPIO 16. Ovládací vodič serva připojte na GPIO 23 a servo napájejte z vhodného zdroje se společnou GND.</comment><next><block type="servo_init" id="gauge-servo-init"><field name="ID">1</field><field name="reverse">FALSE</field><value name="pin"><shadow type="math_number" id="gauge-servo-pin"><field name="NUM">23</field></shadow></value><next><block type="variables_set" id="gauge-set-minimum"><field name="VAR" id="gauge-adc-min">adc_minimum</field><comment pinned="false" h="95" w="350">Kalibrační minimum upravte podle hodnoty potenciometru v levé krajní poloze.</comment><value name="VALUE"><shadow type="math_number" id="gauge-minimum-value"><field name="NUM">5000</field></shadow></value><next><block type="variables_set" id="gauge-set-maximum"><field name="VAR" id="gauge-adc-max">adc_maximum</field><comment pinned="false" h="95" w="350">Kalibrační maximum upravte podle hodnoty potenciometru v pravé krajní poloze.</comment><value name="VALUE"><shadow type="math_number" id="gauge-maximum-value"><field name="NUM">60000</field></shadow></value><next><block type="text_print" id="gauge-ready-print"><value name="TEXT"><shadow type="text" id="gauge-ready-text"><field name="TEXT">Rucickovy ukazatel je pripraveny.</field></shadow></value></block></next></block></next></block></next></block></next></block><block type="program_loop" id="gauge-loop" x="50" y="277"><comment pinned="false" h="85" w="350">Naměřenou hodnotu mezi kalibračním minimem a maximem převedeme na úhel 0 až 180°.</comment><statement name="DO"><block type="variables_set" id="gauge-read-potentiometer"><field name="VAR" id="gauge-adc-value">hodnota_potenciometru</field><value name="VALUE"><block type="RP2040_adc" id="gauge-adc-read"><field name="Width: ">1</field><value name="pin"><shadow type="math_number" id="gauge-adc-pin"><field name="NUM">10</field></shadow></value></block></value><next><block type="variables_set" id="gauge-convert-angle"><field name="VAR" id="gauge-angle">uhel_serva</field><comment pinned="false" h="95" w="350">Omezení převodu zajistí, že servo nikdy nedostane úhel menší než 0° nebo větší než 180°.</comment><value name="VALUE"><block type="zmena_rozsahu" id="gauge-map-angle"><field name="celociselne">TRUE</field><field name="limitovat">TRUE</field><value name="in_value"><block type="variables_get" id="gauge-map-input"><field name="VAR" id="gauge-adc-value">hodnota_potenciometru</field></block></value><value name="in_min"><block type="variables_get" id="gauge-map-min"><field name="VAR" id="gauge-adc-min">adc_minimum</field></block></value><value name="in_max"><block type="variables_get" id="gauge-map-max"><field name="VAR" id="gauge-adc-max">adc_maximum</field></block></value><value name="out_min"><shadow type="math_number" id="gauge-angle-min"><field name="NUM">0</field></shadow></value><value name="out_max"><shadow type="math_number" id="gauge-angle-max"><field name="NUM">180</field></shadow></value></block></value><next><block type="servo_angle" id="gauge-set-servo-angle"><field name="ID">1</field><value name="uhel"><block type="variables_get" id="gauge-servo-angle-value"><field name="VAR" id="gauge-angle">uhel_serva</field></block></value><next><block type="text_print" id="gauge-print-angle"><value name="TEXT"><block type="text_join" id="gauge-angle-text"><mutation items="4"></mutation><value name="ADD0"><shadow type="text" id="gauge-angle-label"><field name="TEXT">Uhel serva: </field></shadow><block type="text" id="Za[5[O=+B/DzMQI0D79E"><field name="TEXT">Uhel serva: </field></block></value><value name="ADD1"><block type="variables_get" id="gauge-print-angle-value"><field name="VAR" id="gauge-angle">uhel_serva</field></block></value><value name="ADD2"><block type="text" id=",oVDBZW_OU(Ezj)L^]?V"><field name="TEXT">       Hodnota potenciometru: </field></block></value><value name="ADD3"><block type="variables_get" id="rTg_5@gii21*`0+UtW?+"><field name="VAR" id="gauge-adc-value">hodnota_potenciometru</field></block></value></block></value><next><block type="utime.delay" id="gauge-delay"><field name="SCALE">sleep_ms</field><value name="TIME"><shadow type="math_number" id="gauge-delay-time"><field name="NUM">50</field></shadow></value></block></next></block></next></block></next></block></next></block></statement></block>
  <!--ESPIDE_EXTENSIONS_BEGIN-->
